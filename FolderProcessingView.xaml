<UserControl x:Class="CyanTools.FolderProcessingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:utils="clr-namespace:CyanTools.Utils"
             mc:Ignorable="d"
             d:DesignHeight="560"
             d:DesignWidth="920">
    <UserControl.Resources>
        <utils:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <utils:BooleanToInverseBooleanConverter x:Key="BooleanToInverseBooleanConverter" />
    </UserControl.Resources>

    <Grid Style="{StaticResource CyanPageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CyanCardStyle}"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CyanIconBadgeStyle}"
                        Margin="0,0,14,0">
                    <ui:SymbolIcon Symbol="FolderOpen24"
                                   FontSize="22"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="文件夹处理"
                               Style="{StaticResource CyanSectionTitleStyle}" />
                    <TextBlock Text="对整批文件执行移动、清理、整理和训练输出转换等目录级操作。"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <GroupBox Grid.Row="1"
                  Header="路径"
                  Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="输入路径"
                           Style="{StaticResource CyanFormLabelStyle}" />
                <TextBox Grid.Column="1"
                         Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding HasInheritedInputPath}"
                         Margin="0,0,8,0" />
                <Button Grid.Column="2"
                        Command="{Binding SelectInputPathCommand}"
                        Style="{StaticResource CyanSmallIconButtonStyle}"
                        ToolTip="选择输入路径"
                        Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                    <ui:SymbolIcon Symbol="FolderOpen24" />
                </Button>

                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Text="工作流中此输入路径固定为上一个节点的输出路径；如果上一个节点没有输出路径，则沿用其输入路径。"
                           Style="{StaticResource CyanSecondaryTextBlockStyle}"
                           Margin="0,6,0,0"
                           Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <TextBlock Grid.Row="2"
                           Text="输出路径"
                           Style="{StaticResource CyanFormLabelStyle}"
                           Margin="0,12,10,0"
                           Visibility="{Binding IsOutputPathVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBox Grid.Row="2"
                         Grid.Column="1"
                         Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,12,8,0"
                         Visibility="{Binding IsOutputPathVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Button Grid.Row="2"
                        Grid.Column="2"
                        Command="{Binding SelectOutputPathCommand}"
                        Style="{StaticResource CyanSmallIconButtonStyle}"
                        Margin="0,12,0,0"
                        ToolTip="选择输出路径"
                        Visibility="{Binding IsOutputPathVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:SymbolIcon Symbol="FolderOpen24" />
                </Button>

                <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Text="输出路径留空时默认为输入路径。"
                           Style="{StaticResource CyanSecondaryTextBlockStyle}"
                           Margin="0,8,0,0"
                           Visibility="{Binding IsOutputPathVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </GroupBox>

        <Grid Grid.Row="2"
              Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Header="功能设置">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="功能"
                               Style="{StaticResource CyanFormLabelStyle}" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableOperations}"
                              SelectedValuePath="Operation"
                              DisplayMemberPath="DisplayName"
                              SelectedValue="{Binding SelectedOperation}"
                              Margin="0,0,14,0" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding ParameterLabel}"
                               Style="{StaticResource CyanFormLabelStyle}"
                               Visibility="{Binding IsParameterVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBox Grid.Column="3"
                             Text="{Binding ParameterText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,14,0"
                             Visibility="{Binding IsParameterVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <CheckBox Grid.Column="4"
                              Content="覆盖已存在文件"
                              IsChecked="{Binding OverwriteExisting}"
                              VerticalAlignment="Center"
                              Visibility="{Binding IsOverwriteOptionVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </GroupBox>

            <Border Grid.Column="2"
                    Style="{StaticResource CyanToolbarSurfaceStyle}"
                    VerticalAlignment="Stretch">
                <Button Command="{Binding ExecuteCommand}"
                        IsEnabled="{Binding IsProcessing, Converter={StaticResource BooleanToInverseBooleanConverter}}"
                        Style="{StaticResource CyanPrimaryActionButtonStyle}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSync24"
                                       Margin="0,0,6,0" />
                        <TextBlock Text="开始处理" />
                    </StackPanel>
                </Button>
            </Border>
        </Grid>

        <GroupBox Grid.Row="3"
                  Header="日志">
            <TextBox Text="{Binding LogText, Mode=OneWay}"
                     Style="{StaticResource CyanLogTextBoxStyle}" />
        </GroupBox>
    </Grid>
</UserControl>
