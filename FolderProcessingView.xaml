<UserControl x:Class="CyanTools.FolderProcessingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:utils="clr-namespace:CyanTools.Utils"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <utils:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <utils:BooleanToInverseBooleanConverter x:Key="BooleanToInverseBooleanConverter"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Header="路径选择" Grid.Row="0" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="输入路径:" VerticalAlignment="Center" Margin="5"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding HasInheritedInputPath}"
                             Margin="5"/>
                    <Button Grid.Column="2"
                            Content="..."
                            Command="{Binding SelectInputPathCommand}"
                            Margin="5"
                            Padding="10,2"
                            Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                </Grid>

                <TextBlock Text="管道调度中此输入路径固定为上一个节点的输出路径；如果上一个节点没有输出路径，则沿用其输入路径。"
                           Foreground="Gray"
                           Margin="5,0,5,5"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="功能设置" Grid.Row="1" Margin="0,0,0,10">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="功能:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableOperations}"
                          SelectedValuePath="Operation"
                          DisplayMemberPath="DisplayName"
                          SelectedValue="{Binding SelectedOperation}"
                          Margin="0,0,10,0"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding ParameterLabel}"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"
                           Visibility="{Binding IsParameterVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBox Grid.Column="3"
                         Text="{Binding ParameterText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,10,0"
                         Visibility="{Binding IsParameterVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </GroupBox>

        <Button Grid.Row="2"
                Content="开始处理"
                Command="{Binding ExecuteCommand}"
                Padding="12,4"
                Width="120"
                HorizontalAlignment="Left"
                Margin="0,0,0,10"
                IsEnabled="{Binding IsProcessing, Converter={StaticResource BooleanToInverseBooleanConverter}}"/>

        <TextBox Grid.Row="3"
                 Text="{Binding LogText, Mode=OneWay}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"/>
    </Grid>
</UserControl>
