<UserControl x:Class="CyanTools.FolderProcessingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:utils="clr-namespace:CyanTools.Utils"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="840">
    <UserControl.Resources>
        <utils:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <utils:BooleanToInverseBooleanConverter x:Key="BooleanToInverseBooleanConverter" />
    </UserControl.Resources>

    <Grid Style="{StaticResource CyanPageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <GroupBox Header="路径选择"
                  Grid.Row="0"
                  Margin="0,0,0,12"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="输入路径"
                           Style="{StaticResource CyanFormLabelStyle}" />
                <TextBox Grid.Column="1"
                         Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding HasInheritedInputPath}"
                         Margin="0,0,8,0" />
                <Button Grid.Column="2"
                        Command="{Binding SelectInputPathCommand}"
                        Style="{StaticResource CyanSmallIconButtonStyle}"
                        ToolTip="选择输入路径"
                        Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                    <ui:SymbolIcon Symbol="FolderOpen24" />
                </Button>

                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Text="管道调度中此输入路径固定为上一个节点的输出路径；如果上一个节点没有输出路径，则沿用其输入路径。"
                           Style="{StaticResource CyanSecondaryTextBlockStyle}"
                           Margin="0,6,0,0"
                           Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <TextBlock Grid.Row="2"
                           Text="输出路径"
                           Style="{StaticResource CyanFormLabelStyle}"
                           Margin="0,12,10,0"
                           Visibility="{Binding IsOutputPathVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBox Grid.Row="2"
                         Grid.Column="1"
                         Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,12,8,0"
                         Visibility="{Binding IsOutputPathVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Button Grid.Row="2"
                        Grid.Column="2"
                        Command="{Binding SelectOutputPathCommand}"
                        Style="{StaticResource CyanSmallIconButtonStyle}"
                        Margin="0,12,0,0"
                        ToolTip="选择输出路径"
                        Visibility="{Binding IsOutputPathVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:SymbolIcon Symbol="FolderOpen24" />
                </Button>

                <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Text="输出路径留空时默认为输入路径。"
                           Style="{StaticResource CyanSecondaryTextBlockStyle}"
                           Margin="0,8,0,0"
                           Visibility="{Binding IsOutputPathVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </GroupBox>

        <GroupBox Header="功能设置"
                  Grid.Row="1"
                  Margin="0,0,0,12"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="功能"
                           Style="{StaticResource CyanFormLabelStyle}" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableOperations}"
                          SelectedValuePath="Operation"
                          DisplayMemberPath="DisplayName"
                          SelectedValue="{Binding SelectedOperation}"
                          Margin="0,0,14,0" />

                <TextBlock Grid.Column="2"
                           Text="{Binding ParameterLabel}"
                           Style="{StaticResource CyanFormLabelStyle}"
                           Visibility="{Binding IsParameterVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBox Grid.Column="3"
                         Text="{Binding ParameterText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,14,0"
                         Visibility="{Binding IsParameterVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <CheckBox Grid.Column="4"
                          Content="覆盖已存在文件"
                          IsChecked="{Binding OverwriteExisting}"
                          VerticalAlignment="Center"
                          Visibility="{Binding IsOverwriteOptionVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </GroupBox>

        <GroupBox Header="执行"
                  Grid.Row="2"
                  Margin="0,0,0,12"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <Button Command="{Binding ExecuteCommand}"
                    IsEnabled="{Binding IsProcessing, Converter={StaticResource BooleanToInverseBooleanConverter}}"
                    Style="{StaticResource CyanPrimaryActionButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowSync24"
                                   Margin="0,0,6,0" />
                    <TextBlock Text="开始处理" />
                </StackPanel>
            </Button>
        </GroupBox>

        <GroupBox Header="日志"
                  Grid.Row="3"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <TextBox Text="{Binding LogText, Mode=OneWay}"
                     Style="{StaticResource CyanLogTextBoxStyle}" />
        </GroupBox>
    </Grid>
</UserControl>
