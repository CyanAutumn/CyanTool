<UserControl x:Class="CyanTools.TrainingBridgeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1120">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0"
                  Header="草稿与转换目标"
                  Style="{StaticResource CyanGroupBoxStyle}"
                  Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.35*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="读取草稿" Style="{StaticResource CyanFormLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding Drafts}"
                              SelectedItem="{Binding SelectedDraft}"
                              DisplayMemberPath="Name"
                              MinHeight="34"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="项目名称" Style="{StaticResource CyanFormLabelStyle}"/>
                    <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="34"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="导入来源" Style="{StaticResource CyanFormLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding BackendOptions}"
                              SelectedItem="{Binding SelectedSourceBackend}"
                              DisplayMemberPath="Label"
                              MinHeight="34"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Text="导出目标" Style="{StaticResource CyanFormLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding BackendOptions}"
                              SelectedItem="{Binding SelectedTargetBackend}"
                              DisplayMemberPath="Label"
                              MinHeight="34"/>
                </StackPanel>

                <WrapPanel Grid.Column="4" VerticalAlignment="Bottom">
                    <Button Command="{Binding NewProjectCommand}"
                            Style="{StaticResource CyanCommandButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" Margin="0,0,6,0"/>
                            <TextBlock Text="新建"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveProjectCommand}"
                            Style="{StaticResource CyanPrimaryActionButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Save24" Margin="0,0,6,0"/>
                            <TextBlock Text="保存草稿"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DeleteProjectCommand}"
                            Style="{StaticResource CyanCommandButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Delete24" Margin="0,0,6,0"/>
                            <TextBlock Text="删除"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <Grid Grid.Row="1" Grid.ColumnSpan="5" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="36"
                             Padding="10,7"
                             ToolTip="项目备注"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusMessage, Converter={StaticResource LocalizedTextConverter}}"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="520"
                               Margin="14,0,0,0"/>
                </Grid>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="0.95*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="参数映射"
                      Style="{StaticResource CyanGroupBoxStyle}"
                      Margin="0,0,12,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ParameterCountText}"
                                   Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                   VerticalAlignment="Center"/>
                        <WrapPanel Grid.Column="1">
                            <Button Command="{Binding ImportConfigCommand}"
                                    Style="{StaticResource CyanPrimaryActionButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowUpload24" Margin="0,0,6,0"/>
                                    <TextBlock Text="导入配置"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding FillDefaultsCommand}"
                                    Style="{StaticResource CyanCommandButtonStyle}"
                                    Content="补齐常用参数"/>
                            <Button Command="{Binding AddParameterCommand}"
                                    Style="{StaticResource CyanCommandButtonStyle}"
                                    Content="添加参数"/>
                            <Button Command="{Binding RemoveParameterCommand}"
                                    Style="{StaticResource CyanCommandButtonStyle}"
                                    Content="删除参数"/>
                        </WrapPanel>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Parameters}"
                              SelectedItem="{Binding SelectedParameter}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              Style="{StaticResource CyanDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="参数键"
                                                Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                Width="2*"/>
                            <DataGridTextColumn Header="值"
                                                Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                Width="3*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="1"
                      Header="导出配置包"
                      Style="{StaticResource CyanGroupBoxStyle}"
                      Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="110"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,10">
                        <Button Command="{Binding PreviewExportCommand}"
                                Style="{StaticResource CyanCommandButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Eye24" Margin="0,0,6,0"/>
                                <TextBlock Text="生成预览"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExportConfigCommand}"
                                Style="{StaticResource CyanPrimaryActionButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="FolderArrowRight24" Margin="0,0,6,0"/>
                                <TextBlock Text="导出到目录"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CopyPreviewCommand}"
                                Style="{StaticResource CyanCommandButtonStyle}"
                                Content="复制当前文件"/>
                    </WrapPanel>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding GeneratedFiles}"
                             SelectedItem="{Binding SelectedGeneratedFile}"
                             DisplayMemberPath="FileName"
                             Style="{StaticResource CyanListBoxSurfaceStyle}"
                             Margin="0,0,0,10"/>

                    <TextBox Grid.Row="2"
                             Text="{Binding PreviewText, Mode=OneWay, Converter={StaticResource LocalizedTextConverter}}"
                             Style="{StaticResource CyanLogTextBoxStyle}"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"/>
                </Grid>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="2"
                  Header="状态与日志"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <TextBox Text="{Binding LogText, Mode=OneWay}"
                     Style="{StaticResource CyanLogTextBoxStyle}"
                     TextChanged="LogTextBox_TextChanged"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"/>
        </GroupBox>
    </Grid>
</UserControl>
