<UserControl x:Class="CyanTools.TrainingBridgeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1180">
    <UserControl.Resources>
        <DataTemplate x:Key="TrainingBridgeTextEditorTemplate">
            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="32"
                     VerticalContentAlignment="Center"/>
        </DataTemplate>

        <DataTemplate x:Key="TrainingBridgeSelectEditorTemplate">
            <ComboBox ItemsSource="{Binding Options}"
                      IsEditable="True"
                      Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                      MinHeight="32"/>
        </DataTemplate>

        <DataTemplate x:Key="TrainingBridgeBooleanEditorTemplate">
            <CheckBox IsChecked="{Binding BooleanValue, UpdateSourceTrigger=PropertyChanged}"
                      Content="启用"
                      MinHeight="32"
                      VerticalContentAlignment="Center"/>
        </DataTemplate>

        <DataTemplate x:Key="TrainingBridgeTextareaEditorTemplate">
            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     MinHeight="64"/>
        </DataTemplate>

        <Style x:Key="TrainingBridgeParameterListItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="SelectionBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectionBorder"
                                        Property="Background"
                                        Value="{DynamicResource CyanSurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionBorder"
                                        Property="Background"
                                        Value="{DynamicResource CyanMutedAccentBrush}"/>
                                <Setter TargetName="SelectionBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0"
                  Header="草稿与转换目标"
                  Style="{StaticResource CyanGroupBoxStyle}"
                  Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.35*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="读取草稿" Style="{StaticResource CyanFormLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding Drafts}"
                              SelectedItem="{Binding SelectedDraft}"
                              DisplayMemberPath="Name"
                              MinHeight="34"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="项目名称" Style="{StaticResource CyanFormLabelStyle}"/>
                    <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="34"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="导入来源" Style="{StaticResource CyanFormLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding BackendOptions}"
                              SelectedItem="{Binding SelectedSourceBackend}"
                              DisplayMemberPath="Label"
                              MinHeight="34"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Text="导出目标" Style="{StaticResource CyanFormLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding BackendOptions}"
                              SelectedItem="{Binding SelectedTargetBackend}"
                              DisplayMemberPath="Label"
                              MinHeight="34"/>
                </StackPanel>

                <WrapPanel Grid.Column="4" VerticalAlignment="Bottom">
                    <Button Command="{Binding NewProjectCommand}"
                            Style="{StaticResource CyanCommandButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" Margin="0,0,6,0"/>
                            <TextBlock Text="新建"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveProjectCommand}"
                            Style="{StaticResource CyanPrimaryActionButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Save24" Margin="0,0,6,0"/>
                            <TextBlock Text="保存草稿"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DeleteProjectCommand}"
                            Style="{StaticResource CyanCommandButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Delete24" Margin="0,0,6,0"/>
                            <TextBlock Text="删除"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <Grid Grid.Row="1" Grid.ColumnSpan="5" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="36"
                             Padding="10,7"
                             ToolTip="项目备注"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusMessage, Converter={StaticResource LocalizedTextConverter}}"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="520"
                               Margin="14,0,0,0"/>
                </Grid>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.75*"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="参数信息"
                      Style="{StaticResource CyanGroupBoxStyle}"
                      Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="训练配置"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Border Style="{StaticResource CyanPillStyle}" Margin="10,0,0,0">
                                <TextBlock Text="{Binding ParameterCountText}"
                                           Style="{StaticResource CyanSecondaryTextBlockStyle}"/>
                            </Border>
                        </StackPanel>
                        <WrapPanel Grid.Column="1">
                            <Button Command="{Binding ImportConfigCommand}"
                                    Style="{StaticResource CyanPrimaryActionButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowUpload24" Margin="0,0,6,0"/>
                                    <TextBlock Text="导入配置"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding FillDefaultsCommand}"
                                    Style="{StaticResource CyanCommandButtonStyle}"
                                    Content="补齐常用参数"/>
                            <Button Command="{Binding AddParameterCommand}"
                                    Style="{StaticResource CyanCommandButtonStyle}"
                                    Content="添加参数"/>
                            <Button Command="{Binding RemoveParameterCommand}"
                                    Style="{StaticResource CyanCommandButtonStyle}"
                                    Content="删除选中参数"/>
                        </WrapPanel>
                    </Grid>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding CoreParameters}"
                             SelectedItem="{Binding SelectedParameter}"
                             ItemContainerStyle="{StaticResource TrainingBridgeParameterListItemStyle}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="220"
                                        MinHeight="142"
                                        Padding="10"
                                        CornerRadius="8"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding DisplayLabel, Converter={StaticResource LocalizedTextConverter}}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBox Grid.Row="1"
                                                 Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="{Binding IsKnownParameter}"
                                                 Margin="0,5,0,6"
                                                 Padding="6,2"
                                                 MinHeight="24"
                                                 FontSize="11"
                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                 ToolTip="后端参数键"/>
                                        <ContentControl Grid.Row="2" Content="{Binding}">
                                            <ContentControl.Style>
                                                <Style TargetType="{x:Type ContentControl}">
                                                    <Setter Property="ContentTemplate"
                                                            Value="{StaticResource TrainingBridgeTextEditorTemplate}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EditorKind}" Value="select">
                                                            <Setter Property="ContentTemplate"
                                                                    Value="{StaticResource TrainingBridgeSelectEditorTemplate}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EditorKind}" Value="boolean">
                                                            <Setter Property="ContentTemplate"
                                                                    Value="{StaticResource TrainingBridgeBooleanEditorTemplate}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EditorKind}" Value="textarea">
                                                            <Setter Property="ContentTemplate"
                                                                    Value="{StaticResource TrainingBridgeTextareaEditorTemplate}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                        <TextBlock Grid.Row="3"
                                                   Text="{Binding HelpText, Converter={StaticResource LocalizedTextConverter}}"
                                                   Margin="0,6,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="32"
                                                   ToolTip="{Binding HelpText}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <GroupBox Grid.Row="2"
                              Header="Epoch 预览图"
                              Margin="0,10,0,0"
                              MaxHeight="350">
                        <GroupBox.Style>
                            <Style TargetType="{x:Type GroupBox}"
                                   BasedOn="{StaticResource CyanGroupBoxStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDiffusionPipeTarget}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </GroupBox.Style>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="复用当前 Anima 模型，在 Epoch 结束后生成固定条件预览图。"
                                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                    <CheckBox Grid.Column="1"
                                              Content="启用"
                                              IsChecked="{Binding PreviewEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Margin="12,0,12,0"
                                              VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="2"
                                              Content="VAE 解码时下放训练模型"
                                              ToolTip="增加预览阶段的显存余量；解码后会恢复训练模型。"
                                              IsChecked="{Binding PreviewOffloadPipelineForVae, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,5,8">
                                        <TextBlock Text="正向 Prompt" Style="{StaticResource CyanFormLabelStyle}"/>
                                        <TextBox Text="{Binding PreviewPositivePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="58"
                                                 VerticalScrollBarVisibility="Auto"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="5,0,0,8">
                                        <TextBlock Text="负向 Prompt" Style="{StaticResource CyanFormLabelStyle}"/>
                                        <TextBox Text="{Binding PreviewNegativePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="58"
                                                 VerticalScrollBarVisibility="Auto"/>
                                    </StackPanel>
                                </Grid>

                                <UniformGrid Columns="4">
                                    <StackPanel Margin="0,0,5,7">
                                        <TextBlock Text="每 N 个 Epoch" Style="{StaticResource CyanFormLabelStyle}"/>
                                        <TextBox Text="{Binding PreviewEveryNEpochs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="5,0,5,7">
                                        <TextBlock Text="采样器" Style="{StaticResource CyanFormLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding PreviewSamplerOptions}"
                                                  SelectedItem="{Binding PreviewSampler, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="5,0,5,7">
                                        <TextBlock Text="调度器" Style="{StaticResource CyanFormLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding PreviewSchedulerOptions}"
                                                  SelectedItem="{Binding PreviewScheduler, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="5,0,0,7">
                                        <TextBlock Text="采样步数" Style="{StaticResource CyanFormLabelStyle}"/>
                                        <TextBox Text="{Binding PreviewSteps, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,5,0">
                                        <TextBlock Text="宽度" Style="{StaticResource CyanFormLabelStyle}"/>
                                        <TextBox Text="{Binding PreviewWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="最低 64，生成时按 16 对齐。"/>
                                    </StackPanel>
                                    <StackPanel Margin="5,0,5,0">
                                        <TextBlock Text="高度" Style="{StaticResource CyanFormLabelStyle}"/>
                                        <TextBox Text="{Binding PreviewHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="最低 64，生成时按 16 对齐。"/>
                                    </StackPanel>
                                    <StackPanel Margin="5,0,5,0">
                                        <TextBlock Text="CFG" Style="{StaticResource CyanFormLabelStyle}"/>
                                        <TextBox Text="{Binding PreviewCfg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="5,0,0,0">
                                        <TextBlock Text="Seed" Style="{StaticResource CyanFormLabelStyle}"/>
                                        <TextBox Text="{Binding PreviewSeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </GroupBox>
                </Grid>
            </GroupBox>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.15*"/>
                    <RowDefinition Height="0.85*"/>
                </Grid.RowDefinitions>

                <GroupBox Header="系统监控"
                          Style="{StaticResource CyanGroupBoxStyle}"
                          Margin="0,0,0,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="实时负载"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1"
                                          Content="悬浮窗"
                                          ToolTip="置顶系统监控小窗"
                                          IsChecked="{Binding ShowSystemMonitorWidget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Style="{StaticResource CyanPillStyle}">
                                    <TextBlock Text="{Binding MonitorStateText, Converter={StaticResource LocalizedTextConverter}}"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource CyanParameterRowStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="GPU"
                                                   Style="{StaticResource CyanFormLabelStyle}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding GpuTemperatureText}"
                                                   FontWeight="Bold"/>
                                    </Grid>
                                    <TextBlock Text="{Binding GpuName, Converter={StaticResource LocalizedTextConverter}}"
                                               Margin="0,3,0,8"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding GpuName}"/>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="GPU Load" FontSize="11"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding GpuLoadText}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding GpuLoadPercent, Mode=OneWay}"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Height="7"
                                                 Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                 Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="VRAM" FontSize="11"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding VramText}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding VramLoadPercent, Mode=OneWay}"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Height="7"
                                                 Foreground="#FF38BDF8"/>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CyanParameterRowStyle}"
                                        Margin="0,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="CPU"
                                                   Style="{StaticResource CyanFormLabelStyle}"/>
                                        <TextBlock Text="{Binding CpuText}"
                                                   Margin="0,4,0,2"
                                                   FontSize="18"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="{Binding CpuDetailText}"
                                                   Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                                   FontSize="11"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1"
                                        Style="{StaticResource CyanParameterRowStyle}"
                                        Margin="4,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="RAM"
                                                   Style="{StaticResource CyanFormLabelStyle}"/>
                                        <TextBlock Text="{Binding RamText}"
                                                   Margin="0,4,0,2"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding RamDetailText}"
                                                   Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                                   FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource CyanParameterRowStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="输出磁盘"
                                                   Style="{StaticResource CyanFormLabelStyle}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DiskPathText}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="110"
                                                   ToolTip="{Binding DiskPathText}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="磁盘占用" FontSize="11"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DiskUsageText}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding DiskLoadPercent, Mode=OneWay}"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Height="7"
                                                 Foreground="#FF22C55E"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding MonitorSampleText}"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                       FontSize="11"/>
                        </StackPanel>
                    </ScrollViewer>
                </GroupBox>

                <GroupBox Grid.Row="1"
                          Header="导出配置包"
                          Style="{StaticResource CyanGroupBoxStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="64"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <WrapPanel Margin="0,0,0,8">
                            <Button Command="{Binding PreviewExportCommand}"
                                    Style="{StaticResource CyanCommandButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Eye24" Margin="0,0,6,0"/>
                                    <TextBlock Text="生成预览"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ExportConfigCommand}"
                                    Style="{StaticResource CyanPrimaryActionButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FolderArrowRight24" Margin="0,0,6,0"/>
                                    <TextBlock Text="导出到目录"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CopyPreviewCommand}"
                                    Style="{StaticResource CyanCommandButtonStyle}"
                                    Content="复制当前文件"/>
                        </WrapPanel>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding GeneratedFiles}"
                                 SelectedItem="{Binding SelectedGeneratedFile}"
                                 DisplayMemberPath="FileName"
                                 Style="{StaticResource CyanListBoxSurfaceStyle}"
                                 Margin="0,0,0,8"/>

                        <TextBox Grid.Row="2"
                                 Text="{Binding PreviewText, Mode=OneWay, Converter={StaticResource LocalizedTextConverter}}"
                                 Style="{StaticResource CyanLogTextBoxStyle}"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"/>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>

        <GroupBox Grid.Row="2"
                  Header="状态与日志"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <TextBox Text="{Binding LogText, Mode=OneWay}"
                     Style="{StaticResource CyanLogTextBoxStyle}"
                     TextChanged="LogTextBox_TextChanged"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"/>
        </GroupBox>
    </Grid>
</UserControl>
