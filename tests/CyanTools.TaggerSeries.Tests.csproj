    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseIntermediateOutputPath>obj/CyanTools.TaggerSeries.Tests/</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="TaggerSeriesTests.cs" />
    <Compile Include="../Utils/TagTextMergeHelper.cs" Link="Utils/TagTextMergeHelper.cs" />
    <Compile Include="../Utils/TaggerSeriesCatalog.cs" Link="Utils/TaggerSeriesCatalog.cs" />
    <Compile Include="../Utils/ToriiGateTaggingProcessor.cs" Link="Utils/ToriiGateTaggingProcessor.cs" />
    <Compile Include="../Framework/Pipeline/PipelineSnapshotHelper.cs" Link="Framework/Pipeline/PipelineSnapshotHelper.cs" />
  </ItemGroup>
</Project>
