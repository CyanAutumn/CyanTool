<UserControl x:Class="CyanTools.DatasetManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CyanTools"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             xmlns:utils="clr-namespace:CyanTools.Utils"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <UserControl.DataContext>
        <viewModel:DatasetManagerViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <utils:BooleanToVisibilityConverter x:Key="DatasetBooleanToVisibilityConverter"/>
        <utils:BindingProxy x:Key="TagViewModelProxy" Data="{Binding}"/>
        <utils:ReferenceEqualsMultiConverter x:Key="ReferenceEqualsMultiConverter"/>
        <utils:ImagePathThumbnailConverter x:Key="ImagePathThumbnailConverter"/>
        <Style x:Key="DatasetFooterButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource CyanCommandButtonStyle}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DatasetPrimaryFooterButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource CyanPrimaryActionButtonStyle}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DatasetCategoryCheckBoxStyle"
               TargetType="{x:Type CheckBox}"
               BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DatasetKeyboardButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource CyanKeyboardButtonStyle}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="4,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <DataTemplate x:Key="TagTokenTemplate">
            <Border Padding="6,3"
                    Margin="2"
                    CornerRadius="8"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Background="{DynamicResource CyanMutedAccentBrush}"
                    PreviewMouseLeftButtonDown="TagChip_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="TagChip_PreviewMouseMove"
                    PreviewMouseLeftButtonUp="TagChip_PreviewMouseLeftButtonUp">
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="移到最前"
                                  Command="{Binding Data.MoveTagToStartCommand, Source={StaticResource TagViewModelProxy}}"
                                  CommandParameter="{Binding}"/>
                        <MenuItem Header="移到最后"
                                  Command="{Binding Data.MoveTagToEndCommand, Source={StaticResource TagViewModelProxy}}"
                                  CommandParameter="{Binding}"/>
                        <Separator/>
                        <MenuItem Header="移到最前(数据集)"
                                  Command="{Binding Data.MoveTagToStartDatasetCommand, Source={StaticResource TagViewModelProxy}}"
                                  CommandParameter="{Binding}"/>
                        <MenuItem Header="移到最后(数据集)"
                                  Command="{Binding Data.MoveTagToEndDatasetCommand, Source={StaticResource TagViewModelProxy}}"
                                  CommandParameter="{Binding}"/>
                        <MenuItem Header="删除(数据集)"
                                  Command="{Binding Data.RemoveTagFromDatasetCommand, Source={StaticResource TagViewModelProxy}}"
                                  CommandParameter="{Binding}"/>
                        <MenuItem Header="添加(数据集)"
                                  Command="{Binding Data.AddTagToDatasetCommand, Source={StaticResource TagViewModelProxy}}"
                                  CommandParameter="{Binding}"/>
                        <Separator/>
                        <MenuItem Header="打乱提示词（数据集）"
                                  Command="{Binding Data.ShufflePromptTagsDatasetCommand, Source={StaticResource TagViewModelProxy}}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="TagDisplayPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Text}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{Binding TranslationDisplay}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="6,0,0,0"/>
                    </StackPanel>
                    <Button x:Name="TagDeleteButton"
                            Grid.Column="2"
                            Margin="6,0,0,0"
                            Padding="4,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <ui:SymbolIcon Symbol="Dismiss24"
                                       FontSize="12"/>
                    </Button>
                    <TextBox x:Name="TagEditBox"
                             Grid.ColumnSpan="3"
                             Text="{Binding EditingText, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="Collapsed"
                             MinWidth="80"
                             AcceptsReturn="True"
                             Background="Transparent"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             PreviewKeyDown="TagEditBox_PreviewKeyDown"
                             TextChanged="TagEditBox_TextChanged"
                             LostKeyboardFocus="TagEditBox_LostKeyboardFocus"
                             IsVisibleChanged="TagEditBox_IsVisibleChanged"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="TagDisplayPanel" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="TagDeleteButton" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="TagEditBox" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="TagInputTemplate">
            <TextBox x:Name="TagInputBox"
                     MinWidth="120"
                     Margin="2"
                     Text="{Binding DataContext.PendingTagText, RelativeSource={RelativeSource AncestorType=ItemsControl}, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     Background="Transparent"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                     CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"
                     BorderThickness="0"
                     VerticalContentAlignment="Center"
                     PreviewKeyDown="TagInputBox_PreviewKeyDown"
                     TextChanged="TagInputBox_TextChanged"
                     LostKeyboardFocus="TagInputBox_LostKeyboardFocus"
                     GotKeyboardFocus="TagInputBox_GotKeyboardFocus"/>
        </DataTemplate>

        <utils:TagItemTemplateSelector x:Key="TagItemTemplateSelector"
                                       TagTemplate="{StaticResource TagTokenTemplate}"
                                       InputTemplate="{StaticResource TagInputTemplate}"/>
    </UserControl.Resources>
    <Grid x:Name="RootGrid"
          KeyDown="DatasetManagerView_KeyDown"
          Focusable="True"
          Margin="14"
          Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" MinWidth="180"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="320" MinWidth="280"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.ColumnSpan="5"
                Style="{StaticResource CyanCardStyle}"
                Margin="0,0,0,14"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CyanIconBadgeStyle}"
                        Margin="0,0,14,0">
                    <ui:SymbolIcon Symbol="DatabaseSearch24"
                                   FontSize="22"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="数据集管理"
                               Style="{StaticResource CyanSectionTitleStyle}" />
                    <TextBlock Text="浏览图片、编辑提示词标签、分配分类并保存数据集改动。"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>


        <GroupBox Grid.Row="1"
                  Grid.Column="0"
                  Header="数据列表"
                  Margin="0,0,10,0"
                  Style="{StaticResource CyanGroupBoxStyle}">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Bottom">
                <Button Command="{Binding SelectFolderCommand}"
                        Visibility="{Binding IsFolderPickerVisible, Converter={StaticResource DatasetBooleanToVisibilityConverter}}"
                        Style="{StaticResource DatasetFooterButtonStyle}">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="FolderOpen24"
                                       Margin="0,0,4,0"/>
                        <TextBlock Text="导入训练集"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SaveAllCommand}"
                        Style="{StaticResource DatasetPrimaryFooterButtonStyle}">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Save24"
                                       Margin="0,0,4,0"/>
                        <TextBlock Text="保存全部"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <ListBox x:Name="DataItemsList"
                     PreviewMouseLeftButtonDown="DataItemsList_PreviewMouseLeftButtonDown"
                     ItemsSource="{Binding DataItemsWithOperations}"
                     SelectedItem="{Binding SelectedDataItem, Mode=TwoWay}"
                     Style="{StaticResource CyanListBoxSurfaceStyle}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <utils:VirtualizingWrapPanel ItemWidth="108" ItemHeight="138"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SelectDataItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Width="100"
                                Height="130"
                                Margin="4"
                                Padding="0"
                                BorderThickness="0"
                                Background="Transparent"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Focusable="False">
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource CyanThumbnailCardStyle}">
                                        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                                        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="CornerRadius" Value="8"/>
                                        <Setter Property="Padding" Value="4"/>
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource ReferenceEqualsMultiConverter}">
                                                        <Binding />
                                                        <Binding Path="DataContext.SelectedDataItem" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6">
                                            <Image Width="80"
                                                   Height="80"
                                                   Stretch="UniformToFill"
                                                   Source="{Binding ImagePath, Converter={StaticResource ImagePathThumbnailConverter}, ConverterParameter=96}"/>
                                        </Border>
                                        <Border x:Name="OperationBadge"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="2"
                                                Background="{StaticResource CyanBadgeBackgroundBrush}"
                                                CornerRadius="2"
                                                Padding="2">
                                            <TextBlock Text="{Binding Operation}" Foreground="White" FontSize="10"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding ImageDisplayName}"
                                               FontSize="11"
                                               Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ImageDisplayName}"/>
                                </Grid>
                            </Border>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Operation}" Value="">
                                <Setter TargetName="OperationBadge" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        </GroupBox>


        <GridSplitter Grid.Row="1" Grid.Column="1" Style="{StaticResource CyanGridSplitterStyle}"/>


        <GroupBox Grid.Row="1"
                  Grid.Column="2"
                  Header="图片预览"
                  Margin="0,0,10,0"
                  Style="{StaticResource CyanGroupBoxStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <Border Grid.Row="0"
                    Style="{StaticResource CyanStatusStripStyle}"
                    Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="自动下一张" IsChecked="{Binding AutoNext}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <CheckBox Content="浏览模式" IsChecked="{Binding IsBrowseMode}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </Border>


            <Border Grid.Row="1"
                    x:Name="ImageContainer"
                    Style="{StaticResource CyanImageWellStyle}"
                    SizeChanged="ImageContainer_SizeChanged">
                <Canvas x:Name="MainCanvas"
                        Background="Transparent"
                        MouseRightButtonDown="MainCanvas_MouseRightButtonDown"
                        MouseRightButtonUp="MainCanvas_MouseRightButtonUp"
                        MouseLeftButtonDown="MainCanvas_MouseLeftButtonDown"
                        MouseLeftButtonUp="MainCanvas_MouseLeftButtonUp"
                        MouseMove="MainCanvas_MouseMove">
                    <Canvas x:Name="TransformGroupCanvas">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ImageScaleTransform"/>
                                <TranslateTransform x:Name="ImagePanTransform"/>
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <Image x:Name="MyImage" Source="{Binding CurrentImageSource}" Stretch="None" />
                    </Canvas>
                </Canvas>
            </Border>
        </Grid>
        </GroupBox>


        <GridSplitter Grid.Row="1" Grid.Column="3" Style="{StaticResource CyanGridSplitterStyle}"/>


        <Grid Grid.Row="1" Grid.Column="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <GroupBox Grid.Row="0"
                      Header="分类目录"
                      Margin="0,0,0,8"
                      Style="{StaticResource CyanGroupBoxStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="勾选后“保存所有更改”才会处理对应分类"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,0,5"
                                   TextWrapping="Wrap"/>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsCategory1Selected}"
                                      Style="{StaticResource DatasetCategoryCheckBoxStyle}"
                                      ToolTip="勾选后本次保存会处理分类1"/>
                            <Button Grid.Column="1" Content="1" Command="{Binding SetCategoryCommand}" CommandParameter="1" Style="{StaticResource CyanSmallIconButtonStyle}"/>
                            <TextBox Grid.Column="2" Text="{Binding Category1Path, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"/>
                            <Button Grid.Column="3" Command="{Binding SelectCategoryFolderCommand}" CommandParameter="1" Style="{StaticResource CyanSmallIconButtonStyle}" ToolTip="选择分类 1 文件夹">
                                <ui:SymbolIcon Symbol="FolderOpen24"/>
                            </Button>
                        </Grid>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsCategory2Selected}"
                                      Style="{StaticResource DatasetCategoryCheckBoxStyle}"
                                      ToolTip="勾选后本次保存会处理分类2"/>
                            <Button Grid.Column="1" Content="2" Command="{Binding SetCategoryCommand}" CommandParameter="2" Style="{StaticResource CyanSmallIconButtonStyle}"/>
                            <TextBox Grid.Column="2" Text="{Binding Category2Path, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"/>
                            <Button Grid.Column="3" Command="{Binding SelectCategoryFolderCommand}" CommandParameter="2" Style="{StaticResource CyanSmallIconButtonStyle}" ToolTip="选择分类 2 文件夹">
                                <ui:SymbolIcon Symbol="FolderOpen24"/>
                            </Button>
                        </Grid>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsCategory3Selected}"
                                      Style="{StaticResource DatasetCategoryCheckBoxStyle}"
                                      ToolTip="勾选后本次保存会处理分类3"/>
                            <Button Grid.Column="1" Content="3" Command="{Binding SetCategoryCommand}" CommandParameter="3" Style="{StaticResource CyanSmallIconButtonStyle}"/>
                            <TextBox Grid.Column="2" Text="{Binding Category3Path, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"/>
                            <Button Grid.Column="3" Command="{Binding SelectCategoryFolderCommand}" CommandParameter="3" Style="{StaticResource CyanSmallIconButtonStyle}" ToolTip="选择分类 3 文件夹">
                                <ui:SymbolIcon Symbol="FolderOpen24"/>
                            </Button>
                        </Grid>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsCategory4Selected}"
                                      Style="{StaticResource DatasetCategoryCheckBoxStyle}"
                                      ToolTip="勾选后本次保存会处理分类4"/>
                            <Button Grid.Column="1" Content="4" Command="{Binding SetCategoryCommand}" CommandParameter="4" Style="{StaticResource CyanSmallIconButtonStyle}"/>
                            <TextBox Grid.Column="2" Text="{Binding Category4Path, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"/>
                            <Button Grid.Column="3" Command="{Binding SelectCategoryFolderCommand}" CommandParameter="4" Style="{StaticResource CyanSmallIconButtonStyle}" ToolTip="选择分类 4 文件夹">
                                <ui:SymbolIcon Symbol="FolderOpen24"/>
                            </Button>
                        </Grid>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsCategory5Selected}"
                                      Style="{StaticResource DatasetCategoryCheckBoxStyle}"
                                      ToolTip="勾选后本次保存会处理分类5"/>
                            <Button Grid.Column="1" Content="5" Command="{Binding SetCategoryCommand}" CommandParameter="5" Style="{StaticResource CyanSmallIconButtonStyle}"/>
                            <TextBox Grid.Column="2" Text="{Binding Category5Path, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"/>
                            <Button Grid.Column="3" Command="{Binding SelectCategoryFolderCommand}" CommandParameter="5" Style="{StaticResource CyanSmallIconButtonStyle}" ToolTip="选择分类 5 文件夹">
                                <ui:SymbolIcon Symbol="FolderOpen24"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>


            <GroupBox Grid.Row="1"
                      Header="内容"
                      Margin="0,0,0,8"
                      Style="{StaticResource CyanGroupBoxStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{Binding TagTokens.Count, StringFormat=标签数: {0}}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="tag" VerticalAlignment="Center" Margin="0,0,6,2"/>
                                <TextBox Grid.Column="1"
                                         MinWidth="120"
                                         Text="{Binding ManualTagInput, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,6,2"/>
                                <Button Grid.Column="2"
                                        Grid.RowSpan="2"
                                        VerticalAlignment="Center"
                                        Command="{Binding UpsertTagTranslationCommand}"
                                        Style="{StaticResource CyanCommandButtonStyle}"
                                        Margin="0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Checkmark24"
                                                       Margin="0,0,6,0"/>
                                        <TextBlock Text="确认"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Grid.Row="1" Text="翻译" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Row="1"
                                         Grid.Column="1"
                                         Text="{Binding ManualTagTranslation, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,6,0"/>
                            </Grid>
                            <Button Content="翻译未翻译"
                                    Command="{Binding TranslateAllMissingTagsCommand}"
                                    Style="{StaticResource CyanCommandButtonStyle}"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Left">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Translate24"
                                                           Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                            <TextBlock Text="{Binding TagTranslationCountDisplay}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Padding="4"
                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="TagItemsControl"
                                          ItemTemplateSelector="{StaticResource TagItemTemplateSelector}"
                                          AllowDrop="True"
                                          PreviewDragOver="TagItemsControl_PreviewDragOver"
                                          Drop="TagItemsControl_Drop">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel IsItemsHost="True"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemsSource>
                                    <CompositeCollection>
                                        <CollectionContainer Collection="{Binding Data.TagTokens, Source={StaticResource TagViewModelProxy}}"/>
                                        <utils:TagInputPlaceholder/>
                                    </CompositeCollection>
                                </ItemsControl.ItemsSource>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <Popup x:Name="TagSuggestionPopup"
                           IsOpen="{Binding IsSuggestionOpen}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           Closed="TagSuggestionPopup_Closed">
                        <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Padding="2"
                                MinWidth="220">
                            <ListBox x:Name="TagSuggestionList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                     ItemsSource="{Binding TagSuggestions}"
                                     MouseLeftButtonUp="TagSuggestionList_MouseLeftButtonUp">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="4,2"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Tag}"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Translation}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Margin="12,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>
            </GroupBox>


            <GroupBox Grid.Row="2"
                      Header="控制"
                      Margin="0,5,0,0"
                      Style="{StaticResource CyanGroupBoxStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
	                    <Grid.ColumnDefinitions>
	                        <ColumnDefinition Width="*"/>
	                        <ColumnDefinition Width="*"/>
	                        <ColumnDefinition Width="*"/>
	                    </Grid.ColumnDefinitions>
	

                    <Button Grid.Row="0" Grid.Column="0" Content="Q 随机复制" Command="{Binding RandomCopyCommand}" Style="{StaticResource DatasetKeyboardButtonStyle}"/>
                    <Button Grid.Row="0" Grid.Column="1" Content="W 上" Click="ThumbnailMoveButton_Click" Tag="Up" Style="{StaticResource DatasetKeyboardButtonStyle}"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="E 复制下一张" Command="{Binding CopyNextDataCommand}" Style="{StaticResource DatasetKeyboardButtonStyle}"/>
                    

                    <Button Grid.Row="1" Grid.Column="0" Content="A 左" Click="ThumbnailMoveButton_Click" Tag="Left" Style="{StaticResource DatasetKeyboardButtonStyle}"/>
                    <Button Grid.Row="1" Grid.Column="1" Content="S 下" Click="ThumbnailMoveButton_Click" Tag="Down" Style="{StaticResource DatasetKeyboardButtonStyle}"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="D 右" Click="ThumbnailMoveButton_Click" Tag="Right" Style="{StaticResource DatasetKeyboardButtonStyle}"/>


                    <Button Grid.Row="2" Grid.Column="0" Content="Z 撤销" Command="{Binding UndoOperationCommand}" Style="{StaticResource DatasetKeyboardButtonStyle}"/>
                    <Button Grid.Row="2" Grid.Column="1" Content="X 保存 Prompt" Command="{Binding SavePromptCommand}" Style="{StaticResource DatasetKeyboardButtonStyle}"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="C 删除" Command="{Binding DeleteImageCommand}" Style="{StaticResource DatasetKeyboardButtonStyle}"/>
                </Grid>
            </GroupBox>
        </Grid>
	    </Grid>
</UserControl>
