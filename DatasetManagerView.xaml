<UserControl x:Class="CyanTools.DatasetManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CyanTools"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             xmlns:utils="clr-namespace:CyanTools.Utils"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <UserControl.DataContext>
        <viewModel:DatasetManagerViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <utils:BindingProxy x:Key="TagViewModelProxy" Data="{Binding}"/>
        <utils:ReferenceEqualsMultiConverter x:Key="ReferenceEqualsMultiConverter"/>
        <utils:ImagePathThumbnailConverter x:Key="ImagePathThumbnailConverter"/>
        <DataTemplate x:Key="TagTokenTemplate">
            <Border Padding="6,3"
                    Margin="2"
                    CornerRadius="3"
                    BorderBrush="#FFBFD9FF"
                    BorderThickness="1"
                    Background="#FFEAF3FF"
                    MouseLeftButtonDown="TagChip_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="TagDisplayPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Text}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TranslationDisplay}" Foreground="Gray" Margin="6,0,0,0"/>
                    </StackPanel>
                    <Button x:Name="TagDeleteButton"
                            Grid.Column="2"
                            Content="x"
                            Margin="6,0,0,0"
                            Padding="4,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#FF666666"
                            Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                    <TextBox x:Name="TagEditBox"
                             Grid.ColumnSpan="3"
                             Text="{Binding EditingText, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="Collapsed"
                             MinWidth="80"
                             AcceptsReturn="True"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             PreviewKeyDown="TagEditBox_PreviewKeyDown"
                             TextChanged="TagEditBox_TextChanged"
                             LostKeyboardFocus="TagEditBox_LostKeyboardFocus"
                             Loaded="TagEditBox_Loaded"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="TagDisplayPanel" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="TagDeleteButton" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="TagEditBox" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="TagInputTemplate">
            <TextBox x:Name="TagInputBox"
                     MinWidth="120"
                     Margin="2"
                     Text="{Binding DataContext.PendingTagText, RelativeSource={RelativeSource AncestorType=ItemsControl}, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     Background="Transparent"
                     BorderThickness="0"
                     VerticalContentAlignment="Center"
                     PreviewKeyDown="TagInputBox_PreviewKeyDown"
                     TextChanged="TagInputBox_TextChanged"
                     LostKeyboardFocus="TagInputBox_LostKeyboardFocus"
                     GotKeyboardFocus="TagInputBox_GotKeyboardFocus"/>
        </DataTemplate>

        <utils:TagItemTemplateSelector x:Key="TagItemTemplateSelector"
                                       TagTemplate="{StaticResource TagTokenTemplate}"
                                       InputTemplate="{StaticResource TagInputTemplate}"/>
    </UserControl.Resources>
    <Grid KeyDown="DatasetManagerView_KeyDown" Focusable="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="150"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="280" MinWidth="250"/>
        </Grid.ColumnDefinitions>


        <DockPanel Grid.Column="0" Margin="5">
            <Grid DockPanel.Dock="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="选择文件夹" Command="{Binding SelectFolderCommand}" Margin="0,5,2,0" Padding="5"/>
                <Button Grid.Column="1" Content="保存所有更改" Command="{Binding SaveAllCommand}" Margin="2,5,0,0" Padding="5"/>
            </Grid>

            <TextBlock DockPanel.Dock="Top" Text="数据列表" FontWeight="Bold" Margin="0,0,0,5"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="DataItemsList" ItemsSource="{Binding DataItemsWithOperations}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.SelectDataItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Width="100"
                                    Height="130"
                                    Margin="4"
                                    Padding="0"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Focusable="False">
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#FFCCCCCC"/>
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="CornerRadius" Value="4"/>
                                            <Setter Property="Padding" Value="4"/>
                                            <Style.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource ReferenceEqualsMultiConverter}">
                                                            <Binding />
                                                            <Binding Path="DataContext.SelectedDataItem" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="BorderBrush" Value="#FF409EFF"/>
                                                    <Setter Property="Background" Value="#FFEAF3FF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Border Background="#FFEFEFEF" CornerRadius="3">
                                                <Image Width="80"
                                                       Height="80"
                                                       Stretch="UniformToFill"
                                                       Source="{Binding ImagePath, Converter={StaticResource ImagePathThumbnailConverter}, ConverterParameter=96}"/>
                                            </Border>
                                            <Border x:Name="OperationBadge"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="2"
                                                    Background="#CC333333"
                                                    CornerRadius="2"
                                                    Padding="2">
                                                <TextBlock Text="{Binding Operation}" Foreground="White" FontSize="10"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding ImageDisplayName}"
                                                   FontSize="11"
                                                   Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ImageDisplayName}"/>
                                    </Grid>
                                </Border>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Operation}" Value="">
                                    <Setter TargetName="OperationBadge" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>


        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="LightGray"/>


        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="#FFCCCCCC" Background="#FFF0F0F0">
                <StackPanel Orientation="Horizontal" Margin="5">
                    <CheckBox Content="自动下一张" IsChecked="{Binding AutoNext}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </Border>


            <Border Grid.Row="1" x:Name="ImageContainer" Background="#FFCCCCCC" ClipToBounds="True">
                <Canvas x:Name="MainCanvas"
                        Background="Transparent"
                        MouseRightButtonDown="MainCanvas_MouseRightButtonDown"
                        MouseRightButtonUp="MainCanvas_MouseRightButtonUp"
                        MouseLeftButtonDown="MainCanvas_MouseLeftButtonDown"
                        MouseLeftButtonUp="MainCanvas_MouseLeftButtonUp"
                        MouseMove="MainCanvas_MouseMove">
                    <Canvas x:Name="TransformGroupCanvas">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="ImagePanTransform"/>
                        </Canvas.RenderTransform>
                        <Image x:Name="MyImage" Source="{Binding CurrentImageSource}" Stretch="None" />
                    </Canvas>
                </Canvas>
            </Border>
        </Grid>


        <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="LightGray"/>


        <Grid Grid.Column="4" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <GroupBox Grid.Row="0" Header="分类目录" Margin="0,0,0,5">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="35"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="1" Command="{Binding SetCategoryCommand}" CommandParameter="1" Width="25" Height="25"/>
                            <TextBox Grid.Column="1" Text="{Binding Category1Path, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"/>
                            <Button Grid.Column="2" Content="..." Command="{Binding SelectCategoryFolderCommand}" CommandParameter="1" Width="30" Height="25"/>
                        </Grid>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="35"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="2" Command="{Binding SetCategoryCommand}" CommandParameter="2" Width="25" Height="25"/>
                            <TextBox Grid.Column="1" Text="{Binding Category2Path, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"/>
                            <Button Grid.Column="2" Content="..." Command="{Binding SelectCategoryFolderCommand}" CommandParameter="2" Width="30" Height="25"/>
                        </Grid>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="35"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="3" Command="{Binding SetCategoryCommand}" CommandParameter="3" Width="25" Height="25"/>
                            <TextBox Grid.Column="1" Text="{Binding Category3Path, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"/>
                            <Button Grid.Column="2" Content="..." Command="{Binding SelectCategoryFolderCommand}" CommandParameter="3" Width="30" Height="25"/>
                        </Grid>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="35"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="4" Command="{Binding SetCategoryCommand}" CommandParameter="4" Width="25" Height="25"/>
                            <TextBox Grid.Column="1" Text="{Binding Category4Path, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"/>
                            <Button Grid.Column="2" Content="..." Command="{Binding SelectCategoryFolderCommand}" CommandParameter="4" Width="30" Height="25"/>
                        </Grid>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="35"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="5" Command="{Binding SetCategoryCommand}" CommandParameter="5" Width="25" Height="25"/>
                            <TextBox Grid.Column="1" Text="{Binding Category5Path, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"/>
                            <Button Grid.Column="2" Content="..." Command="{Binding SelectCategoryFolderCommand}" CommandParameter="5" Width="30" Height="25"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>


            <GroupBox Grid.Row="1" Header="内容" Margin="0,0,0,5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{Binding TagTokens.Count, StringFormat=标签数: {0}}"
                                       Foreground="Gray"
                                       Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="tag" VerticalAlignment="Center" Margin="0,0,6,2"/>
                                <TextBox Grid.Column="1"
                                         MinWidth="120"
                                         Text="{Binding ManualTagInput, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,6,2"/>
                                <Button Grid.Column="2"
                                        Grid.RowSpan="2"
                                        Content="确认"
                                        Padding="8,2"
                                        VerticalAlignment="Center"
                                        Command="{Binding UpsertTagTranslationCommand}"/>
                                <TextBlock Grid.Row="1" Text="翻译" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Row="1"
                                         Grid.Column="1"
                                         Text="{Binding ManualTagTranslation, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,6,0"/>
                            </Grid>
                            <Button Content="翻译未翻译"
                                    Command="{Binding TranslateAllMissingTagsCommand}"
                                    Padding="8,2"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding TagTranslationCountDisplay}"
                                       Foreground="Gray"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" BorderBrush="#FFCCCCCC" BorderThickness="1" Padding="4" Background="White">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="TagItemsControl"
                                          ItemTemplateSelector="{StaticResource TagItemTemplateSelector}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel IsItemsHost="True"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemsSource>
                                    <CompositeCollection>
                                        <CollectionContainer Collection="{Binding Data.TagTokens, Source={StaticResource TagViewModelProxy}}"/>
                                        <utils:TagInputPlaceholder/>
                                    </CompositeCollection>
                                </ItemsControl.ItemsSource>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <Popup x:Name="TagSuggestionPopup"
                           IsOpen="{Binding IsSuggestionOpen}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           Closed="TagSuggestionPopup_Closed">
                        <Border Background="White" BorderBrush="#FFCCCCCC" BorderThickness="1" Padding="2" MinWidth="220">
                            <ListBox x:Name="TagSuggestionList"
                                     ItemsSource="{Binding TagSuggestions}"
                                     MouseLeftButtonUp="TagSuggestionList_MouseLeftButtonUp">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Tag}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Translation}"
                                                       Foreground="Gray"
                                                       Margin="12,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>
            </GroupBox>


            <GroupBox Grid.Row="2" Header="控制" Margin="0,5,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
	                    <Grid.ColumnDefinitions>
	                        <ColumnDefinition Width="*"/>
	                        <ColumnDefinition Width="*"/>
	                        <ColumnDefinition Width="*"/>
	                    </Grid.ColumnDefinitions>
	

                    <Button Grid.Row="0" Grid.Column="0" Content="Q(随机复制)" Command="{Binding RandomCopyCommand}" Margin="2" Padding="5"/>
                    <Button Grid.Row="0" Grid.Column="1" Content="W(上)" Click="ThumbnailMoveButton_Click" Tag="Up" Margin="2" Padding="5"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="E(复制下一张)" Command="{Binding CopyNextDataCommand}" Margin="2" Padding="5"/>
                    

                    <Button Grid.Row="1" Grid.Column="0" Content="A(左)" Click="ThumbnailMoveButton_Click" Tag="Left" Margin="2" Padding="5"/>
                    <Button Grid.Row="1" Grid.Column="1" Content="S(下)" Click="ThumbnailMoveButton_Click" Tag="Down" Margin="2" Padding="5"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="D(右)" Click="ThumbnailMoveButton_Click" Tag="Right" Margin="2" Padding="5"/>


                    <Button Grid.Row="2" Grid.Column="0" Content="Z(撤销)" Command="{Binding UndoOperationCommand}" Margin="2" Padding="5"/>
                    <Button Grid.Row="2" Grid.Column="1" Content="X(保存Prompt)" Command="{Binding SavePromptCommand}" Margin="2" Padding="5"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="C(删除)" Command="{Binding DeleteImageCommand}" Margin="2" Padding="5"/>
                </Grid>
            </GroupBox>
        </Grid>
	    </Grid>
</UserControl>
