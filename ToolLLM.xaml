<UserControl x:Class="CyanTools.ToolLLM"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="Transparent"
             Loaded="ToolLLM_Loaded">
    <UserControl.DataContext>
        <viewModel:ToolLLMViewModel/>
    </UserControl.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="250"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="3*" MinWidth="250"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,5,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="150"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Model:" Margin="0,0,0,5" FontWeight="Bold"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" 
                          ItemsSource="{Binding ModelsList}"
                          SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                          DisplayMemberPath="Id"
                          VerticalContentAlignment="Center" 
                          Height="24"/>
                <Button Grid.Column="1" 
                        Command="{Binding RefreshModelsCommand}"
                        Content="刷新"
                        Width="75" 
                        Margin="5,0,0,0"/>
            </Grid>

            <TextBlock Grid.Row="2" Text="主输入:" Margin="0,10,0,5" FontWeight="Bold"/>
            <TextBox Grid.Row="3" Text="{Binding MainInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     TextWrapping="Wrap" 
                     VerticalScrollBarVisibility="Auto" 
                     AcceptsReturn="True"/>

            <TextBlock Grid.Row="4" Text="工作文件夹:" Margin="0,10,0,5" FontWeight="Bold"/>
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding WorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0" VerticalContentAlignment="Center" Height="24"/>
                <Button Grid.Column="1" Content="..." Width="30" Margin="5,0,0,0" Command="{Binding SelectFolderCommand}" CommandParameter="WorkingDirectory"/>
            </Grid>

            <TextBlock Grid.Row="6" Text="路径设置:" Margin="0,15,0,5" FontWeight="Bold"/>
            <StackPanel Grid.Row="7" VerticalAlignment="Top">
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="1:" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding Path1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" VerticalContentAlignment="Center" Height="24"/>
                    <Button Grid.Column="2" Content="..." Width="30" Margin="5,0,0,0" Command="{Binding SelectFolderCommand}" CommandParameter="Path1"/>
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="2:" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding Path2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" VerticalContentAlignment="Center" Height="24"/>
                    <Button Grid.Column="2" Content="..." Width="30" Margin="5,0,0,0" Command="{Binding SelectFolderCommand}" CommandParameter="Path2"/>
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="3:" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding Path3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" VerticalContentAlignment="Center" Height="24"/>
                    <Button Grid.Column="2" Content="..." Width="30" Margin="5,0,0,0" Command="{Binding SelectFolderCommand}" CommandParameter="Path3"/>
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="4:" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding Path4, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" VerticalContentAlignment="Center" Height="24"/>
                    <Button Grid.Column="2" Content="..." Width="30" Margin="5,0,0,0" Command="{Binding SelectFolderCommand}" CommandParameter="Path4"/>
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="5:" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding Path5, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" VerticalContentAlignment="Center" Height="24"/>
                    <Button Grid.Column="2" Content="..." Width="30" Margin="5,0,0,0" Command="{Binding SelectFolderCommand}" CommandParameter="Path5"/>
                </Grid>
            </StackPanel>

            <Grid Grid.Row="8" Margin="0,10,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" 
                          ItemsSource="{Binding Configs}"
                          SelectedItem="{Binding SelectedConfig, Mode=TwoWay}"
                          Text="{Binding NewConfigName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          DisplayMemberPath="Name"
                          VerticalContentAlignment="Center" 
                          Height="28" 
                          IsEditable="True"/>
                <Button Grid.Column="1" 
                        Command="{Binding SaveConfigCommand}"
                        Content="保存" 
                        Width="75" 
                        Margin="5,0,0,0" 
                        Height="28"/>
                <Button Grid.Column="2" 
                        Command="{Binding DeleteConfigCommand}"
                        Content="删除" 
                        Width="75" 
                        Margin="5,0,0,0" 
                        Height="28"/>
            </Grid>

            <Button Grid.Row="9" Command="{Binding RunCommand}" IsEnabled="{Binding IsRunEnabled}" Content="运行" Height="32" FontWeight="Bold" Margin="0,5,0,0"/>

        </Grid>

        <GridSplitter Grid.Column="1" 
                      Width="5" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Stretch" 
                      Background="#FFBCBCBC"/>

        <DockPanel Grid.Column="2" Margin="5,0,0,0">
            <Grid DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="输出日志" Margin="0,0,0,5" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="清空日志" Command="{Binding ClearLogCommand}" Padding="5,2"/>
            </Grid>
            <ListBox ItemsSource="{Binding LogLines}"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     BorderThickness="1"
                     SelectionMode="Single"
                     HorizontalContentAlignment="Stretch"
                     Background="#FFEEEEEE">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>
    </Grid>
</UserControl>