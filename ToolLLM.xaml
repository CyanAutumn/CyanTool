<UserControl x:Class="CyanTools.ToolLLM"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             xmlns:utils="clr-namespace:CyanTools.Utils"
             mc:Ignorable="d"
             d:DesignHeight="680"
             d:DesignWidth="1080"
             Background="Transparent"
             Loaded="ToolLLM_Loaded">
    <UserControl.Resources>
        <utils:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <UserControl.DataContext>
        <viewModel:ToolLLMViewModel/>
    </UserControl.DataContext>

    <Grid Style="{StaticResource CyanPageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CyanHeroPanelStyle}"
                Margin="0,0,0,14"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CyanIconBadgeStyle}"
                        Margin="0,0,16,0">
                    <ui:SymbolIcon Symbol="CheckmarkCircle24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="LLM 工具"
                               Style="{StaticResource CyanPageTitleStyle}"
                               FontSize="30"/>
                    <TextBlock Text="集中管理模型、提示词、工作目录和分类路径，右侧持续显示执行日志。"
                               Style="{StaticResource CyanPageSubtitleStyle}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <ui:Button Grid.Column="2"
                        Command="{Binding RunCommand}"
                        IsEnabled="{Binding IsRunEnabled}"
                        Style="{StaticResource CyanPrimaryActionButtonStyle}"
                        VerticalAlignment="Center"
                        Margin="18,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="PlayCircle24"
                                       Margin="0,0,6,0"/>
                        <TextBlock Text="运行"/>
                    </StackPanel>
                </ui:Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.08*" MinWidth="420"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="1.2*" MinWidth="420"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          Style="{StaticResource CyanPageScrollViewerStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0"
                              Header="模型连接"
                              Style="{StaticResource CyanGroupBoxStyle}"
                              Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="API 地址"
                                       Style="{StaticResource CyanFormLabelStyle}"/>
                            <ui:TextBox Grid.Column="1"
                                     Text="{Binding ApiUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"
                                     ToolTip="API 地址"/>
                            <ComboBox Grid.Column="2"
                                      Width="126"
                                      ItemsSource="{Binding FunctionTypes}"
                                      SelectedItem="{Binding SelectedFunction, Mode=TwoWay}"
                                      VerticalContentAlignment="Center"
                                      Margin="10,0,0,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource LocalizedTextConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="1"
                                       Text="模型"
                                       Style="{StaticResource CyanFormLabelStyle}"
                                       Margin="0,10,10,0"/>
                            <ComboBox Grid.Row="1"
                                      Grid.Column="1"
                                      ItemsSource="{Binding ModelsList}"
                                      SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                                      DisplayMemberPath="Id"
                                      VerticalContentAlignment="Center"
                                      Margin="0,10,10,0"/>
                            <Grid Grid.Row="1"
                                  Grid.Column="2"
                                  Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0"
                                        Command="{Binding RefreshModelsCommand}"
                                        Style="{StaticResource CyanCommandButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="CheckmarkCircle24"
                                                       Margin="0,0,6,0"/>
                                        <TextBlock Text="刷新"/>
                                    </StackPanel>
                                </ui:Button>
                                <CheckBox Grid.Column="1"
                                          Content="推理模式"
                                          IsChecked="{Binding IsReasoning}"
                                          VerticalAlignment="Center"
                                          Margin="2,0,0,0"/>
                            </Grid>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="1"
                              Header="输入"
                              Style="{StaticResource CyanGroupBoxStyle}"
                              Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="170"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ui:TextBox Grid.Row="0"
                                     Text="{Binding MainInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     AcceptsReturn="True"
                                     Padding="10"/>

                            <Grid Grid.Row="1"
                                  Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="工作目录"
                                           Style="{StaticResource CyanFormLabelStyle}"/>
                                <ui:TextBox Grid.Column="1"
                                         Text="{Binding WorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"
                                         Margin="0,0,8,0"/>
                                <ui:Button Grid.Column="2"
                                        Command="{Binding SelectFolderCommand}"
                                        CommandParameter="WorkingDirectory"
                                        Style="{StaticResource CyanSmallIconButtonStyle}"
                                        ToolTip="选择工作目录">
                                    <ui:SymbolIcon Symbol="FolderOpen24"/>
                                </ui:Button>
                            </Grid>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="2"
                              Header="路径设置"
                              Style="{StaticResource CyanGroupBoxStyle}"
                              Margin="0,0,0,12"
                              Visibility="{Binding IsPathSettingsVisible, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="路径 1"
                                       Style="{StaticResource CyanFormLabelStyle}"/>
                            <ui:TextBox Grid.Column="1"
                                     Text="{Binding Path1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,8,0"/>
                            <ui:Button Grid.Column="2"
                                    Command="{Binding SelectFolderCommand}"
                                    CommandParameter="Path1"
                                    Style="{StaticResource CyanSmallIconButtonStyle}"
                                    ToolTip="选择路径 1">
                                <ui:SymbolIcon Symbol="FolderOpen24"/>
                            </ui:Button>

                            <TextBlock Grid.Row="1"
                                       Text="路径 2"
                                       Style="{StaticResource CyanFormLabelStyle}"
                                       Margin="0,8,10,0"/>
                            <ui:TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Text="{Binding Path2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"
                                     Margin="0,8,8,0"/>
                            <ui:Button Grid.Row="1"
                                    Grid.Column="2"
                                    Margin="0,8,0,0"
                                    Command="{Binding SelectFolderCommand}"
                                    CommandParameter="Path2"
                                    Style="{StaticResource CyanSmallIconButtonStyle}"
                                    ToolTip="选择路径 2">
                                <ui:SymbolIcon Symbol="FolderOpen24"/>
                            </ui:Button>

                            <TextBlock Grid.Row="2"
                                       Text="路径 3"
                                       Style="{StaticResource CyanFormLabelStyle}"
                                       Margin="0,8,10,0"/>
                            <ui:TextBox Grid.Row="2"
                                     Grid.Column="1"
                                     Text="{Binding Path3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"
                                     Margin="0,8,8,0"/>
                            <ui:Button Grid.Row="2"
                                    Grid.Column="2"
                                    Margin="0,8,0,0"
                                    Command="{Binding SelectFolderCommand}"
                                    CommandParameter="Path3"
                                    Style="{StaticResource CyanSmallIconButtonStyle}"
                                    ToolTip="选择路径 3">
                                <ui:SymbolIcon Symbol="FolderOpen24"/>
                            </ui:Button>

                            <TextBlock Grid.Row="3"
                                       Text="路径 4"
                                       Style="{StaticResource CyanFormLabelStyle}"
                                       Margin="0,8,10,0"/>
                            <ui:TextBox Grid.Row="3"
                                     Grid.Column="1"
                                     Text="{Binding Path4, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"
                                     Margin="0,8,8,0"/>
                            <ui:Button Grid.Row="3"
                                    Grid.Column="2"
                                    Margin="0,8,0,0"
                                    Command="{Binding SelectFolderCommand}"
                                    CommandParameter="Path4"
                                    Style="{StaticResource CyanSmallIconButtonStyle}"
                                    ToolTip="选择路径 4">
                                <ui:SymbolIcon Symbol="FolderOpen24"/>
                            </ui:Button>

                            <TextBlock Grid.Row="4"
                                       Text="路径 5"
                                       Style="{StaticResource CyanFormLabelStyle}"
                                       Margin="0,8,10,0"/>
                            <ui:TextBox Grid.Row="4"
                                     Grid.Column="1"
                                     Text="{Binding Path5, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"
                                     Margin="0,8,8,0"/>
                            <ui:Button Grid.Row="4"
                                    Grid.Column="2"
                                    Margin="0,8,0,0"
                                    Command="{Binding SelectFolderCommand}"
                                    CommandParameter="Path5"
                                    Style="{StaticResource CyanSmallIconButtonStyle}"
                                    ToolTip="选择路径 5">
                                <ui:SymbolIcon Symbol="FolderOpen24"/>
                            </ui:Button>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="3"
                              Header="配置"
                              Style="{StaticResource CyanGroupBoxStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding Configs}"
                                      SelectedItem="{Binding SelectedConfig, Mode=TwoWay}"
                                      Text="{Binding NewConfigName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="Name"
                                      VerticalContentAlignment="Center"
                                      IsEditable="True"
                                      Margin="0,0,8,0"/>
                            <ui:Button Grid.Column="1"
                                    Command="{Binding SaveConfigCommand}"
                                    Content="保存"
                                    Style="{StaticResource CyanCommandButtonStyle}"/>
                            <ui:Button Grid.Column="2"
                                    Command="{Binding DeleteConfigCommand}"
                                    Content="删除"
                                    Style="{StaticResource CyanCommandButtonStyle}"
                                    Margin="0"/>

                            <ui:Button Grid.Row="1"
                                    Grid.ColumnSpan="3"
                                    Command="{Binding RunCommand}"
                                    IsEnabled="{Binding IsRunEnabled}"
                                    Style="{StaticResource CyanPrimaryActionButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="PlayCircle24"
                                                   Margin="0,0,6,0"/>
                                    <TextBlock Text="运行"/>
                                </StackPanel>
                            </ui:Button>
                        </Grid>
                    </GroupBox>
                </Grid>
            </ScrollViewer>

            <GridSplitter Grid.Column="1"
                          Style="{StaticResource CyanGridSplitterStyle}"/>

            <GroupBox Grid.Column="2"
                      Header="输出日志"
                      Style="{StaticResource CyanGroupBoxStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0"
                          Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SelectedFunction, Converter={StaticResource LocalizedTextConverter}, ConverterParameter='当前任务：{0}'}"
                                   Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                   VerticalAlignment="Center"/>
                        <ui:Button Grid.Column="1"
                                Command="{Binding ClearLogCommand}"
                                Style="{StaticResource CyanCommandButtonStyle}"
                                Margin="0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Broom24"
                                               Margin="0,0,6,0"/>
                                <TextBlock Text="清空日志"/>
                            </StackPanel>
                        </ui:Button>
                    </Grid>

                    <ui:TextBox Grid.Row="1"
                             Text="{Binding LogText, Mode=OneWay}"
                             Style="{StaticResource CyanLogTextBoxStyle}"
                             HorizontalScrollBarVisibility="Disabled"/>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
