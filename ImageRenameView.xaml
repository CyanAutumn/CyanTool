<UserControl x:Class="CyanTools.ImageRenameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:utils="clr-namespace:CyanTools.Utils"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <utils:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Style="{StaticResource CyanPageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CyanCardStyle}"
                Margin="0,0,0,14"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CyanIconBadgeStyle}"
                        Margin="0,0,14,0">
                    <ui:SymbolIcon Symbol="Edit24"
                                   FontSize="22"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="图片重命名"
                               Style="{StaticResource CyanSectionTitleStyle}" />
                    <TextBlock Text="按前缀、起始编号和位数批量预览并重命名图片。"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <GroupBox Header="路径选择"
                  Grid.Row="1"
                  Margin="0,0,0,12"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="输入路径"
                           Style="{StaticResource CyanFormLabelStyle}" />
                <TextBox Grid.Column="1"
                         Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding HasInheritedInputPath}"
                         Margin="0,0,8,0" />
                <Button Grid.Column="2"
                        Command="{Binding SelectInputPathCommand}"
                        Style="{StaticResource CyanSmallIconButtonStyle}"
                        ToolTip="选择输入路径"
                        Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                    <ui:SymbolIcon Symbol="FolderOpen24" />
                </Button>

                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Text="工作流中此输入路径固定为上一个节点的输出路径；如果上一个节点没有输出路径，则沿用其输入路径。"
                           Style="{StaticResource CyanSecondaryTextBlockStyle}"
                           Margin="0,6,0,0"
                           Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </GroupBox>

        <GroupBox Header="命名规则"
                  Grid.Row="2"
                  Margin="0,0,0,12"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="名称前缀"
                           Style="{StaticResource CyanFormLabelStyle}" />
                <TextBox Grid.Column="1"
                         Text="{Binding NamePrefix, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,14,0" />
                <TextBlock Grid.Column="2"
                           Text="起始编号"
                           Style="{StaticResource CyanFormLabelStyle}" />
                <TextBox Grid.Column="3"
                         Text="{Binding StartIndex, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,14,0" />
                <TextBlock Grid.Column="4"
                           Text="编号位数"
                           Style="{StaticResource CyanFormLabelStyle}" />
                <TextBox Grid.Column="5"
                         Text="{Binding NumberPadding, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="1"
                           Grid.ColumnSpan="7"
                           Style="{StaticResource CyanSecondaryTextBlockStyle}"
                           Margin="0,10,0,0">
                    <Run Text="示例: " />
                    <Run Text="{Binding SampleFileName}" />
                </TextBlock>
            </Grid>
        </GroupBox>

        <GroupBox Header="执行"
                  Grid.Row="3"
                  Margin="0,0,0,12"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CyanPillStyle}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="文件数"
                                   FontWeight="SemiBold"
                                   Margin="0,0,8,0" />
                        <TextBlock Text="{Binding FileCount}" />
                    </StackPanel>
                </Border>

                <Button Grid.Column="2"
                        Command="{Binding RefreshPreviewCommand}"
                        Style="{StaticResource CyanCommandButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Eye24"
                                       Margin="0,0,6,0" />
                        <TextBlock Text="生成预览" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3"
                        Command="{Binding ExecuteRenameCommand}"
                        Style="{StaticResource CyanPrimaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Edit24"
                                       Margin="0,0,6,0" />
                        <TextBlock Text="开始重命名" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="4"
                        Command="{Binding ShuffleRenameCommand}"
                        Style="{StaticResource CyanCommandButtonStyle}"
                        Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowShuffle24"
                                       Margin="0,0,6,0" />
                        <TextBlock Text="开始打乱" />
                    </StackPanel>
                </Button>
            </Grid>
        </GroupBox>

        <GroupBox Header="重命名预览"
                  Grid.Row="4"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="存在命名冲突，请调整规则后重试。"
                           Foreground="{StaticResource CyanDangerHoverBrush}"
                           Margin="0,0,0,10"
                           FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasConflicts}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ListView Grid.Row="1"
                          ItemsSource="{Binding PreviewItems}"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                          Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="序号" DisplayMemberBinding="{Binding SequenceNumber}" Width="70" />
                            <GridViewColumn Header="原文件名" DisplayMemberBinding="{Binding OriginalName}" Width="240" />
                            <GridViewColumn Header="新文件名" DisplayMemberBinding="{Binding NewName}" Width="240" />
                            <GridViewColumn Header="状态" DisplayMemberBinding="{Binding Status}" Width="120" />
                        </GridView>
                    </ListView.View>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasConflict}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource CyanDangerHoverBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
