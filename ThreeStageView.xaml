<UserControl x:Class="CyanTools.ThreeStageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             xmlns:utils="clr-namespace:CyanTools.Utils"
             mc:Ignorable="d"
             d:DesignHeight="520"
             d:DesignWidth="900">
    <UserControl.Resources>
        <utils:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Style="{StaticResource CyanPageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CyanCardStyle}"
                Margin="0,0,0,12"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CyanIconBadgeStyle}"
                        Margin="0,0,14,0">
                    <ui:SymbolIcon Symbol="ImageMultiple24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </Border>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <TextBlock Text="图片三分法处理"
                               Style="{StaticResource CyanSectionTitleStyle}" />
                    <TextBlock Text="人物、半身、头部与眼部裁切参数集中配置。"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          Style="{StaticResource CyanPageScrollViewerStyle}">
                <StackPanel>
                    <GroupBox Header="路径"
                              Margin="0,0,0,12"
                              Style="{StaticResource CyanGroupBoxStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="输入路径"
                                       Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                       Margin="0,0,0,6" />
                            <TextBox Grid.Row="1"
                                     Name="InputFolderTextBox"
                                     Text="{Binding InputFolder}"
                                     IsReadOnly="{Binding HasInheritedInputPath}"
                                     Margin="0,0,8,0" />
                            <Button Grid.Row="1"
                                    Grid.Column="1"
                                    Command="{Binding BrowseInputFolderCommand}"
                                    Style="{StaticResource CyanSmallIconButtonStyle}"
                                    ToolTip="选择输入路径"
                                    Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                <ui:SymbolIcon Symbol="FolderOpen24" />
                            </Button>
                            <TextBlock Grid.Row="2"
                                       Grid.ColumnSpan="2"
                                       Text="工作流中此输入路径固定为上一个节点的输出路径；如果上一个节点没有输出路径，则沿用其输入路径。"
                                       Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                       Margin="0,6,0,0"
                                       Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <CheckBox Grid.Row="3"
                                      Grid.ColumnSpan="2"
                                      Content="执行完成后清空输入路径文件夹"
                                      IsChecked="{Binding ShouldClearInputDirectoryAfterCompletion}"
                                      Margin="0,8,0,10"
                                      ToolTip="执行成功后会删除输入路径文件夹中的内容，并自动保留输出路径。" />

                            <TextBlock Grid.Row="4"
                                       Text="输出路径"
                                       Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                       Margin="0,0,0,6"
                                       Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                            <Grid Grid.Row="5"
                                  Grid.ColumnSpan="2"
                                  Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Name="OutputFolderTextBox"
                                         Text="{Binding OutputFolder}"
                                         Margin="0,0,8,0" />
                                <Button Grid.Column="1"
                                        Command="{Binding BrowseOutputFolderCommand}"
                                        Style="{StaticResource CyanSmallIconButtonStyle}"
                                        ToolTip="选择输出路径">
                                    <ui:SymbolIcon Symbol="FolderOpen24" />
                                </Button>
                            </Grid>
                            <TextBlock Grid.Row="6"
                                       Grid.ColumnSpan="2"
                                       Text="工作流模式下输出路径自动生成：父级目录/NN-节点名"
                                       Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="人物检测"
                              Margin="0,0,0,12"
                              Style="{StaticResource CyanGroupBoxStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Content="启用"
                                      IsChecked="{Binding SplitPerson}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding PersonConfThreshold}"
                                     ToolTip="置信度阈值" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="半身检测"
                              Margin="0,0,0,12"
                              Style="{StaticResource CyanGroupBoxStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.ColumnSpan="2"
                                      Content="启动"
                                      IsChecked="{Binding SplitHalfbody}" />
                            <TextBlock Grid.Row="1"
                                       Text="置信度阈值"
                                       Style="{StaticResource CyanFormLabelStyle}"
                                       Margin="0,10,10,0" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Text="{Binding HalfbodyConfThreshold}"
                                     Margin="0,10,0,0" />
                            <TextBlock Grid.Row="2"
                                       Text="追加Tag"
                                       Style="{StaticResource CyanFormLabelStyle}"
                                       Margin="0,10,10,0" />
                            <TextBox Grid.Row="2"
                                     Grid.Column="1"
                                     Text="{Binding HalfbodyAppendTag}"
                                     Margin="0,10,0,0" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="头部检测"
                              Margin="0,0,0,12"
                              Style="{StaticResource CyanGroupBoxStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.ColumnSpan="2"
                                      Content="启动"
                                      IsChecked="{Binding SplitHead}" />
                            <TextBlock Grid.Row="1"
                                       Text="置信度阈值"
                                       Style="{StaticResource CyanFormLabelStyle}"
                                       Margin="0,10,10,0" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Text="{Binding HeadConfThreshold}"
                                     Margin="0,10,0,0" />
                            <TextBlock Grid.Row="2"
                                       Text="头部缩放"
                                       Style="{StaticResource CyanFormLabelStyle}"
                                       Margin="0,10,10,0" />
                            <TextBox Grid.Row="2"
                                     Grid.Column="1"
                                     Text="{Binding HeadScale}"
                                     Margin="0,10,0,0" />
                            <TextBlock Grid.Row="3"
                                       Text="追加Tag"
                                       Style="{StaticResource CyanFormLabelStyle}"
                                       Margin="0,10,10,0" />
                            <TextBox Grid.Row="3"
                                     Grid.Column="1"
                                     Text="{Binding HeadAppendTag}"
                                     Margin="0,10,0,0" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="眼部检测"
                              Margin="0,0,0,12"
                              Style="{StaticResource CyanGroupBoxStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.ColumnSpan="2"
                                      Content="启用眼部检测"
                                      IsChecked="{Binding SplitEyes}" />
                            <TextBlock Grid.Row="1"
                                       Text="置信度阈值"
                                       Style="{StaticResource CyanFormLabelStyle}"
                                       Margin="0,10,10,0" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Text="{Binding EyeConfThreshold}"
                                     Margin="0,10,0,0" />
                            <TextBlock Grid.Row="2"
                                       Text="眼部缩放"
                                       Style="{StaticResource CyanFormLabelStyle}"
                                       Margin="0,10,10,0" />
                            <TextBox Grid.Row="2"
                                     Grid.Column="1"
                                     Text="{Binding EyeScale}"
                                     Margin="0,10,0,0" />
                            <TextBlock Grid.Row="3"
                                       Text="追加Tag"
                                       Style="{StaticResource CyanFormLabelStyle}"
                                       Margin="0,10,10,0" />
                            <TextBox Grid.Row="3"
                                     Grid.Column="1"
                                     Text="{Binding EyeAppendTag}"
                                     Margin="0,10,0,0" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="其他选项"
                              Style="{StaticResource CyanGroupBoxStyle}">
                        <StackPanel>
                            <CheckBox Content="保留原始标签"
                                      IsChecked="{Binding KeepOriginTags}" />
                            <TextBlock Text="说明：追加 tag 只会追加所写的视角 tag，新出现的图片需要重新打标。"
                                       Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1"
                          Style="{StaticResource CyanGridSplitterStyle}" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox Header="执行"
                          Grid.Row="0"
                          Margin="0,0,0,12"
                          Style="{StaticResource CyanGroupBoxStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding StartProcessingCommand}"
                                Style="{StaticResource CyanPrimaryActionButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ImageSparkle24"
                                               Margin="0,0,6,0" />
                                <TextBlock Text="开始处理" />
                            </StackPanel>
                        </Button>
                        <Button Content="停止处理"
                                Command="{Binding StopProcessingCommand}"
                                Style="{StaticResource CyanCommandButtonStyle}" />
                        <Button Command="{Binding ClearLogCommand}"
                                Style="{StaticResource CyanCommandButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Broom24"
                                               Margin="0,0,6,0" />
                                <TextBlock Text="清空日志" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="处理日志"
                          Grid.Row="1"
                          Style="{StaticResource CyanGroupBoxStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListBox Grid.Row="0"
                                 ItemsSource="{Binding LogLines}"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 SelectionMode="Single"
                                 HorizontalContentAlignment="Stretch"
                                 Style="{StaticResource CyanListBoxSurfaceStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="1"
                                    Margin="0,12,0,0">
                            <TextBlock Text="{Binding ProgressText, Converter={StaticResource LocalizedTextConverter}}"
                                       Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                       Margin="0,0,0,6" />
                            <ProgressBar Height="20"
                                         Value="{Binding ProgressPercentage}"
                                         Maximum="100" />
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
