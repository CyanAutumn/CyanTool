<UserControl x:Class="CyanTools.ImageProcessingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.DataContext>
        <viewModel:ImageProcessingViewModel />
    </UserControl.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Style="{StaticResource CyanCardStyle}"
                Margin="0,0,0,14"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CyanIconBadgeStyle}"
                        Margin="0,0,14,0">
                    <ui:SymbolIcon Symbol="ImageEdit24"
                                   FontSize="22"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="图片处理"
                               Style="{StaticResource CyanSectionTitleStyle}" />
                    <TextBlock Text="对目标路径中的图片执行镜像等轻量批处理操作。"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <GroupBox Header="路径"
                  Grid.Row="1"
                  Grid.Column="1"
                  Margin="0,0,0,12"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <Grid Grid.Row="0" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="输入路径"
                           Style="{StaticResource CyanFormLabelStyle}" />
                <ui:TextBox Grid.Column="1"
                         Text="{Binding TargetDirectory, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,8,0" />
                <ui:Button Grid.Column="2"
                        Command="{Binding BrowseDirectoryCommand}"
                        Style="{StaticResource CyanSmallIconButtonStyle}"
                        ToolTip="选择输入路径">
                    <ui:SymbolIcon Symbol="FolderOpen24" />
                </ui:Button>
            </Grid>
        </GroupBox>

        <GroupBox Header="处理选项"
                  Grid.Row="2"
                  Grid.Column="1"
                  Margin="0,0,0,12"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <CheckBox Content="镜像图片（左右翻转）"
                      IsChecked="{Binding IsMirrorEnabled}" />
        </GroupBox>

        <GroupBox Header="执行"
                  Grid.Row="3"
                  Grid.Column="1"
                  Margin="0,0,0,12"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <ui:Button Command="{Binding StartProcessingCommand}"
                    IsEnabled="{Binding IsIdle}"
                    Style="{StaticResource CyanPrimaryActionButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ImageSparkle24"
                                   Margin="0,0,6,0" />
                    <TextBlock Text="开始处理" />
                </StackPanel>
            </ui:Button>
        </GroupBox>

        <GroupBox Header="日志"
                  Grid.Row="4"
                  Grid.Column="1"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <DockPanel>
                <ui:Button Content="清空日志"
                        Command="{Binding ClearLogCommand}"
                        IsEnabled="{Binding IsIdle}"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Top"
                        Style="{StaticResource CyanCommandButtonStyle}"
                        Margin="0,0,0,10" />
                <ListBox ItemsSource="{Binding LogLines}"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         HorizontalContentAlignment="Stretch"
                         Style="{StaticResource CyanListBoxSurfaceStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </GroupBox>
    </Grid>
</UserControl>
