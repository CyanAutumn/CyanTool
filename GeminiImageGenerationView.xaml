<UserControl x:Class="CyanTools.GeminiImageGenerationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             xmlns:utils="clr-namespace:CyanTools.Utils"
             mc:Ignorable="d"
             d:DesignHeight="680"
             d:DesignWidth="1080"
             Background="Transparent">
    <UserControl.Resources>
        <utils:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <utils:BooleanToInverseBooleanConverter x:Key="BooleanToInverseBooleanConverter"/>
    </UserControl.Resources>

    <UserControl.DataContext>
        <viewModel:GeminiImageGenerationViewModel />
    </UserControl.DataContext>

    <ScrollViewer Style="{StaticResource CyanPageScrollViewerStyle}">
        <Grid Style="{StaticResource CyanPageGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource CyanHeroPanelStyle}"
                    Margin="0,0,0,14"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CyanIconBadgeStyle}"
                            Margin="0,0,16,0">
                        <ui:SymbolIcon Symbol="ImageSplit24"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Gemini 图像生成"
                                   Style="{StaticResource CyanPageTitleStyle}"
                                   FontSize="30"/>
                        <TextBlock Text="素材、提示词、模型参数和生成结果集中在一个更清爽的工作台里。"
                                   Style="{StaticResource CyanPageSubtitleStyle}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                MinWidth="180"
                                VerticalAlignment="Center"
                                Margin="18,0,0,0">
                        <TextBlock Text="状态"
                                   Style="{StaticResource CyanTinyTextBlockStyle}"/>
                        <TextBlock Text="{Binding StatusMessage, Converter={StaticResource LocalizedTextConverter}}"
                                   TextWrapping="Wrap"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding QueueStatusText, Converter={StaticResource LocalizedTextConverter}}"
                                   Style="{StaticResource CyanTinyTextBlockStyle}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.08*" MinWidth="410"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="1.42*" MinWidth="500"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="360"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="330"/>
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0"
                              Header="素材图片"
                              Style="{StaticResource CyanGroupBoxStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding InputImages.Count, StringFormat=已选择 {0} 张}"
                                           Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Command="{Binding SelectImageCommand}"
                                        Style="{StaticResource CyanCommandButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="AddCircle24"
                                                       Margin="0,0,6,0"/>
                                        <TextBlock Text="添加图片"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2"
                                        Command="{Binding ClearInputCommand}"
                                        Style="{StaticResource CyanCommandButtonStyle}"
                                        Margin="0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Broom24"
                                                       Margin="0,0,6,0"/>
                                        <TextBlock Text="清空"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Grid.Row="1"
                                    Style="{StaticResource CyanImageWellStyle}"
                                    AllowDrop="True"
                                    Drop="OnInputImageDrop"
                                    DragEnter="OnInputImageDragEnter"
                                    Padding="10">
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding InputImages}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="158"
                                                            Height="168"
                                                            Margin="4"
                                                            Style="{StaticResource CyanThumbnailCardStyle}"
                                                            ToolTip="{Binding Path}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid Grid.Row="0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding FileName}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,6,0"/>
                                                                <Button Grid.Column="1"
                                                                        Width="24"
                                                                        Height="24"
                                                                        Padding="0"
                                                                        Command="{Binding DataContext.RemoveImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="移除">
                                                                    <ui:SymbolIcon Symbol="Broom24"
                                                                                   FontSize="13"/>
                                                                </Button>
                                                            </Grid>
                                                            <Border Grid.Row="1"
                                                                    Style="{StaticResource CyanImageWellStyle}"
                                                                    Margin="0,8,0,8">
                                                                <Image Source="{Binding Thumbnail}"
                                                                       Stretch="Uniform"/>
                                                            </Border>
                                                            <TextBlock Grid.Row="2"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                                <Run Text="{Binding DisplayPixels}"/>
                                                                <Run Text="  "/>
                                                                <Run Text="{Binding DisplaySize}"/>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasInputImages, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                        <ui:SymbolIcon Symbol="ImageSplit24"
                                                       FontSize="32"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       HorizontalAlignment="Center"/>
                                        <TextBlock Text="拖入素材或点击添加图片"
                                                   Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                                   FontSize="15"
                                                   Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="2"
                              Header="生成结果"
                              Style="{StaticResource CyanGroupBoxStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Style="{StaticResource CyanImageWellStyle}"
                                    Padding="10"
                                    MouseLeftButtonUp="OnResultImageClick"
                                    Cursor="Hand">
                                <Grid>
                                    <Image Source="{Binding ResultImageSource}"
                                           Stretch="Uniform"/>
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasResultImage, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                        <ui:SymbolIcon Symbol="ImageSplit24"
                                                       FontSize="34"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       HorizontalAlignment="Center"/>
                                        <TextBlock Text="还没有生成结果"
                                                   Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                                   FontSize="15"
                                                   Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Button Grid.Row="1"
                                    Command="{Binding ClearResultCommand}"
                                    Style="{StaticResource CyanCommandButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Broom24"
                                                   Margin="0,0,6,0"/>
                                    <TextBlock Text="清空结果"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </GroupBox>
                </Grid>

                <GridSplitter Grid.Column="1"
                              Style="{StaticResource CyanGridSplitterStyle}"/>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="230"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="260"/>
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0"
                              Header="配置与模型"
                              Style="{StaticResource CyanGroupBoxStyle}"
                              Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="配置名"
                                       Style="{StaticResource CyanFormLabelStyle}"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableConfigNames}"
                                      Text="{Binding SelectedConfigName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="False"
                                      Margin="0,0,8,0"/>
                            <Button Grid.Column="2"
                                    Content="保存"
                                    Command="{Binding SaveConfigCommand}"
                                    Style="{StaticResource CyanCommandButtonStyle}"/>
                            <Button Grid.Column="3"
                                    Content="删除"
                                    Command="{Binding DeleteConfigCommand}"
                                    Style="{StaticResource CyanCommandButtonStyle}"
                                    Margin="0"/>

                            <TextBlock Grid.Row="1"
                                       Text="API Key"
                                       Style="{StaticResource CyanFormLabelStyle}"
                                       Margin="0,10,10,0"/>
                            <PasswordBox Grid.Row="1"
                                         Grid.Column="1"
                                         Grid.ColumnSpan="3"
                                         utils:PasswordBoxHelper.BindPassword="True"
                                         utils:PasswordBoxHelper.BoundPassword="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"
                                         Margin="0,10,0,0"/>

                            <TextBlock Grid.Row="2"
                                       Text="模型"
                                       Style="{StaticResource CyanFormLabelStyle}"
                                       Margin="0,10,10,0"/>
                            <ComboBox Grid.Row="2"
                                      Grid.Column="1"
                                      ItemsSource="{Binding AvailableModels}"
                                      SelectedItem="{Binding SelectedModel}"
                                      Margin="0,10,8,0"/>
                            <TextBox Grid.Row="2"
                                     Grid.Column="2"
                                     Grid.ColumnSpan="2"
                                     Text="{Binding ApiBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="API 地址"
                                     VerticalContentAlignment="Center"
                                     MinWidth="220"
                                     Margin="0,10,0,0"/>

                            <StackPanel Grid.Row="4"
                                        Grid.ColumnSpan="4"
                                        Margin="0,12,0,0">
                                <TextBlock Text="{Binding StatusMessage, Converter={StaticResource LocalizedTextConverter}}"
                                           TextWrapping="Wrap"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{Binding QueueStatusText, Converter={StaticResource LocalizedTextConverter}}"
                                           Style="{StaticResource CyanTinyTextBlockStyle}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="1"
                              Header="生成设置"
                              Style="{StaticResource CyanGroupBoxStyle}"
                              Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Temperature"
                                       Style="{StaticResource CyanFormLabelStyle}"/>
                            <Slider Grid.Column="1"
                                    Minimum="0"
                                    Maximum="1"
                                    Value="{Binding Temperature, Mode=TwoWay}"
                                    TickFrequency="0.1"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Temperature, StringFormat=F2}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>

                            <TextBlock Grid.Row="1"
                                       Text="尺寸"
                                       Style="{StaticResource CyanFormLabelStyle}"
                                       Margin="0,10,10,0"/>
                            <ComboBox Grid.Row="1"
                                      Grid.Column="1"
                                      ItemsSource="{Binding ImageSizeOptions}"
                                      SelectedItem="{Binding SelectedImageSizeOption}"
                                      Margin="0,10,10,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display, Converter={StaticResource LocalizedTextConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Row="1"
                                       Grid.Column="3"
                                       Text="宽高比"
                                       Style="{StaticResource CyanFormLabelStyle}"
                                       Margin="8,10,10,0"/>
                            <ComboBox Grid.Row="1"
                                      Grid.Column="4"
                                      ItemsSource="{Binding AspectRatioOptions}"
                                      SelectedItem="{Binding SelectedAspectRatioOption}"
                                      Margin="0,10,0,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display, Converter={StaticResource LocalizedTextConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="2"
                                       Text="批量间隔"
                                       Style="{StaticResource CyanFormLabelStyle}"
                                       Margin="0,10,10,0"/>
                            <StackPanel Grid.Row="2"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Margin="0,10,0,0">
                                <TextBox Width="68"
                                         Text="{Binding DelayMinSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"/>
                                <TextBlock Text="-"
                                           VerticalAlignment="Center"
                                           Margin="8,0"/>
                                <TextBox Width="68"
                                         Text="{Binding DelayMaxSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"/>
                                <TextBlock Text="秒"
                                           Style="{StaticResource CyanTinyTextBlockStyle}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2"
                                       Grid.Column="3"
                                       Text="张数"
                                       Style="{StaticResource CyanFormLabelStyle}"
                                       Margin="8,10,10,0"/>
                            <TextBox Grid.Row="2"
                                     Grid.Column="4"
                                     Text="{Binding BatchCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"
                                     Margin="0,10,0,0"/>

                            <TextBlock Grid.Row="3"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="4"
                                       Text="{Binding ImageSizeValidationError}"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding HasImageSizeValidationError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="2"
                              Header="提示词"
                              Style="{StaticResource CyanGroupBoxStyle}"
                              Margin="0,0,0,12">
                        <TextBox Text="{Binding Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="10"/>
                    </GroupBox>

                    <GroupBox Grid.Row="3"
                              Header="执行"
                              Style="{StaticResource CyanGroupBoxStyle}"
                              Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Command="{Binding GenerateCommand}"
                                    Style="{StaticResource CyanPrimaryActionButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="PlayCircle24"
                                                   Margin="0,0,6,0"/>
                                    <TextBlock Text="开始生成"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1"
                                    Command="{Binding BatchGenerateCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanToInverseBooleanConverter}}"
                                    Style="{StaticResource CyanCommandButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="AddCircle24"
                                                   Margin="0,0,6,0"/>
                                    <TextBlock Text="批量生成"/>
                                </StackPanel>
                            </Button>
                            <ProgressBar Grid.Column="2"
                                         Height="18"
                                         Margin="10,0,0,0"
                                         VerticalAlignment="Center"
                                         IsIndeterminate="True"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="4"
                              Header="日志"
                              Style="{StaticResource CyanGroupBoxStyle}">
                        <ListBox ItemsSource="{Binding LogLines}"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 HorizontalContentAlignment="Stretch"
                                 Style="{StaticResource CyanListBoxSurfaceStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </GroupBox>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
