<UserControl x:Class="CyanTools.GeminiImageGenerationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             xmlns:utils="clr-namespace:CyanTools.Utils"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="Transparent">
    <UserControl.Resources>
        <utils:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <utils:BooleanToInverseBooleanConverter x:Key="BooleanToInverseBooleanConverter"/>
    </UserControl.Resources>
    <UserControl.DataContext>
        <viewModel:GeminiImageGenerationViewModel />
    </UserControl.DataContext>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <GroupBox Header="素材图片" Grid.Row="0" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="#FFCCCCCC" BorderThickness="1" CornerRadius="4"
                            AllowDrop="True"
                            Drop="OnInputImageDrop"
                            DragEnter="OnInputImageDragEnter"
                            Background="#FFF9F9F9" Padding="8">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding InputImages}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="3" Margin="4" Padding="6" Width="150"
                                                    ToolTip="{Binding Path}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding FileName}"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,4,0"/>
                                                        <Button Grid.Column="1" Content="×" Width="20" Height="20" Padding="0"
                                                                Command="{Binding DataContext.RemoveImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <StackPanel Grid.Row="1">
                                                        <Border Height="90" Background="#FFF3F3F3" Margin="0,6,0,0">
                                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                                        </Border>
                                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                            <TextBlock Text="{Binding DisplayPixels}" Foreground="Gray"/>
                                                            <TextBlock Text=" | " Foreground="Gray" Margin="4,0"/>
                                                            <TextBlock Text="{Binding DisplaySize}" Foreground="Gray"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasInputImages, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                <TextBlock Text="拖拽图片到这里" FontSize="16" Foreground="Gray" HorizontalAlignment="Center"/>
                                <TextBlock Text="或点击下方按钮选择" Foreground="Gray" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Bottom">
                        <Button Content="选择图片..." Command="{Binding SelectImageCommand}" Padding="12,6" />
                        <Button Content="清空素材" Command="{Binding ClearInputCommand}" Padding="12,6" Margin="10,0,0,0"/>
                        <TextBlock Text="{Binding InputImages.Count, StringFormat=已选择 {0} 张}" Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Header="生成结果" Grid.Row="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="#FFCCCCCC" BorderThickness="1" CornerRadius="4" Background="#FFF9F9F9"
                            MouseLeftButtonUp="OnResultImageClick" Cursor="Hand">
                        <Grid>
                            <Image Source="{Binding ResultImageSource}" Stretch="Uniform" Margin="10"/>
                            <TextBlock Text="还没有生成结果" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasResultImage, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Bottom">
                        <Button Content="清空结果" Command="{Binding ClearResultCommand}" Padding="12,6"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <GroupBox Header="配置" Grid.Row="0" Margin="0,0,0,10">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="配置名:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableConfigNames}" Text="{Binding SelectedConfigName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True" Margin="0,0,8,0" Height="28" IsTextSearchEnabled="False"/>
                    <Button Grid.Column="2" Content="保存" Command="{Binding SaveConfigCommand}" Padding="10,6" Margin="0,0,6,0"/>
                    <Button Grid.Column="3" Content="删除" Command="{Binding DeleteConfigCommand}" Padding="10,6"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="鉴权与模型" Grid.Row="1" Margin="0,0,0,10">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="API Key:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <PasswordBox Grid.Row="0" Grid.Column="1" Height="28"
                                 utils:PasswordBoxHelper.BindPassword="True"
                                 utils:PasswordBoxHelper.BoundPassword="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="模型:" VerticalAlignment="Center" Margin="0,6,8,0"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedModel}"
                              Margin="0,6,0,0" Height="28"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="生成设置" Grid.Row="2" Margin="0,0,0,10">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Temperature:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Temperature, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Temperature, StringFormat=F2}" VerticalAlignment="Center" Foreground="Gray"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="生图尺寸:" VerticalAlignment="Center" Margin="0,8,8,0"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ImageSizeOptions}" SelectedItem="{Binding SelectedImageSizeOption}"
                              DisplayMemberPath="Display" Margin="0,8,0,0" Height="28"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="固定为 1K / 2K / 4K（大写 K）" VerticalAlignment="Center" Foreground="Gray" Margin="6,8,0,0"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="长宽比:" VerticalAlignment="Center" Margin="0,8,8,0"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding AspectRatioOptions}" SelectedItem="{Binding SelectedAspectRatioOption}"
                              DisplayMemberPath="Display" Margin="0,8,0,0" Height="28"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="可选或留空" VerticalAlignment="Center" Foreground="Gray" Margin="6,8,0,0"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="批量等待(s):" VerticalAlignment="Center" Margin="0,8,8,0"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBox Width="60" Text="{Binding DelayMinSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                        <TextBlock Text=" - " VerticalAlignment="Center" Margin="4,0"/>
                        <TextBox Width="60" Text="{Binding DelayMaxSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="最小/最大" VerticalAlignment="Center" Foreground="Gray" Margin="6,8,0,0"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="批量张数:" VerticalAlignment="Center" Margin="0,8,8,0"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Width="80" Text="{Binding BatchCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="1-10" VerticalAlignment="Center" Foreground="Gray" Margin="6,8,0,0"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="提示词" Grid.Row="3" Margin="0,0,0,10">
                <DockPanel>
                    <TextBox Text="{Binding Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             MinHeight="120" />
                </DockPanel>
            </GroupBox>

            <StackPanel Grid.Row="4" Orientation="Vertical" HorizontalAlignment="Left" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <Button Content="开始生成" Command="{Binding GenerateCommand}" Padding="16,8"/>
                    <Button Content="批量生成(最多10张)" Command="{Binding BatchGenerateCommand}" Padding="16,8" Margin="10,0,0,0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanToInverseBooleanConverter}}"/>
                    <ProgressBar Width="140" Height="18" Margin="10,0,0,0"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
                <TextBlock Text="{Binding QueueStatusText}" Margin="2,6,0,0" Foreground="Gray"/>
            </StackPanel>

            <Grid Grid.Row="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Row="0">
                    <TextBlock Text="状态:" FontWeight="Bold"/>
                    <TextBlock Text="{Binding StatusMessage}" Margin="5,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding LogLines}" Margin="0,5,0,0"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
