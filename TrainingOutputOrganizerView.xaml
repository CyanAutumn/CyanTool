<UserControl x:Class="CyanTools.TrainingOutputOrganizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:utils="clr-namespace:CyanTools.Utils"
             mc:Ignorable="d"
             d:DesignHeight="420"
             d:DesignWidth="760"
             Background="Transparent">
    <UserControl.Resources>
        <utils:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Style="{StaticResource CyanPageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <GroupBox Header="LoRA epoch 文件整理"
                  Grid.Row="0"
                  Margin="0,0,0,12"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="输入文件夹"
                           Style="{StaticResource CyanFormLabelStyle}" />
                <TextBox Grid.Column="1"
                         Text="{Binding InputFolder, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding HasInheritedInputPath}"
                         Margin="0,0,8,0" />
                <Button Grid.Column="2"
                        Command="{Binding BrowseInputFolderCommand}"
                        Style="{StaticResource CyanSmallIconButtonStyle}"
                        ToolTip="选择输入文件夹"
                        Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                    <ui:SymbolIcon Symbol="FolderOpen24" />
                </Button>

                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Text="管道调度中此输入路径固定为上一个节点的输出路径。"
                           Style="{StaticResource CyanSecondaryTextBlockStyle}"
                           Margin="0,6,0,0"
                           Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <TextBlock Grid.Row="2"
                           Text="输出文件夹"
                           Style="{StaticResource CyanFormLabelStyle}"
                           Margin="0,12,10,0"
                           Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                <TextBox Grid.Row="2"
                         Grid.Column="1"
                         Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,12,8,0"
                         Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                <Button Grid.Row="2"
                        Grid.Column="2"
                        Command="{Binding BrowseOutputFolderCommand}"
                        Style="{StaticResource CyanSmallIconButtonStyle}"
                        Margin="0,12,0,0"
                        ToolTip="选择输出文件夹"
                        Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                    <ui:SymbolIcon Symbol="FolderOpen24" />
                </Button>

                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Text="工作流模式下输出路径自动生成。"
                           Style="{StaticResource CyanSecondaryTextBlockStyle}"
                           Margin="0,12,0,0"
                           Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Grid Grid.Row="3"
                      Grid.Column="1"
                      Grid.ColumnSpan="2"
                      Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Content="覆盖已存在文件"
                              IsChecked="{Binding OverwriteExisting}"
                              VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Command="{Binding ConvertModelsCommand}"
                            Style="{StaticResource CyanPrimaryActionButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Archive24"
                                           Margin="0,0,6,0" />
                            <TextBlock Text="开始整理" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1"
                  Header="处理日志"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <TextBox Text="{Binding LogText, Mode=OneWay}"
                     Style="{StaticResource CyanLogTextBoxStyle}"
                     MinHeight="150" />
        </GroupBox>
    </Grid>
</UserControl>
