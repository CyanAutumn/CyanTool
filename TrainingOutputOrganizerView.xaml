<UserControl x:Class="CyanTools.TrainingOutputOrganizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:utils="clr-namespace:CyanTools.Utils"
             mc:Ignorable="d"
             d:DesignHeight="420"
             d:DesignWidth="760">
    <UserControl.Resources>
        <utils:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <GroupBox Header="LoRA epoch &#x6587;&#x4EF6;&#x6574;&#x7406;"
                  Margin="0,0,0,10">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="&#x8F93;&#x5165;&#x6587;&#x4EF6;&#x5939;"
                           VerticalAlignment="Center"
                           Margin="0,0,8,8" />
                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Text="{Binding InputFolder, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding HasInheritedInputPath}"
                         Margin="0,0,8,8" />
                <Button Grid.Row="0"
                        Grid.Column="2"
                        Content="..."
                        Command="{Binding BrowseInputFolderCommand}"
                        Padding="12,2"
                        Margin="0,0,0,8"
                        Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />

                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Text="&#x7BA1;&#x9053;&#x8C03;&#x5EA6;&#x4E2D;&#x6B64;&#x8F93;&#x5165;&#x8DEF;&#x5F84;&#x56FA;&#x5B9A;&#x4E3A;&#x4E0A;&#x4E00;&#x4E2A;&#x8282;&#x70B9;&#x7684;&#x8F93;&#x51FA;&#x8DEF;&#x5F84;&#x3002;"
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="&#x8F93;&#x51FA;&#x6587;&#x4EF6;&#x5939;"
                           VerticalAlignment="Center"
                           Margin="0,0,8,8"
                           Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                <TextBox Grid.Row="2"
                         Grid.Column="1"
                         Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,8,8"
                         Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                <Button Grid.Row="2"
                        Grid.Column="2"
                        Content="..."
                        Command="{Binding BrowseOutputFolderCommand}"
                        Padding="12,2"
                        Margin="0,0,0,8"
                        Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />

                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Text="&#x5DE5;&#x4F5C;&#x6D41;&#x6A21;&#x5F0F;&#x4E0B;&#x8F93;&#x51FA;&#x8DEF;&#x5F84;&#x81EA;&#x52A8;&#x751F;&#x6210;&#x3002;"
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <StackPanel Grid.Row="3"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left">
                    <CheckBox Content="&#x8986;&#x76D6;&#x5DF2;&#x5B58;&#x5728;&#x6587;&#x4EF6;"
                              IsChecked="{Binding OverwriteExisting}"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0" />
                    <Button Content="&#x5F00;&#x59CB;&#x6574;&#x7406;"
                            Command="{Binding ConvertModelsCommand}"
                            Padding="18,4"
                            MinWidth="120" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1"
                  Header="&#x5904;&#x7406;&#x65E5;&#x5FD7;">
            <TextBox Text="{Binding LogText, Mode=OneWay}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     MinHeight="150"
                     Margin="8" />
        </GroupBox>
    </Grid>
</UserControl>
