<UserControl x:Class="CyanTools.TaggingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:CyanTools"
             xmlns:utils="clr-namespace:CyanTools.Utils"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             mc:Ignorable="d"
             d:DesignHeight="560"
             d:DesignWidth="920">
    <UserControl.Resources>
        <utils:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Style="{StaticResource CyanPageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CyanCardStyle}"
                Margin="0,0,0,14"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CyanIconBadgeStyle}"
                        Margin="0,0,14,0">
                    <ui:SymbolIcon Symbol="TagMultiple24"
                                   FontSize="22"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="批量打标"
                               Style="{StaticResource CyanSectionTitleStyle}" />
                    <TextBlock Text="选择输入路径、打标模型和阈值后批量生成标签文件。"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <GroupBox Header="输入"
                  Grid.Row="1"
                  Margin="0,0,0,12"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="输入路径"
                           Style="{StaticResource CyanFormLabelStyle}"/>
                <TextBox Grid.Column="1"
                         Text="{Binding InputDirectory, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding HasInheritedInputPath}"
                         Margin="0,0,8,0"
                         VerticalContentAlignment="Center"/>
                <Button Grid.Column="2"
                        Content="..."
                        Width="40"
                        Command="{Binding BrowseInputCommand}"
                        ToolTip="选择输入路径"
                        Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Text="工作流中此输入路径固定为上一个节点的输出路径；如果上一个节点没有输出路径，则沿用其输入路径。"
                           Style="{StaticResource CyanSecondaryTextBlockStyle}"
                           Margin="0,6,0,0"
                           Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="模型"
                  Grid.Row="2"
                  Margin="0,0,0,12"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="打标器系列"
                           Style="{StaticResource CyanFormLabelStyle}"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding TaggerSeries}"
                          SelectedValue="{Binding SelectedTaggerSeriesId, UpdateSourceTrigger=PropertyChanged}"
                          SelectedValuePath="Id"
                          IsEnabled="{Binding IsIdle}"
                          Margin="0,0,18,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName, Converter={StaticResource LocalizedTextConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Column="2"
                           Text="打标模型"
                           Style="{StaticResource CyanFormLabelStyle}"/>
                <ComboBox Grid.Column="3"
                          ItemsSource="{Binding TaggerModels}"
                          SelectedItem="{Binding SelectedTaggerModel}"
                          DisplayMemberPath="DisplayName"
                          Margin="0,0,8,0"/>
                <Button Grid.Column="4"
                        Command="{Binding AddTaggerCommand}"
                        IsEnabled="{Binding IsIdle}"
                        Style="{StaticResource CyanCommandButtonStyle}"
                        Margin="0"
                        Visibility="{Binding IsOnnxTaggerSeries, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="AddCircle24"
                                       Margin="0,0,6,0"/>
                        <TextBlock Text="添加打标器"/>
                    </StackPanel>
                </Button>
            </Grid>
        </GroupBox>

        <GroupBox Header="标签与阈值"
                  Grid.Row="3"
                  Margin="0,0,0,12"
                  Style="{StaticResource CyanGroupBoxStyle}"
                  Visibility="{Binding IsOnnxTaggerSeries, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="0,0,8,0">
                    <TextBlock Text="自定义标签（逗号分隔）"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               Margin="0,0,0,5"/>
                    <TextBox Text="{Binding CustomTags, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsIdle}"
                             VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Margin="8,0,0,0">
                    <TextBlock Text="前置标签（逗号分隔）"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               Margin="0,0,0,5"/>
                    <TextBox Text="{Binding PriorityTags, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsIdle}"
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <Grid Grid.Row="1"
                      Grid.ColumnSpan="2"
                      Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="同名 txt"
                               Style="{StaticResource CyanFormLabelStyle}"/>
                    <ComboBox Grid.Column="1"
                              IsEnabled="{Binding IsIdle}"
                              ItemsSource="{Binding ExistingTxtConflictOptions}"
                              SelectedItem="{Binding SelectedExistingTxtConflictOption}"
                              MinHeight="32">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName, Converter={StaticResource LocalizedTextConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Column="2"
                               Text="通用阈值"
                               Style="{StaticResource CyanFormLabelStyle}"
                               Margin="18,0,10,0"/>
                    <TextBox Grid.Column="3"
                             Text="{Binding GeneralThreshold, UpdateSourceTrigger=LostFocus}"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Column="4"
                               Text="角色阈值"
                               Style="{StaticResource CyanFormLabelStyle}"
                               Margin="18,0,10,0"/>
                    <TextBox Grid.Column="5"
                             Text="{Binding CharacterThreshold, UpdateSourceTrigger=LostFocus}"
                             VerticalContentAlignment="Center"/>
                </Grid>

                <WrapPanel Grid.Row="2"
                           Grid.ColumnSpan="2"
                           Margin="0,12,0,0"
                           IsEnabled="{Binding IsIdle}">
                    <CheckBox Content="优先使用 GPU(CUDA)" IsChecked="{Binding PreferGpu}" Margin="0,0,12,6"/>
                    <CheckBox Content="评级标签" IsChecked="{Binding IncludeRating}" Margin="0,0,12,6"/>
                    <CheckBox Content="质量标签" IsChecked="{Binding IncludeQuality}" Margin="0,0,12,6"/>
                    <CheckBox Content="通用标签" IsChecked="{Binding IncludeGeneral}" Margin="0,0,12,6"/>
                    <CheckBox Content="角色标签" IsChecked="{Binding IncludeCharacter}" Margin="0,0,12,6"/>
                    <CheckBox Content="作者标签" IsChecked="{Binding IncludeArtist}" Margin="0,0,12,6"/>
                    <CheckBox Content="版权标签" IsChecked="{Binding IncludeCopyright}" Margin="0,0,12,6"/>
                    <CheckBox Content="元信息标签" IsChecked="{Binding IncludeMeta}" Margin="0,0,12,6"/>
                    <CheckBox Content="模型标签" IsChecked="{Binding IncludeModel}" Margin="0,0,12,6"/>
                </WrapPanel>
            </Grid>
        </GroupBox>

        <GroupBox Header="ToriiGate 配置"
                  Grid.Row="3"
                  Margin="0,0,0,12"
                  Style="{StaticResource CyanGroupBoxStyle}"
                  Visibility="{Binding IsToriiGateTaggerSeries, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="接口地址"
                           Style="{StaticResource CyanFormLabelStyle}"/>
                <TextBox Grid.Column="1"
                         Text="{Binding ToriiGateEndpoint, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsIdle}"
                         Margin="0,0,18,0"/>
                <TextBlock Grid.Column="2"
                           Text="服务端模型名"
                           Style="{StaticResource CyanFormLabelStyle}"/>
                <TextBox Grid.Column="3"
                         Text="{Binding ToriiGateModelName, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsIdle}"/>

                <TextBlock Grid.Row="1"
                           Text="API 令牌（可选）"
                           Style="{StaticResource CyanFormLabelStyle}"
                           Margin="0,10,0,0"/>
                <PasswordBox Grid.Row="1"
                             Grid.Column="1"
                             Grid.ColumnSpan="3"
                             utils:PasswordBoxHelper.BindPassword="True"
                             utils:PasswordBoxHelper.BoundPassword="{Binding ToriiGateApiToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsIdle}"
                             Margin="0,10,0,0"/>

                <TextBlock Grid.Row="2"
                           Text="描述格式"
                           Style="{StaticResource CyanFormLabelStyle}"
                           Margin="0,10,0,0"/>
                <ComboBox Grid.Row="2"
                          Grid.Column="1"
                          ItemsSource="{Binding ToriiGateCaptionFormats}"
                          SelectedValue="{Binding ToriiGateCaptionFormatId}"
                          SelectedValuePath="Id"
                          IsEnabled="{Binding IsIdle}"
                          Margin="0,10,18,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName, Converter={StaticResource LocalizedTextConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Row="2"
                           Grid.Column="2"
                           Text="最大输入 MP"
                           Style="{StaticResource CyanFormLabelStyle}"
                           Margin="0,10,0,0"/>
                <TextBox Grid.Row="2"
                         Grid.Column="3"
                         Text="{Binding ToriiGateMaxMegapixels, UpdateSourceTrigger=LostFocus}"
                         IsEnabled="{Binding IsIdle}"
                         Margin="0,10,0,0"/>

                <WrapPanel Grid.Row="3"
                           Grid.Column="0"
                           Grid.ColumnSpan="4"
                           Margin="0,12,0,0"
                           IsEnabled="{Binding IsIdle}">
                    <TextBlock Text="最大输出 token"
                               Style="{StaticResource CyanFormLabelStyle}"/>
                    <TextBox Text="{Binding ToriiGateMaxTokens, UpdateSourceTrigger=LostFocus}"
                             Width="78"
                             Margin="0,0,16,0"/>
                    <TextBlock Text="Temperature"
                               Style="{StaticResource CyanFormLabelStyle}"/>
                    <TextBox Text="{Binding ToriiGateTemperature, UpdateSourceTrigger=LostFocus}"
                             Width="72"
                             Margin="0,0,16,0"/>
                    <TextBlock Text="并发请求"
                               Style="{StaticResource CyanFormLabelStyle}"/>
                    <TextBox Text="{Binding ToriiGateMaxParallelRequests, UpdateSourceTrigger=LostFocus}"
                             Width="60"
                             Margin="0,0,16,0"/>
                    <TextBlock Text="自定义标签（逗号分隔）"
                               Style="{StaticResource CyanFormLabelStyle}"/>
                    <TextBox Text="{Binding CustomTags, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="160"
                             Margin="0,0,16,0"/>
                    <TextBlock Text="同名 txt"
                               Style="{StaticResource CyanFormLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding ExistingTxtConflictOptions}"
                              SelectedItem="{Binding SelectedExistingTxtConflictOption}"
                              MinWidth="112">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName, Converter={StaticResource LocalizedTextConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </WrapPanel>
            </Grid>
        </GroupBox>

        <GroupBox Header="日志"
                  Grid.Row="4"
                  Margin="0,0,0,12"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <ListBox ItemsSource="{Binding LogLines}"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     HorizontalContentAlignment="Stretch"
                     Style="{StaticResource CyanListBoxSurfaceStyle}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   TextWrapping="NoWrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <GroupBox Header="执行"
                  Grid.Row="5"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Command="{Binding StartTaggingCommand}"
                        IsEnabled="{Binding IsIdle}"
                        Style="{StaticResource CyanPrimaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="PlayCircle24"
                                       Margin="0,0,6,0"/>
                        <TextBlock Text="开始打标"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1"
                        Command="{Binding ClearLogCommand}"
                        IsEnabled="{Binding IsIdle}"
                        Style="{StaticResource CyanCommandButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Broom24"
                                       Margin="0,0,6,0"/>
                        <TextBlock Text="清空日志"/>
                    </StackPanel>
                </Button>
                <ProgressBar Grid.Column="3"
                             Value="{Binding ProgressValue}"
                             Minimum="0"
                             Maximum="100"
                             Height="18"
                             VerticalAlignment="Center"
                             Margin="10,0,0,0"/>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
