<UserControl x:Class="CyanTools.TaggingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CyanTools"
             xmlns:utils="clr-namespace:CyanTools.Utils"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <utils:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" Orientation="Vertical">
            <TextBlock Text="输入路径："/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding InputDirectory, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding HasInheritedInputPath}"
                         Margin="0,0,5,0"
                         VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="..." Command="{Binding BrowseInputCommand}" Padding="10,5"
                        Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
            </Grid>
            <TextBlock Text="管道调度中此输入路径固定为上一个节点的输出路径；如果上一个节点没有输出路径，则沿用其输入路径。"
                       Foreground="Gray" Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,10,0,0">
            <TextBlock Text="打标模型："/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding TaggerModels}"
                          SelectedItem="{Binding SelectedTaggerModel}"
                          DisplayMemberPath="DisplayName"/>
                <Button Grid.Column="1"
                        Content="添加打标器"
                        Command="{Binding AddTaggerCommand}"
                        IsEnabled="{Binding IsIdle}"
                        Padding="10,5"
                        Margin="8,0,0,0"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,10,0,0">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,10,0">
                    <TextBlock Text="自定义标签（逗号分隔）：" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding CustomTags, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Vertical">
                    <TextBlock Text="前置标签（逗号分隔）：" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding PriorityTags, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="当存在同名txt时：" VerticalAlignment="Center"/>
                <ComboBox Width="120"
                          Margin="5,0,15,0"
                          IsEnabled="{Binding IsIdle}"
                          ItemsSource="{Binding ExistingTxtConflictOptions}"
                          SelectedItem="{Binding SelectedExistingTxtConflictOption}"
                          DisplayMemberPath="DisplayName"/>
                <TextBlock Text="通用阈值：" VerticalAlignment="Center"/>
                <TextBox Text="{Binding GeneralThreshold, UpdateSourceTrigger=LostFocus}" Width="50" Margin="5,0" VerticalContentAlignment="Center"/>
                <TextBlock Text="角色阈值：" VerticalAlignment="Center" Margin="15,0,0,0"/>
                <TextBox Text="{Binding CharacterThreshold, UpdateSourceTrigger=LostFocus}" Width="50" Margin="5,0" VerticalContentAlignment="Center"/>
                <Button Content="开始打标" Command="{Binding StartTaggingCommand}" IsEnabled="{Binding IsIdle}" Padding="10,5" Margin="10,0,0,0"/>
                <Button Content="清空日志" Command="{Binding ClearLogCommand}" IsEnabled="{Binding IsIdle}" Padding="10,5" Margin="10,0,0,0"/>
                <Button Content="检查/安装CUDA" Command="{Binding CheckCudaCommand}" IsEnabled="{Binding IsIdle}" Padding="10,5" Margin="10,0,0,0"/>
            </StackPanel>
            <WrapPanel Margin="0,10,0,0" IsEnabled="{Binding IsIdle}">
                <CheckBox Content="优先使用GPU(CUDA)" IsChecked="{Binding PreferGpu}" Margin="0,0,10,5"/>
                <CheckBox Content="评级标签" IsChecked="{Binding IncludeRating}" Margin="0,0,10,5"/>
                <CheckBox Content="质量标签" IsChecked="{Binding IncludeQuality}" Margin="0,0,10,5"/>
                <CheckBox Content="通用标签" IsChecked="{Binding IncludeGeneral}" Margin="0,0,10,5"/>
                <CheckBox Content="角色标签" IsChecked="{Binding IncludeCharacter}" Margin="0,0,10,5"/>
                <CheckBox Content="作者标签" IsChecked="{Binding IncludeArtist}" Margin="0,0,10,5"/>
                <CheckBox Content="版权标签" IsChecked="{Binding IncludeCopyright}" Margin="0,0,10,5"/>
                <CheckBox Content="元信息标签" IsChecked="{Binding IncludeMeta}" Margin="0,0,10,5"/>
                <CheckBox Content="模型标签" IsChecked="{Binding IncludeModel}" Margin="0,0,10,5"/>
            </WrapPanel>
        </StackPanel>

        <ListBox Grid.Row="4" ItemsSource="{Binding LogLines}"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                 BorderThickness="1"
                 HorizontalContentAlignment="Stretch"
                 Margin="0,10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="NoWrap" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ProgressBar Grid.Row="5" Value="{Binding ProgressValue}" Minimum="0" Maximum="100" Height="20"/>

    </Grid>
</UserControl>
