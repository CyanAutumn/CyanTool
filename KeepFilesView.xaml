<UserControl x:Class="CyanTools.KeepFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:utils="clr-namespace:CyanTools.Utils"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <utils:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Style="{StaticResource CyanPageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <GroupBox Header="路径"
                  Grid.Row="0"
                  Margin="0,0,0,12"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="输入路径"
                           Style="{StaticResource CyanFormLabelStyle}" />
                <TextBox Grid.Column="1"
                         Text="{Binding FolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding HasInheritedInputPath}"
                         Margin="0,0,8,0" />
                <Button Grid.Column="2"
                        Command="{Binding SelectFolderCommand}"
                        Style="{StaticResource CyanSmallIconButtonStyle}"
                        ToolTip="选择输入路径"
                        Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                    <ui:SymbolIcon Symbol="FolderOpen24" />
                </Button>

                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Text="管道调度中此输入路径固定为上一个节点的输出路径；如果上一个节点没有输出路径，则沿用其输入路径。"
                           Style="{StaticResource CyanSecondaryTextBlockStyle}"
                           Margin="0,6,0,0"
                           Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </GroupBox>

        <GroupBox Header="保留的文件类型"
                  Grid.Row="1"
                  Margin="0,0,0,12"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <WrapPanel>
                <CheckBox Content="jpg" Margin="0,0,14,8" IsChecked="{Binding KeepJpg}" />
                <CheckBox Content="png" Margin="0,0,14,8" IsChecked="{Binding KeepPng}" />
                <CheckBox Content="webp" Margin="0,0,14,8" IsChecked="{Binding KeepWebp}" />
                <CheckBox Content="bmp" Margin="0,0,14,8" IsChecked="{Binding KeepBmp}" />
                <CheckBox Content="jpeg" Margin="0,0,14,8" IsChecked="{Binding KeepJpeg}" />
                <CheckBox Content="npz" Margin="0,0,14,8" IsChecked="{Binding KeepNpz}" />
                <CheckBox Content="txt" Margin="0,0,14,8" IsChecked="{Binding KeepTxt}" />
                <CheckBox Content=".txt(中文内容)" Margin="0,0,14,8" IsChecked="{Binding KeepChineseTxt}" />
            </WrapPanel>
        </GroupBox>

        <GroupBox Header="执行"
                  Grid.Row="2"
                  Margin="0,0,0,12"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <Button Command="{Binding DeleteFilesCommand}"
                    Style="{StaticResource CyanPrimaryActionButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Delete24"
                                   Margin="0,0,6,0" />
                    <TextBlock Text="删除其他文件" />
                </StackPanel>
            </Button>
        </GroupBox>

        <GroupBox Header="日志"
                  Grid.Row="3"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <TextBox Text="{Binding LogText, Mode=OneWay}"
                     Style="{StaticResource CyanLogTextBoxStyle}" />
        </GroupBox>
    </Grid>
</UserControl>
