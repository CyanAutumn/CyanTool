<UserControl x:Class="CyanTools.KeepFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:utils="clr-namespace:CyanTools.Utils"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             mc:Ignorable="d"
             d:DesignHeight="520"
             d:DesignWidth="860">
    <UserControl.Resources>
        <utils:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Style="{StaticResource CyanPageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CyanCardStyle}"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CyanIconBadgeStyle}"
                        Margin="0,0,14,0">
                    <ui:SymbolIcon Symbol="Delete24"
                                   FontSize="22"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="保留指定文件"
                               Style="{StaticResource CyanSectionTitleStyle}" />
                    <TextBlock Text="按扩展名保留需要的文件类型，其余文件会被清理。"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <GroupBox Grid.Row="1"
                  Header="路径"
                  Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="输入路径"
                           Style="{StaticResource CyanFormLabelStyle}" />
                <TextBox Grid.Column="1"
                         Text="{Binding FolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding HasInheritedInputPath}"
                         Margin="0,0,8,0" />
                <Button Grid.Column="2"
                        Command="{Binding SelectFolderCommand}"
                        Style="{StaticResource CyanSmallIconButtonStyle}"
                        ToolTip="选择输入路径"
                        Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                    <ui:SymbolIcon Symbol="FolderOpen24" />
                </Button>

                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Text="工作流中此输入路径固定为上一个节点的输出路径；如果上一个节点没有输出路径，则沿用其输入路径。"
                           Style="{StaticResource CyanSecondaryTextBlockStyle}"
                           Margin="0,6,0,0"
                           Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </GroupBox>

        <Grid Grid.Row="2"
              Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Header="保留的文件类型">
                <WrapPanel>
                    <CheckBox Content="jpg" Margin="0,0,14,8" IsChecked="{Binding KeepJpg}" />
                    <CheckBox Content="png" Margin="0,0,14,8" IsChecked="{Binding KeepPng}" />
                    <CheckBox Content="webp" Margin="0,0,14,8" IsChecked="{Binding KeepWebp}" />
                    <CheckBox Content="bmp" Margin="0,0,14,8" IsChecked="{Binding KeepBmp}" />
                    <CheckBox Content="jpeg" Margin="0,0,14,8" IsChecked="{Binding KeepJpeg}" />
                    <CheckBox Content="npz" Margin="0,0,14,8" IsChecked="{Binding KeepNpz}" />
                    <CheckBox Content="txt" Margin="0,0,14,8" IsChecked="{Binding KeepTxt}" />
                    <CheckBox Content=".txt(中文内容)" Margin="0,0,14,8" IsChecked="{Binding KeepChineseTxt}" />
                </WrapPanel>
            </GroupBox>

            <Border Grid.Column="2"
                    Style="{StaticResource CyanToolbarSurfaceStyle}"
                    VerticalAlignment="Stretch">
                <Button Command="{Binding DeleteFilesCommand}"
                        Style="{StaticResource CyanPrimaryActionButtonStyle}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Delete24"
                                       Margin="0,0,6,0" />
                        <TextBlock Text="删除其他文件" />
                    </StackPanel>
                </Button>
            </Border>
        </Grid>

        <GroupBox Grid.Row="3"
                  Header="日志">
            <TextBox Text="{Binding LogText, Mode=OneWay}"
                     Style="{StaticResource CyanLogTextBoxStyle}" />
        </GroupBox>
    </Grid>
</UserControl>
