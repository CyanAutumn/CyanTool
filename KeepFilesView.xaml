<UserControl x:Class="CyanTools.KeepFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:utils="clr-namespace:CyanTools.Utils"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <utils:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="输入路径:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Width="400" VerticalAlignment="Center"
                     Text="{Binding FolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding HasInheritedInputPath}"/>
            <Button Content="..." Command="{Binding SelectFolderCommand}" Margin="5,0,0,0"
                    Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
        </StackPanel>
        <TextBlock Grid.Row="1"
                   Text="管道调度中此输入路径固定为上一个节点的输出路径；如果上一个节点没有输出路径，则沿用其输入路径。"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,-4,0,8"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <GroupBox Grid.Row="2" Header="保留的文件类型" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="jpg" Margin="5" IsChecked="{Binding KeepJpg}"/>
                <CheckBox Content="png" Margin="5" IsChecked="{Binding KeepPng}"/>
                <CheckBox Content="webp" Margin="5" IsChecked="{Binding KeepWebp}"/>
                <CheckBox Content="bmp" Margin="5" IsChecked="{Binding KeepBmp}"/>
                <CheckBox Content="jpeg" Margin="5" IsChecked="{Binding KeepJpeg}"/>
                <CheckBox Content="npz" Margin="5" IsChecked="{Binding KeepNpz}"/>
                <CheckBox Content="txt" Margin="5" IsChecked="{Binding KeepTxt}"/>
                <CheckBox Content=".txt(中文内容)" Margin="5" IsChecked="{Binding KeepChineseTxt}"/>
            </StackPanel>
        </GroupBox>

        <Button Grid.Row="3" Content="删除其他文件" Command="{Binding DeleteFilesCommand}"
                HorizontalAlignment="Left" Width="150"/>

        <TextBox Grid.Row="4" Margin="0,10,0,0" TextWrapping="Wrap" IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto" Text="{Binding LogText, Mode=OneWay}" AcceptsReturn="True"/>
    </Grid>
</UserControl>
