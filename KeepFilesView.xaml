<UserControl x:Class="CyanTools.KeepFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="选择文件夹:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Width="400" VerticalAlignment="Center"
                     Text="{Binding FolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="选择..." Command="{Binding SelectFolderCommand}" Margin="5,0,0,0"/>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="保留的文件类型" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="jpg" Margin="5" IsChecked="{Binding KeepJpg}"/>
                <CheckBox Content="png" Margin="5" IsChecked="{Binding KeepPng}"/>
                <CheckBox Content="webp" Margin="5" IsChecked="{Binding KeepWebp}"/>
                <CheckBox Content="bmp" Margin="5" IsChecked="{Binding KeepBmp}"/>
                <CheckBox Content="jpeg" Margin="5" IsChecked="{Binding KeepJpeg}"/>
                <CheckBox Content="npz" Margin="5" IsChecked="{Binding KeepNpz}"/>
                <CheckBox Content="txt" Margin="5" IsChecked="{Binding KeepTxt}"/>
            </StackPanel>
        </GroupBox>

        <Button Grid.Row="2" Content="删除其他文件" Command="{Binding DeleteFilesCommand}"
                HorizontalAlignment="Left" Width="150"/>

        <TextBox Grid.Row="3" Margin="0,10,0,0" TextWrapping="Wrap" IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto" Text="{Binding LogText, Mode=OneWay}" AcceptsReturn="True"/>
    </Grid>
</UserControl>
