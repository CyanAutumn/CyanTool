<UserControl x:Class="CyanTools.PipelineSchedulerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             xmlns:local="clr-namespace:CyanTools"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="900">
    <UserControl.Resources>

        <DataTemplate DataType="{x:Type viewModel:ImageClusteringViewModel}">
            <local:ImageClusteringView DataContext="{Binding}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:RealEsrganPipelineNode}">
            <local:RealEsrganView DataContext="{Binding Inner}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:ImageBucketingPipelineNode}">
            <local:ImageBucketingView DataContext="{Binding Inner}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:ThreeStagePipelineNode}">
            <local:ThreeStageView DataContext="{Binding Inner}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:ResolutionFilterPipelineNode}">
            <local:ResolutionFilterView DataContext="{Binding Inner}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:KeepFilesPipelineNode}">
            <local:KeepFilesView DataContext="{Binding Inner}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:ExportVideoFramePipelineNode}">
            <local:ExportVideoFrameView DataContext="{Binding Inner}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:GaussianBlurPipelineNode}">
            <local:GaussianBlurView DataContext="{Binding Inner}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:ConvertImageFormatPipelineNode}">
            <local:ConvertImageFormatView DataContext="{Binding Inner}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:TaggingPipelineNode}">
            <local:TaggingView DataContext="{Binding Inner}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:TrainingSetBalancerPipelineNode}">
            <local:TrainingSetBalancerView DataContext="{Binding Inner}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:ImageRenamePipelineNode}">
            <local:ImageRenameView DataContext="{Binding Inner}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:DanbooruCrawlerPipelineNode}">
            <local:DanbooruCrawlerView DataContext="{Binding Inner}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:KemonoDownloaderPipelineNode}">
            <local:KemonoDownloaderView DataContext="{Binding Inner}" />
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.DataContext>
        <viewModel:PipelineSchedulerViewModel />
    </UserControl.DataContext>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <GroupBox Header="工作流" Grid.ColumnSpan="3" Margin="5" Grid.Row="0">
            <StackPanel Orientation="Horizontal" Margin="5">
                <ComboBox ItemsSource="{Binding Workflows}"
                          Text="{Binding SelectedWorkflowName, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True"
                          Width="200"
                          Margin="0,0,10,0"/>
                <Button Content="保存" Command="{Binding SaveWorkflowCommand}" Margin="0,0,5,0" Padding="6,2"/>
                <Button Content="删除" Command="{Binding DeleteWorkflowCommand}" Padding="6,2"/>
            </StackPanel>
        </GroupBox>


        <GroupBox Header="可用节点" Grid.Column="0" Margin="5" Grid.Row="1">
            <DockPanel>
                <Button Content="添加节点" Command="{Binding AddNodeCommand}" Margin="0,0,0,5" Padding="6,2" DockPanel.Dock="Bottom"/>
                <ListBox ItemsSource="{Binding AvailableNodes}"
                         SelectedItem="{Binding SelectedAvailableNode}"
                         DisplayMemberPath="DisplayName"/>
            </DockPanel>
        </GroupBox>


        <GroupBox Header="管道" Grid.Column="1" Margin="5" Grid.Row="1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" Margin="0,5,0,0">
                    <Button Content="上移" Command="{Binding MoveUpCommand}" Margin="0,0,5,0" Padding="6,2"/>
                    <Button Content="下移" Command="{Binding MoveDownCommand}" Margin="0,0,5,0" Padding="6,2"/>
                    <Button Content="移除" Command="{Binding RemoveNodeCommand}" Padding="6,2"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding PipelineNodes}"
                         SelectedItem="{Binding SelectedPipelineNode}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </GroupBox>


        <Grid Grid.Column="2" Margin="5" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="180"/>
            </Grid.RowDefinitions>

            <GroupBox Header="节点编辑" Grid.Row="0" Margin="0,0,0,5">
                <Border Padding="5">
                    <ContentControl Content="{Binding SelectedPipelineNode}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{x:Null}"/>
                                <Style.Triggers>
                                    <Trigger Property="Content" Value="{x:Null}">
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <TextBlock Text="请选择一个节点进行编辑" Foreground="Gray" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Border>
            </GroupBox>

            <GroupBox Header="日志" Grid.Row="1">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="5,5,5,0">
                        <Button Content="开始" Command="{Binding StartCommand}" Margin="0,0,5,0" Padding="6,2"/>
                        <Button Content="取消" Command="{Binding CancelCommand}" Margin="0,0,5,0" Padding="6,2"/>
                        <Button Content="清空日志" Command="{Binding ClearLogCommand}" Padding="6,2"/>
                        <TextBlock Text="{Binding IsRunning, StringFormat=运行中: {0}}" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Gray"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="5" DockPanel.Dock="Bottom">
                        <ItemsControl ItemsSource="{Binding LogLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
