<UserControl x:Class="CyanTools.PipelineSchedulerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             xmlns:local="clr-namespace:CyanTools"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:nodify="https://miroiu.github.io/nodify"
             mc:Ignorable="d"
             d:DesignHeight="620"
             d:DesignWidth="1100">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type viewModel:FolderPickerPipelineNode}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="&#x8DEF;&#x5F84;"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,8,0" />
                <TextBox Grid.Column="1"
                         Text="{Binding FolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MinWidth="260"
                         VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Command="{Binding SelectFolderCommand}"
                        Style="{StaticResource CyanSmallIconButtonStyle}"
                        Margin="6,0,0,0"
                        ToolTip="选择路径">
                    <ui:SymbolIcon Symbol="FolderOpen24" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModel:ImageClusteringViewModel}">
            <local:ImageClusteringView DataContext="{Binding}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:RealEsrganPipelineNode}">
            <local:RealEsrganView DataContext="{Binding Inner}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:ImageScalingPipelineNode}">
            <local:ImageScalingView DataContext="{Binding Inner}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:ImageBucketingPipelineNode}">
            <local:ImageBucketingView DataContext="{Binding Inner}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:ThreeStagePipelineNode}">
            <local:ThreeStageView DataContext="{Binding Inner}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:ResolutionFilterPipelineNode}">
            <local:ResolutionFilterView DataContext="{Binding Inner}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:KeepFilesPipelineNode}">
            <local:KeepFilesView DataContext="{Binding Inner}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:FolderProcessingPipelineNode}">
            <local:FolderProcessingView DataContext="{Binding Inner}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:ExportVideoFramePipelineNode}">
            <local:ExportVideoFrameView DataContext="{Binding Inner}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:GaussianBlurPipelineNode}">
            <local:GaussianBlurView DataContext="{Binding Inner}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:ConvertImageFormatPipelineNode}">
            <local:ConvertImageFormatView DataContext="{Binding Inner}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:ConvertTransparentChannelPipelineNode}">
            <local:ConvertTransparentChannelView DataContext="{Binding Inner}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:SameSourceImageGroupingViewModel}">
            <local:SameSourceImageGroupingView DataContext="{Binding}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:TaggingPipelineNode}">
            <local:TaggingView DataContext="{Binding Inner}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:TrainingSetBalancerPipelineNode}">
            <local:TrainingSetBalancerView DataContext="{Binding Inner}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:ImageRenamePipelineNode}">
            <local:ImageRenameView DataContext="{Binding Inner}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:DatasetDownloaderPipelineNode}">
            <local:DanbooruCrawlerView DataContext="{Binding Inner}" />
        </DataTemplate>

        <DataTemplate x:Key="PipelineConnectionTemplate"
                      DataType="{x:Type viewModel:PipelineCanvasConnectionViewModel}">
            <nodify:CircuitConnection Source="{Binding Output.Anchor}"
                                      Target="{Binding Input.Anchor}"
                                      Direction="Forward"
                                      Stroke="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                      StrokeThickness="3" />
        </DataTemplate>

        <DataTemplate x:Key="PendingConnectionTemplate"
                      DataType="{x:Type viewModel:PipelineCanvasPendingConnectionViewModel}">
            <nodify:PendingConnection IsVisible="{Binding IsVisible}"
                                      Source="{Binding Source, Mode=OneWayToSource}"
                                      Target="{Binding Target, Mode=OneWayToSource}"
                                      TargetAnchor="{Binding TargetLocation, Mode=OneWayToSource}"
                                      StartedCommand="{Binding DataContext.StartConnectionCommand, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                      CompletedCommand="{Binding DataContext.CreateConnectionCommand, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}" />
        </DataTemplate>

        <Style x:Key="PipelineItemContainerStyle"
               TargetType="{x:Type nodify:ItemContainer}">
            <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Panel.ZIndex" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Panel.ZIndex" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ConnectorHeaderTemplate"
                      DataType="{x:Type viewModel:PipelineCanvasConnectorViewModel}">
            <TextBlock Text="{Binding Title}"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <Style x:Key="PipelineButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CyanCommandButtonStyle}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </UserControl.Resources>

    <UserControl.DataContext>
        <viewModel:PipelineSchedulerViewModel />
    </UserControl.DataContext>

    <Grid Style="{StaticResource CyanPageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="180" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Style="{StaticResource CyanCardStyle}"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CyanIconBadgeStyle}"
                        Margin="0,0,14,0">
                    <ui:SymbolIcon Symbol="BranchFork24"
                                   FontSize="22"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="管线调度"
                               Style="{StaticResource CyanSectionTitleStyle}" />
                    <TextBlock Text="在节点画布中编排处理流程，保存工作流并查看执行日志。"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <GroupBox Header="工作流"
                  Grid.Row="1"
                  Grid.ColumnSpan="2"
                  Margin="0,0,0,12"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding Workflows}"
                          Text="{Binding SelectedWorkflowName, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True"
                          Margin="0,0,10,0" />
                <Button Grid.Column="1"
                        Command="{Binding SaveWorkflowCommand}"
                        Style="{StaticResource PipelineButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Save24" Margin="0,0,6,0" />
                        <TextBlock Text="保存" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2"
                        Command="{Binding RenameWorkflowCommand}"
                        Style="{StaticResource PipelineButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Edit24" Margin="0,0,6,0" />
                        <TextBlock Text="重命名" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3"
                        Command="{Binding DeleteWorkflowCommand}"
                        Style="{StaticResource PipelineButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Delete24" Margin="0,0,6,0" />
                        <TextBlock Text="删除" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="5"
                        Command="{Binding StartCommand}"
                        Style="{StaticResource CyanPrimaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="PlayCircle24" Margin="0,0,6,0" />
                        <TextBlock Text="开始" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="6"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource PipelineButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="DismissCircle24" Margin="0,0,6,0" />
                        <TextBlock Text="取消" />
                    </StackPanel>
                </Button>
                <Border Grid.Column="8"
                        Style="{StaticResource CyanPillStyle}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Pulse24"
                                       FontSize="14"
                                       Margin="0,0,6,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding IsRunning, StringFormat=运行中: {0}}"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </GroupBox>

        <Border Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,0,0,12"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                Effect="{StaticResource CyanSoftShadowEffect}">
            <nodify:NodifyEditor x:Name="PipelineEditor"
                                 ItemsSource="{Binding CanvasNodes}"
                                 Connections="{Binding CanvasConnections}"
                                 PendingConnection="{Binding PendingConnection}"
                                 PendingConnectionTemplate="{StaticResource PendingConnectionTemplate}"
                                 ConnectionTemplate="{StaticResource PipelineConnectionTemplate}"
                                 ItemContainerStyle="{StaticResource PipelineItemContainerStyle}"
                                 DisconnectConnectorCommand="{Binding DisconnectConnectorCommand}"
                                 GridCellSize="20"
                                 Background="{DynamicResource ControlFillColorSecondaryBrush}">
                <nodify:NodifyEditor.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="添加节点"
                                  ItemsSource="{Binding AvailableNodes}"
                                  Tag="{Binding}">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="{x:Type MenuItem}">
                                    <Setter Property="Header" Value="{Binding DisplayName}" />
                                    <Setter Property="Command" Value="{Binding Tag.AddNodeCommand, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}" />
                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                    </ContextMenu>
                </nodify:NodifyEditor.ContextMenu>

                <nodify:NodifyEditor.InputBindings>
                    <KeyBinding Key="Delete" Command="{Binding RemoveNodeCommand}" />
                </nodify:NodifyEditor.InputBindings>

                <nodify:NodifyEditor.Resources>
                    <Style TargetType="{x:Type nodify:NodeInput}">
                        <Setter Property="Header" Value="{Binding}" />
                        <Setter Property="HeaderTemplate" Value="{StaticResource ConnectorHeaderTemplate}" />
                        <Setter Property="IsConnected" Value="{Binding IsConnected}" />
                        <Setter Property="Anchor" Value="{Binding Anchor, Mode=OneWayToSource}" />
                    </Style>

                    <Style TargetType="{x:Type nodify:NodeOutput}">
                        <Setter Property="Header" Value="{Binding}" />
                        <Setter Property="HeaderTemplate" Value="{StaticResource ConnectorHeaderTemplate}" />
                        <Setter Property="IsConnected" Value="{Binding IsConnected}" />
                        <Setter Property="Anchor" Value="{Binding Anchor, Mode=OneWayToSource}" />
                    </Style>

                    <DataTemplate DataType="{x:Type viewModel:PipelineCanvasNodeViewModel}">
                        <nodify:Node Header="{Binding}"
                                     Input="{Binding Input}"
                                     Output="{Binding Output}"
                                     Content="{Binding}"
                                     MinWidth="440"
                                     MaxWidth="520"
                                     ContentPadding="0"
                                     HeaderBrush="{StaticResource CyanNodeHeaderBrush}"
                                     ContentBrush="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                     Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}">
                            <nodify:Node.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                             Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="删除节点"
                                              Command="{Binding Tag.RemoveNodeCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Delete24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="添加节点"
                                              ItemsSource="{Binding Tag.AvailableNodes, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="AddCircle24" />
                                        </MenuItem.Icon>
                                        <MenuItem.ItemContainerStyle>
                                            <Style TargetType="{x:Type MenuItem}">
                                                <Setter Property="Header" Value="{Binding DisplayName}" />
                                                <Setter Property="Command" Value="{Binding Tag.AddNodeCommand, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}" />
                                                <Setter Property="CommandParameter" Value="{Binding}" />
                                            </Style>
                                        </MenuItem.ItemContainerStyle>
                                    </MenuItem>
                                </ContextMenu>
                            </nodify:Node.ContextMenu>

                            <nodify:Node.HeaderTemplate>
                                <DataTemplate DataType="{x:Type viewModel:PipelineCanvasNodeViewModel}">
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="BranchFork24"
                                                       FontSize="18"
                                                       Foreground="White"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DirectoryBehaviorText}"
                                                       Foreground="{StaticResource CyanNodeHeaderSecondaryBrush}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="2"
                                                  Content="配置"
                                                  Foreground="White"
                                                  IsChecked="{Binding IsExpanded}"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </nodify:Node.HeaderTemplate>

                            <nodify:Node.ContentTemplate>
                                <DataTemplate DataType="{x:Type viewModel:PipelineCanvasNodeViewModel}">
                                    <Grid>
                                        <ScrollViewer MaxHeight="420"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ScrollViewer.Style>
                                                <Style TargetType="ScrollViewer">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ScrollViewer.Style>
                                            <ContentControl Content="{Binding PipelineNode}"
                                                            Margin="8" />
                                        </ScrollViewer>
                                    </Grid>
                                </DataTemplate>
                            </nodify:Node.ContentTemplate>
                        </nodify:Node>
                    </DataTemplate>
                </nodify:NodifyEditor.Resources>
            </nodify:NodifyEditor>
        </Border>

        <GroupBox Header="日志"
                  Grid.Row="3"
                  Grid.ColumnSpan="2"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Style="{StaticResource CyanStatusStripStyle}"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="工作流执行输出"
                                   Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Command="{Binding ClearLogCommand}"
                                Style="{StaticResource PipelineButtonStyle}"
                                Margin="0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Broom24" Margin="0,0,6,0" />
                                <TextBlock Text="清空日志" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                <ListBox ItemsSource="{Binding LogLines}"
                         Style="{StaticResource CyanListBoxSurfaceStyle}"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </GroupBox>
    </Grid>
</UserControl>
