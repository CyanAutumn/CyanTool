<ui:FluentWindow x:Class="CyanTools.AddTaggerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="添加打标器"
        Width="620"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="False"
        WindowBackdropType="None"
        Background="{DynamicResource CyanShellBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Style="{StaticResource CyanDialogRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CyanCardStyle}"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CyanIconBadgeStyle}"
                        Margin="0,0,14,0">
                    <ui:SymbolIcon Symbol="Toolbox24"
                                   FontSize="22"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="添加打标器"
                               Style="{StaticResource CyanSectionTitleStyle}" />
                    <TextBlock Text="选择本地 ONNX 模型和标签映射文件，并配置输入参数。"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource CyanCardStyle}"
                Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="118" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="名称"
                           Style="{StaticResource CyanFormLabelStyle}" />
                <ui:TextBox Grid.Row="0"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10" />

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="模型文件"
                           Style="{StaticResource CyanFormLabelStyle}" />
                <ui:TextBox Grid.Row="1"
                         Grid.Column="1"
                         Text="{Binding LocalModelPath, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,8,10" />
                <ui:Button Grid.Row="1"
                        Grid.Column="2"
                        Style="{StaticResource CyanSmallIconButtonStyle}"
                        Command="{Binding BrowseModelCommand}"
                        ToolTip="浏览模型文件"
                        Margin="0,0,0,10">
                    <ui:SymbolIcon Symbol="FolderOpen24" />
                </ui:Button>

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="标签映射"
                           Style="{StaticResource CyanFormLabelStyle}" />
                <ui:TextBox Grid.Row="2"
                         Grid.Column="1"
                         Text="{Binding LocalTagsPath, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,8,10" />
                <ui:Button Grid.Row="2"
                        Grid.Column="2"
                        Style="{StaticResource CyanSmallIconButtonStyle}"
                        Command="{Binding BrowseTagsCommand}"
                        ToolTip="浏览标签映射文件"
                        Margin="0,0,0,10">
                    <ui:SymbolIcon Symbol="FolderOpen24" />
                </ui:Button>

                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="输入通道"
                           Style="{StaticResource CyanFormLabelStyle}" />
                <ComboBox Grid.Row="3"
                          Grid.Column="1"
                          ItemsSource="{Binding InputFormats}"
                          SelectedItem="{Binding InputFormat}"
                          Width="160"
                          HorizontalAlignment="Left"
                          Margin="0,0,14,0" />
                <Grid Grid.Row="3"
                      Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="86" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="输入尺寸"
                               Style="{StaticResource CyanFormLabelStyle}" />
                    <ui:TextBox Grid.Column="1"
                             Text="{Binding InputSize, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CyanToolbarSurfaceStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Grid.ColumnSpan="4"
                           Text="{Binding StatusMessage, Converter={StaticResource LocalizedTextConverter}}"
                           Style="{StaticResource CyanTinyTextBlockStyle}"
                           Margin="0,0,0,10" />

                <ui:Button Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource CyanCommandButtonStyle}"
                        Command="{Binding AutoDetectCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Sparkle24"
                                       Margin="0,0,6,0" />
                        <TextBlock Text="自动识别" />
                    </StackPanel>
                </ui:Button>

                <ui:Button Grid.Row="1"
                        Grid.Column="2"
                        Style="{StaticResource CyanPrimaryActionButtonStyle}"
                        IsDefault="True"
                        Command="{Binding ConfirmCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24"
                                       Margin="0,0,6,0" />
                        <TextBlock Text="添加" />
                    </StackPanel>
                </ui:Button>

                <ui:Button Grid.Row="1"
                        Grid.Column="3"
                        Style="{StaticResource CyanCommandButtonStyle}"
                        IsCancel="True"
                        Command="{Binding CancelCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Dismiss24"
                                       Margin="0,0,6,0" />
                        <TextBlock Text="取消" />
                    </StackPanel>
                </ui:Button>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
