<Window x:Class="CyanTools.AddTaggerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加打标器"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="名称：" />
            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock Text="模型文件（.onnx）：" />
            <Grid Margin="0,4,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding LocalModelPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                <Button Grid.Column="1" Content="浏览..." Command="{Binding BrowseModelCommand}" Padding="10,5" />
            </Grid>

            <TextBlock Text="标签映射（.csv/.json）：" />
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding LocalTagsPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                <Button Grid.Column="1" Content="浏览..." Command="{Binding BrowseTagsCommand}" Padding="10,5" />
            </Grid>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="输入通道：" />
                <ComboBox ItemsSource="{Binding InputFormats}" SelectedItem="{Binding InputFormat}" Width="120" />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,0">
                <TextBlock Text="输入尺寸：" />
                <TextBox Text="{Binding InputSize, UpdateSourceTrigger=PropertyChanged}" Width="80" />
            </StackPanel>

            <Button Grid.Row="0" Grid.Column="2" Content="自动识别" Command="{Binding AutoDetectCommand}" Padding="10,5" VerticalAlignment="Bottom" />
            <Button Grid.Row="0" Grid.Column="3" Content="添加" Width="90" Margin="12,0,8,0" IsDefault="True" Command="{Binding ConfirmCommand}" VerticalAlignment="Bottom" />
            <Button Grid.Row="0" Grid.Column="4" Content="取消" Width="90" IsCancel="True" Command="{Binding CancelCommand}" VerticalAlignment="Bottom" />

            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6"
                       Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
        </Grid>
    </Grid>
</Window>
