<Window x:Class="CyanTools.ClusterDistributionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="聚类分布图"
        Width="1180"
        Height="820"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="SummaryTextBlock"
                       FontSize="14"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="ImagePathTextBlock"
                       Margin="0,6,0,0"
                       Foreground="#667085"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="#D0D8E3"
                BorderThickness="1"
                CornerRadius="6"
                Background="White">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image x:Name="DistributionImage" Stretch="Uniform" SnapsToDevicePixels="True" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="打开结果目录" Padding="12,6" Margin="0,0,8,0" Click="OpenOutputFolder_Click" />
            <Button Content="关闭" Padding="18,6" IsDefault="True" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
