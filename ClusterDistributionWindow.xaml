<ui:FluentWindow x:Class="CyanTools.ClusterDistributionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="聚类分布图"
        Width="1180"
        Height="820"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="False"
        WindowBackdropType="None"
        Background="{DynamicResource CyanShellBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Style="{StaticResource CyanDialogRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CyanCardStyle}"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CyanIconBadgeStyle}"
                        Margin="0,0,14,0">
                    <ui:SymbolIcon Symbol="BranchFork24"
                                   FontSize="22"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="SummaryTextBlock"
                               Style="{StaticResource CyanSectionTitleStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="ZoomTextBlock"
                               Style="{StaticResource CyanTinyTextBlockStyle}"
                               Margin="0,6,0,0" />
                    <TextBlock x:Name="ImagePathTextBlock"
                               Style="{StaticResource CyanTinyTextBlockStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource CyanImageWellStyle}"
                Padding="10">
            <ScrollViewer x:Name="DistributionScrollViewer"
                          Background="{DynamicResource ControlFillColorDefaultBrush}"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="DistributionScrollViewer_PreviewMouseWheel"
                          PreviewMouseDown="DistributionScrollViewer_PreviewMouseDown"
                          PreviewMouseMove="DistributionScrollViewer_PreviewMouseMove"
                          PreviewMouseUp="DistributionScrollViewer_PreviewMouseUp"
                          LostMouseCapture="DistributionScrollViewer_LostMouseCapture">
                <Image x:Name="DistributionImage"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True" />
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CyanToolbarSurfaceStyle}"
                Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <ui:Button Style="{StaticResource CyanCommandButtonStyle}"
                        Click="OpenOutputFolder_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="FolderOpen24"
                                       Margin="0,0,6,0" />
                        <TextBlock Text="打开结果目录" />
                    </StackPanel>
                </ui:Button>
                <ui:Button Style="{StaticResource CyanPrimaryActionButtonStyle}"
                        IsDefault="True"
                        Click="Close_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24"
                                       Margin="0,0,6,0" />
                        <TextBlock Text="关闭" />
                    </StackPanel>
                </ui:Button>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
