<UserControl x:Class="CyanTools.LayeredLoraMergeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:utils="clr-namespace:CyanTools.Utils"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1100">
    <UserControl.DataContext>
        <viewModel:LayeredLoraMergeViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <utils:BooleanToInverseBooleanConverter x:Key="BooleanToInverseBooleanConverter" />
        <utils:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource CyanPageScrollViewerStyle}">
        <Grid Style="{StaticResource CyanPageGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="260" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource CyanCardStyle}"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CyanIconBadgeStyle}"
                            Margin="0,0,14,0">
                        <ui:SymbolIcon Symbol="Layer24"
                                       FontSize="22"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="LoRA 分层融合"
                                   Style="{StaticResource CyanSectionTitleStyle}" />
                        <TextBlock Text="按 SDXL 25 层、Anima Block 或 Anima 25 层习惯融合 LoRA。"
                                   Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <GroupBox Grid.Row="1"
                      Header="LoRA 路径"
                      Style="{StaticResource CyanGroupBoxStyle}"
                      Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="LoRA A"
                               Style="{StaticResource CyanFormLabelStyle}" />
                    <TextBox Grid.Column="1"
                             Text="{Binding ModelAPath, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,8,0" />
                    <Button Grid.Column="2"
                            Command="{Binding BrowseModelACommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanToInverseBooleanConverter}}"
                            Style="{StaticResource CyanSmallIconButtonStyle}"
                            ToolTip="选择 LoRA A">
                        <ui:SymbolIcon Symbol="FolderOpen24" />
                    </Button>

                    <TextBlock Grid.Row="1"
                               Text="LoRA B"
                               Style="{StaticResource CyanFormLabelStyle}"
                               Margin="0,12,10,0" />
                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             Text="{Binding ModelBPath, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,12,8,0" />
                    <Button Grid.Row="1"
                            Grid.Column="2"
                            Command="{Binding BrowseModelBCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanToInverseBooleanConverter}}"
                            Style="{StaticResource CyanSmallIconButtonStyle}"
                            Margin="0,12,0,0"
                            ToolTip="选择 LoRA B">
                        <ui:SymbolIcon Symbol="FolderOpen24" />
                    </Button>

                    <TextBlock Grid.Row="2"
                               Text="输出 LoRA"
                               Style="{StaticResource CyanFormLabelStyle}"
                               Margin="0,12,10,0" />
                    <TextBox Grid.Row="2"
                             Grid.Column="1"
                             Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,12,8,0" />
                    <Button Grid.Row="2"
                            Grid.Column="2"
                            Command="{Binding BrowseOutputCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanToInverseBooleanConverter}}"
                            Style="{StaticResource CyanSmallIconButtonStyle}"
                            Margin="0,12,0,0"
                            ToolTip="选择输出 LoRA">
                        <ui:SymbolIcon Symbol="Save24" />
                    </Button>
                </Grid>
            </GroupBox>

            <Grid Grid.Row="2"
                  Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0"
                          Header="融合设置"
                          Style="{StaticResource CyanGroupBoxStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="架构"
                                   Style="{StaticResource CyanFormLabelStyle}" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding ArchitectureOptions}"
                                  SelectedItem="{Binding SelectedArchitectureOption}"
                                  Margin="0,0,14,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName, Converter={StaticResource LocalizedTextConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Column="2"
                                   Text="base_alpha"
                                   Style="{StaticResource CyanFormLabelStyle}" />
                        <TextBox Grid.Column="3"
                                 Text="{Binding BaseAlphaText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,14,0" />

                        <StackPanel Grid.Column="4"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left">
                            <Button Command="{Binding UseAllACommand}"
                                    Content="全 A"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanToInverseBooleanConverter}}"
                                    Style="{StaticResource CyanCommandButtonStyle}"
                                    Margin="0,0,8,0" />
                            <Button Command="{Binding UseAllBCommand}"
                                    Content="全 B"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanToInverseBooleanConverter}}"
                                    Style="{StaticResource CyanCommandButtonStyle}"
                                    Margin="0,0,8,0" />
                            <Button Command="{Binding UseBalancedCommand}"
                                    Content="均衡 0.5"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanToInverseBooleanConverter}}"
                                    Style="{StaticResource CyanCommandButtonStyle}"
                                    Margin="0,0,8,0" />
                            <Button Command="{Binding UseReportExampleCommand}"
                                    Content="报告示例"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanToInverseBooleanConverter}}"
                                    Visibility="{Binding IsReportExampleVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Style="{StaticResource CyanCommandButtonStyle}" />
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   Text="{Binding WeightEditorLabel, Converter={StaticResource LocalizedTextConverter}}"
                                   Style="{StaticResource CyanFormLabelStyle}"
                                   Margin="0,16,10,0"
                                   VerticalAlignment="Top" />
                        <Border Grid.Row="1"
                                Grid.Column="1"
                                Grid.ColumnSpan="4"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,12,0,0"
                                Visibility="{Binding IsSdxlWeightEditorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ScrollViewer MaxHeight="360"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding LayerWeights}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="58" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding DisplayName}"
                                                           Style="{StaticResource CyanFormLabelStyle}"
                                                           VerticalAlignment="Center"
                                                           Margin="0" />
                                                <Slider Grid.Column="1"
                                                        Minimum="0"
                                                        Maximum="1"
                                                        SmallChange="0.01"
                                                        LargeChange="0.1"
                                                        TickFrequency="0.01"
                                                        Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        VerticalAlignment="Center"
                                                        Margin="8,0,12,0" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding ValueText}"
                                                           FontFamily="Consolas"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Row="1"
                                Grid.Column="1"
                                Grid.ColumnSpan="4"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,12,0,0"
                                Visibility="{Binding IsAnimaWeightEditorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ScrollViewer MaxHeight="360"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding AnimaBlockWeights}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="58" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding DisplayName}"
                                                           Style="{StaticResource CyanFormLabelStyle}"
                                                           VerticalAlignment="Center"
                                                           Margin="0" />
                                                <Slider Grid.Column="1"
                                                        Minimum="0"
                                                        Maximum="1"
                                                        SmallChange="0.01"
                                                        LargeChange="0.1"
                                                        TickFrequency="0.01"
                                                        Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        VerticalAlignment="Center"
                                                        Margin="8,0,12,0" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding ValueText}"
                                                           FontFamily="Consolas"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Grid.ColumnSpan="4"
                                   Text="{Binding StatusText, Converter={StaticResource LocalizedTextConverter}}"
                                   Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                   Margin="0,8,0,0" />
                    </Grid>
                </GroupBox>

                <Border Grid.Column="2"
                        Style="{StaticResource CyanToolbarSurfaceStyle}"
                        VerticalAlignment="Stretch">
                    <Button Command="{Binding MergeCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanToInverseBooleanConverter}}"
                            Style="{StaticResource CyanPrimaryActionButtonStyle}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowSync24"
                                           Margin="0,0,6,0" />
                            <TextBlock Text="开始融合" />
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>

            <GroupBox Grid.Row="3"
                      Header="融合日志"
                      Style="{StaticResource CyanGroupBoxStyle}">
                <TextBox Text="{Binding LogText, Mode=OneWay}"
                         Style="{StaticResource CyanLogTextBoxStyle}" />
            </GroupBox>
        </Grid>
    </ScrollViewer>
</UserControl>
