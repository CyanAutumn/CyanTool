<UserControl x:Class="CyanTools.TrainingSetManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CyanTools"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             xmlns:model="clr-namespace:CyanTools.Model"
             xmlns:utils="clr-namespace:CyanTools.Utils"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:md="http://schemas.lepo.co/wpfui/2022/xaml/markdown"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1360">
    <UserControl.DataContext>
        <viewModel:TrainingSetManagerViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <utils:BooleanToVisibilityConverter x:Key="TrainingSetBooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Style="{StaticResource CyanPageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="250" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" MinWidth="620" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.ColumnSpan="3"
                Style="{StaticResource CyanToolbarSurfaceStyle}"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="训练集名称"
                         VerticalContentAlignment="Center"
                         Margin="0,0,8,0" />
                <TextBox Grid.Column="1"
                         Text="{Binding ProjectRootPath}"
                         IsReadOnly="True"
                         ToolTip="Git 仓库"
                         VerticalContentAlignment="Center"
                         Margin="0,0,8,0" />
                <Border Grid.Column="2"
                        Style="{StaticResource CyanStatusStripStyle}"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0">
                    <TextBlock Text="{Binding GitStatusText}"
                               FontWeight="SemiBold" />
                </Border>
                <Button Grid.Column="3"
                        Command="{Binding CreateProjectCommand}"
                        Style="{StaticResource CyanCommandButtonStyle}"
                        ToolTip="新建训练集仓库">
                    <ui:SymbolIcon Symbol="AddSquare24" />
                </Button>
                <Button Grid.Column="4"
                        Command="{Binding OpenProjectCommand}"
                        Style="{StaticResource CyanCommandButtonStyle}"
                        ToolTip="打开训练集仓库">
                    <ui:SymbolIcon Symbol="FolderOpen24" />
                </Button>
                <Button Grid.Column="5"
                        Command="{Binding OpenProjectFolderCommand}"
                        Style="{StaticResource CyanCommandButtonStyle}"
                        ToolTip="在资源管理器中打开">
                    <ui:SymbolIcon Symbol="Open24" />
                </Button>
                <Button Grid.Column="6"
                        Command="{Binding RefreshHistoryCommand}"
                        Style="{StaticResource CyanCommandButtonStyle}"
                        ToolTip="刷新 Git 历史">
                    <ui:SymbolIcon Symbol="ArrowClockwise24" />
                </Button>
                <Button Grid.Column="7"
                        Command="{Binding CreateVersionCommand}"
                        Style="{StaticResource CyanCommandButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="BranchForkHint24"
                                       Margin="0,0,6,0" />
                        <TextBlock Text="新版本" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="8"
                        Command="{Binding SaveVersionCommand}"
                        Style="{StaticResource CyanPrimaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Save24"
                                       Margin="0,0,6,0" />
                        <TextBlock Text="提交版本" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>


        <GroupBox Grid.Row="1"
                  Grid.Column="0"
                  Header="Git 版本历史"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top"
                            Margin="0,0,0,10">
                    <Border Style="{StaticResource CyanStatusStripStyle}"
                            Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{Binding StorageAllocationText}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding LfsPolicyText}"
                                       Style="{StaticResource CyanTinyTextBlockStyle}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="从所选 commit 建立分支"
                               Style="{StaticResource CyanFormLabelStyle}"
                               Margin="0,2,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewBranchName, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 ToolTip="留空时自动生成 experiment/... 分支名"
                                 Margin="0,0,6,0" />
                        <Button Grid.Column="1"
                                Command="{Binding CreateBranchFromCommitCommand}"
                                Style="{StaticResource CyanCommandButtonStyle}"
                                ToolTip="从所选 commit 创建并切换分支">
                            <ui:SymbolIcon Symbol="BranchFork24" />
                        </Button>
                    </Grid>
                </StackPanel>

                <ListBox ItemsSource="{Binding HistoryNodes}"
                         Style="{StaticResource CyanListBoxSurfaceStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModel:TrainingSetCommitNodeViewModel}">
                            <Button Command="{Binding SelectCommand}"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="0"
                                    Margin="0,0,0,8"
                                    BorderThickness="0"
                                    Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <Border Width="2"
                                                Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                HorizontalAlignment="Center"
                                                Margin="0,-8,0,-8" />
                                        <TextBlock Text="{Binding GraphSymbol}"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Top"
                                                   Margin="0,10,0,0" />
                                    </Grid>
                                    <Border Grid.Column="1"
                                            Padding="10">
                                        <Border.Style>
                                            <Style TargetType="Border"
                                                   BasedOn="{StaticResource CyanThumbnailCardStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush"
                                                                Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding References}"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ShortHash}"
                                                       Style="{StaticResource CyanTinyTextBlockStyle}"
                                                       Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding AuthorAndDate}"
                                                       Style="{StaticResource CyanTinyTextBlockStyle}"
                                                       Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ParentSummary}"
                                                       Style="{StaticResource CyanTinyTextBlockStyle}"
                                                       Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </GroupBox>

        <GridSplitter Grid.Row="1"
                      Grid.Column="1"
                      Style="{StaticResource CyanGridSplitterStyle}" />

        <TabControl Grid.Row="1"
                    Grid.Column="2">
            <TabItem Header="数据集快照">
                <Grid Margin="2,8,2,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CyanStatusStripStyle}"
                            Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="当前时间点："
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CurrentSnapshotText}" />
                        </StackPanel>
                    </Border>
                    <local:DatasetManagerView Grid.Row="1"
                                              DataContext="{Binding DatasetBrowser}" />
                </Grid>
            </TabItem>

            <TabItem Header="本次训练">
                <Grid Margin="2,8,2,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350" MinWidth="300" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Style="{StaticResource CyanPageScrollViewerStyle}">
                        <StackPanel>
                            <Border Style="{StaticResource CyanImageWellStyle}"
                                    Height="170"
                                    Margin="0,0,0,10">
                                <Grid>
                                    <Image Source="{Binding SelectedNodeCoverImage}"
                                           Stretch="UniformToFill" />
                                    <TextBlock Text="此 commit 尚未设置封面"
                                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Button Command="{Binding SelectVersionCoverCommand}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Margin="8"
                                            Style="{StaticResource CyanCommandButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="ImageEdit24"
                                                           Margin="0,0,6,0" />
                                            <TextBlock Text="commit 封面" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <TextBlock Text="版本标题 / commit message"
                                       Style="{StaticResource CyanFormLabelStyle}" />
                            <TextBox Text="{Binding SelectedNodeTitle, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,10" />
                            <TextBlock Text="版本说明"
                                       Style="{StaticResource CyanFormLabelStyle}" />
                            <TextBox Text="{Binding SelectedNodeDescription, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="64"
                                     Margin="0,4,0,12" />

                            <TextBlock Text="训练配置"
                                       Style="{StaticResource CyanSectionTitleStyle}"
                                       Margin="0,0,0,8" />
                            <Button Command="{Binding ImportConfigCommand}"
                                    Style="{StaticResource CyanCommandButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="DocumentAdd24"
                                                   Margin="0,0,6,0" />
                                    <TextBlock Text="导入配置" />
                                </StackPanel>
                            </Button>
                            <ItemsControl ItemsSource="{Binding SelectedNode.ConfigFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type model:TrainingSetConfigFile}">
                                        <Border Style="{StaticResource CyanParameterRowStyle}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding RelativePath}"
                                                           Style="{StaticResource CyanTinyTextBlockStyle}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="最终训练产物"
                                       Style="{StaticResource CyanSectionTitleStyle}"
                                       Margin="0,14,0,8" />
                            <WrapPanel Margin="0,0,0,8">
                                <Button Command="{Binding AttachModelCommand}"
                                        Style="{StaticResource CyanCommandButtonStyle}"
                                        Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Archive24"
                                                       Margin="0,0,6,0" />
                                        <TextBlock Text="模型" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding AttachOutputImageCommand}"
                                        Style="{StaticResource CyanCommandButtonStyle}"
                                        Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ImageAdd24"
                                                       Margin="0,0,6,0" />
                                        <TextBlock Text="样张" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding AttachTensorBoardLogCommand}"
                                        Style="{StaticResource CyanCommandButtonStyle}"
                                        Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ChartMultiple24"
                                                       Margin="0,0,6,0" />
                                        <TextBlock Text="TensorBoard" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                            <ItemsControl ItemsSource="{Binding SelectedNode.Artifacts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type model:TrainingSetArtifact}">
                                        <Border Style="{StaticResource CyanParameterRowStyle}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Kind}"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                           FontSize="11" />
                                                <TextBlock Text="{Binding RelativePath}"
                                                           Style="{StaticResource CyanTinyTextBlockStyle}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <GridSplitter Grid.Column="1"
                                  Style="{StaticResource CyanGridSplitterStyle}" />

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <WrapPanel Margin="0,0,0,8">
                            <TextBlock Text="commit Markdown 笔记"
                                       Style="{StaticResource CyanSectionTitleStyle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,8" />
                            <Button Command="{Binding InsertVersionNoteHeadingCommand}"
                                    Style="{StaticResource CyanCommandButtonStyle}"
                                    ToolTip="标题"
                                    Margin="0,0,6,8">
                                <ui:SymbolIcon Symbol="TextHeader124" />
                            </Button>
                            <Button Command="{Binding InsertVersionNoteTableCommand}"
                                    Style="{StaticResource CyanCommandButtonStyle}"
                                    ToolTip="表格"
                                    Margin="0,0,6,8">
                                <ui:SymbolIcon Symbol="Table24" />
                            </Button>
                            <Button Command="{Binding InsertVersionNoteChecklistCommand}"
                                    Style="{StaticResource CyanCommandButtonStyle}"
                                    ToolTip="任务列表"
                                    Margin="0,0,6,8">
                                <ui:SymbolIcon Symbol="CheckboxChecked24" />
                            </Button>
                        </WrapPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <GroupBox Header="编辑"
                                      Style="{StaticResource CyanGroupBoxStyle}">
                                <TextBox Text="{Binding NoteEditorText, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         TextWrapping="Wrap"
                                         FontFamily="Consolas" />
                            </GroupBox>
                            <GridSplitter Grid.Column="1"
                                          Style="{StaticResource CyanGridSplitterStyle}" />
                            <GroupBox Grid.Column="2"
                                      Header="预览"
                                      Style="{StaticResource CyanGroupBoxStyle}">
                                <md:MarkdownViewer Markdown="{Binding NoteEditorText}" />
                            </GroupBox>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="训练集资料">
                <Grid Margin="2,8,2,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350" MinWidth="300" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Style="{StaticResource CyanPageScrollViewerStyle}">
                        <StackPanel>
                            <TextBlock Text="以下内容对应整个训练集，不属于单个 commit。"
                                       Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10" />
                            <Border Style="{StaticResource CyanImageWellStyle}"
                                    Height="190"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Image Source="{Binding ProjectCoverImage}"
                                           Stretch="UniformToFill" />
                                    <TextBlock Text="训练集封面"
                                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Button Command="{Binding SelectProjectCoverCommand}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Margin="8"
                                            Style="{StaticResource CyanCommandButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="ImageEdit24"
                                                           Margin="0,0,6,0" />
                                            <TextBlock Text="更换封面" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <TextBlock Text="训练集配置"
                                       Style="{StaticResource CyanSectionTitleStyle}"
                                       Margin="0,0,0,8" />
                            <Button Command="{Binding ImportProjectConfigCommand}"
                                    Style="{StaticResource CyanCommandButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="DocumentAdd24"
                                                   Margin="0,0,6,0" />
                                    <TextBlock Text="导入训练集配置" />
                                </StackPanel>
                            </Button>
                            <ItemsControl ItemsSource="{Binding ProjectConfigFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type model:TrainingSetConfigFile}">
                                        <Border Style="{StaticResource CyanParameterRowStyle}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding RelativePath}"
                                                           Style="{StaticResource CyanTinyTextBlockStyle}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <GridSplitter Grid.Column="1"
                                  Style="{StaticResource CyanGridSplitterStyle}" />

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <WrapPanel Margin="0,0,0,8">
                            <TextBlock Text="训练集 Markdown 笔记"
                                       Style="{StaticResource CyanSectionTitleStyle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,8" />
                            <Button Command="{Binding InsertProjectNoteHeadingCommand}"
                                    Style="{StaticResource CyanCommandButtonStyle}"
                                    ToolTip="标题"
                                    Margin="0,0,6,8">
                                <ui:SymbolIcon Symbol="TextHeader124" />
                            </Button>
                            <Button Command="{Binding InsertProjectNoteTableCommand}"
                                    Style="{StaticResource CyanCommandButtonStyle}"
                                    ToolTip="表格"
                                    Margin="0,0,6,8">
                                <ui:SymbolIcon Symbol="Table24" />
                            </Button>
                            <Button Command="{Binding InsertProjectNoteChecklistCommand}"
                                    Style="{StaticResource CyanCommandButtonStyle}"
                                    ToolTip="任务列表"
                                    Margin="0,0,6,8">
                                <ui:SymbolIcon Symbol="CheckboxChecked24" />
                            </Button>
                        </WrapPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <GroupBox Header="编辑"
                                      Style="{StaticResource CyanGroupBoxStyle}">
                                <TextBox Text="{Binding ProjectNoteEditorText, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         TextWrapping="Wrap"
                                         FontFamily="Consolas" />
                            </GroupBox>
                            <GridSplitter Grid.Column="1"
                                          Style="{StaticResource CyanGridSplitterStyle}" />
                            <GroupBox Grid.Column="2"
                                      Header="预览"
                                      Style="{StaticResource CyanGroupBoxStyle}">
                                <md:MarkdownViewer Markdown="{Binding ProjectNoteEditorText}" />
                            </GroupBox>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="配置对比">
                <DockPanel Margin="2,8,2,2">
                    <Grid DockPanel.Dock="Top"
                          Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding HistoryNodes}"
                                  SelectedItem="{Binding CompareSourceCommit}"
                                  DisplayMemberPath="Title"
                                  Margin="0,0,8,0" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding HistoryNodes}"
                                  SelectedItem="{Binding CompareTargetCommit}"
                                  DisplayMemberPath="Title"
                                  Margin="0,0,8,0" />
                        <Button Grid.Column="2"
                                Grid.RowSpan="2"
                                Command="{Binding CompareCommitsCommand}"
                                Style="{StaticResource CyanPrimaryActionButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DataUsageEdit24"
                                               Margin="0,0,6,0" />
                                <TextBlock Text="仅显示变化" />
                            </StackPanel>
                        </Button>
                        <ComboBox Grid.Row="1"
                                  ItemsSource="{Binding CompareSourceConfigs}"
                                  SelectedItem="{Binding CompareSourceConfig}"
                                  DisplayMemberPath="DisplayName"
                                  Margin="0,8,8,0" />
                        <ComboBox Grid.Row="1"
                                  Grid.Column="1"
                                  ItemsSource="{Binding CompareTargetConfigs}"
                                  SelectedItem="{Binding CompareTargetConfig}"
                                  DisplayMemberPath="DisplayName"
                                  Margin="0,8,8,0" />
                    </Grid>
                    <DataGrid ItemsSource="{Binding ConfigDiffRows}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="类型"
                                                Binding="{Binding Kind}"
                                                Width="90" />
                            <DataGridTextColumn Header="参数"
                                                Binding="{Binding Key}"
                                                Width="*" />
                            <DataGridTextColumn Header="旧值"
                                                Binding="{Binding OldValue}"
                                                Width="*" />
                            <DataGridTextColumn Header="新值"
                                                Binding="{Binding NewValue}"
                                                Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>


        <Border Grid.RowSpan="2"
                Grid.ColumnSpan="3"
                Panel.ZIndex="50"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                MaxWidth="520"
                Margin="18"
                Padding="14,10"
                CornerRadius="10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                Visibility="{Binding IsToastVisible, Converter={StaticResource TrainingSetBooleanToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsToastError}" Value="True">
                            <Setter Property="BorderBrush" Value="#C42B1C" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ToastMessage}"
                       TextWrapping="Wrap"
                       FontWeight="SemiBold" />
        </Border>
    </Grid>
</UserControl>
