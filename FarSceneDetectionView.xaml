<UserControl x:Class="CyanTools.FarSceneDetectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:utils="clr-namespace:CyanTools.Utils">
    <UserControl.Resources>
        <utils:BooleanToInverseBooleanConverter x:Key="MaterialModeEnabled" />
        <utils:BooleanToVisibilityConverter x:Key="MaterialModeVisibility" />
    </UserControl.Resources>
    <Grid Style="{StaticResource CyanPageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <GroupBox Header="远景检测设置" Margin="0,0,0,14" IsEnabled="{Binding IsIdle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="素材目录" Style="{StaticResource CyanFormLabelStyle}" />
                <ui:TextBox Grid.Column="1" Text="{Binding MaterialDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                            IsEnabled="{Binding RelativeSource={RelativeSource Self}, Path=(utils:MaterialClassificationNavigation.IsIndexMode), Converter={StaticResource MaterialModeEnabled}}" />
                <ui:Button Grid.Column="2" Content="..." Command="{Binding BrowseMaterialCommand}" ToolTip="选择素材目录（包含原图文件夹）"
                           IsEnabled="{Binding RelativeSource={RelativeSource Self}, Path=(utils:MaterialClassificationNavigation.IsIndexMode), Converter={StaticResource MaterialModeEnabled}}" />
                <TextBlock Grid.Row="1" Text="输入路径" Style="{StaticResource CyanFormLabelStyle}" Margin="0,10,12,0" />
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding InputPath, Mode=OneWay}" IsReadOnly="True" Margin="0,10,0,0" />
                <TextBlock Grid.Row="2" Text="结果目录" Style="{StaticResource CyanFormLabelStyle}" Margin="0,10,12,0" />
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding OutputPath, Mode=OneWay}" IsReadOnly="True" Margin="0,10,0,0" />
                <TextBlock Grid.Row="3" Text="半身面积阈值（%）" Style="{StaticResource CyanFormLabelStyle}" Margin="0,12,12,0" />
                <ui:TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ThresholdPercent, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="110" HorizontalAlignment="Left" Margin="0,12,0,0" />
                <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Margin="0,12,0,0" TextWrapping="Wrap" Style="{StaticResource CyanSecondaryTextBlockStyle}"
                           Text="复用图片三分法的半身模型。任一半身框占整图面积超过阈值即为近景，其余为远景；未检出半身也归为远景。仅生成索引，不裁切或复制图片。" />
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="1" Header="执行与查看" Margin="0,0,0,14">
            <StackPanel>
                <WrapPanel>
                    <ui:Button Command="{Binding StartCommand}" Style="{StaticResource CyanPrimaryActionButtonStyle}" Margin="0,0,8,8"><TextBlock Text="生成索引" /></ui:Button>
                    <WrapPanel Visibility="{Binding RelativeSource={RelativeSource Self}, Path=(utils:MaterialClassificationNavigation.IsIndexMode), Converter={StaticResource MaterialModeVisibility}, ConverterParameter=Inverse}">
                        <ui:Button Content="查看" Command="{Binding ViewCommand}" Margin="0,0,8,8" />
                        <ui:Button Content="还原" Command="{Binding RestoreCommand}" Margin="0,0,8,8" />
                        <ui:Button Content="取消" Command="{Binding CancelCommand}" Margin="0,0,8,8" />
                    </WrapPanel>
                </WrapPanel>
                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="8" Margin="0,4,0,10" />
                <TextBox Text="{Binding Status, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="140" VerticalScrollBarVisibility="Auto" BorderThickness="0"
                           Visibility="{Binding RelativeSource={RelativeSource Self}, Path=(utils:MaterialClassificationNavigation.IsIndexMode), Converter={StaticResource MaterialModeVisibility}, ConverterParameter=Inverse}" />
                <TextBlock Text="查看会先还原上一分类，再移动图片并打开结果目录；还原会按记录移回原路径。" TextWrapping="Wrap" Style="{StaticResource CyanSecondaryTextBlockStyle}" Margin="0,6,0,0" />
            </StackPanel>
        </GroupBox>
        <GroupBox Grid.Row="2" Header="日志">
            <TextBox Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" />
        </GroupBox>
    </Grid>
</UserControl>
