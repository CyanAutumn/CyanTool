<ui:FluentWindow x:Class="CyanTools.DanbooruManualCollectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Danbooru 正则手动获取"
        Height="760"
        Width="1240"
        MinHeight="620"
        MinWidth="940"
        ExtendsContentIntoTitleBar="False"
        WindowBackdropType="None"
        Background="{DynamicResource CyanShellBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Style="{StaticResource CyanDialogRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CyanCardStyle}"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource CyanIconBadgeStyle}"
                        Width="38"
                        Height="38"
                        Margin="0,0,12,12">
                    <ui:SymbolIcon Symbol="DatabaseSearch24"
                                   FontSize="20"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Row="0"
                            Grid.Column="1"
                            Grid.ColumnSpan="5"
                            Margin="0,0,0,12">
                    <TextBlock Text="Danbooru 正则手动获取"
                               Style="{StaticResource CyanSectionTitleStyle}" />
                    <TextBlock Text="在列表页中键打开帖子标签页，再提取所有帖子 ID 批量下载。"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="URL"
                           Style="{StaticResource CyanFormLabelStyle}" />
                <ui:TextBox Grid.Row="1"
                         Grid.Column="1"
                         x:Name="UrlTextBox"
                         Margin="0,0,8,0" />
                <ui:Button Grid.Row="1"
                        Grid.Column="2"
                        x:Name="OpenButton"
                        Style="{StaticResource CyanCommandButtonStyle}"
                        Click="OnOpenClicked">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="PlayCircle24"
                                       Margin="0,0,6,0" />
                        <TextBlock Text="当前页打开" />
                    </StackPanel>
                </ui:Button>
                <ui:Button Grid.Row="1"
                        Grid.Column="3"
                        x:Name="OpenListButton"
                        Style="{StaticResource CyanCommandButtonStyle}"
                        Click="OnOpenListClicked">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="DocumentSearch24"
                                       Margin="0,0,6,0" />
                        <TextBlock Text="打开列表页" />
                    </StackPanel>
                </ui:Button>
                <ui:Button Grid.Row="1"
                        Grid.Column="4"
                        x:Name="CloseTabButton"
                        Style="{StaticResource CyanCommandButtonStyle}"
                        Click="OnCloseCurrentTabClicked">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Dismiss24"
                                       Margin="0,0,6,0" />
                        <TextBlock Text="关闭当前标签页" />
                    </StackPanel>
                </ui:Button>
                <ui:Button Grid.Row="1"
                        Grid.Column="5"
                        x:Name="ExtractAndDownloadButton"
                        Style="{StaticResource CyanPrimaryActionButtonStyle}"
                        Click="OnExtractAndDownloadClicked">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CloudArrowDown24"
                                       Margin="0,0,6,0" />
                        <TextBlock Text="提取并下载" />
                    </StackPanel>
                </ui:Button>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource CyanStatusStripStyle}"
                Margin="0,0,0,12">
            <TextBlock Text="用法：在列表页中键点击帖子链接打开新标签页，点“提取并下载”会按所有帖子标签页 ID 批量下载。"
                       Style="{StaticResource CyanTinyTextBlockStyle}" />
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CyanImageWellStyle}"
                Padding="0">
            <TabControl x:Name="BrowserTabControl"
                        SelectionChanged="OnBrowserTabSelectionChanged"
                        Background="{DynamicResource ControlFillColorDefaultBrush}" />
        </Border>

        <Border Grid.Row="3"
                Style="{StaticResource CyanToolbarSurfaceStyle}"
                Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="StatusTextBlock"
                           Text="准备就绪"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,12,0" />
                <ui:Button Grid.Column="1"
                        Style="{StaticResource CyanCommandButtonStyle}"
                        Click="OnCancelClicked">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Dismiss24"
                                       Margin="0,0,6,0" />
                        <TextBlock Text="关闭窗口" />
                    </StackPanel>
                </ui:Button>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
