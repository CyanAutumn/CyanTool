<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>bitbug_favicon.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;.tmp/**;**/*-DESKTOP-*;**/*-DESKTOP-*.*;**/*_DESKTOP_*;**/*_DESKTOP_*.*</DefaultItemExcludes>
    <CyanToolsRuntimeIdentifiersToCopy>win-x64;win-x86</CyanToolsRuntimeIdentifiersToCopy>
    <_CyanToolsRuntimeIdentifierFilter>;$(CyanToolsRuntimeIdentifiersToCopy);</_CyanToolsRuntimeIdentifierFilter>
    <WebView2NeverCopyLoaderDllToOutputDirectory>true</WebView2NeverCopyLoaderDllToOutputDirectory>
    <EnableTrainingBackendBootstrapResources>true</EnableTrainingBackendBootstrapResources>

    <Version>1.0.0.15</Version>
    <AssemblyVersion>1.0.0.15</AssemblyVersion>
    <FileVersion>1.0.0.15</FileVersion>
  </PropertyGroup>

  

  <ItemGroup>
    <Folder Include="ViewModel" />
    <Folder Include="Model" />
    <Folder Include="Utils" />
  </ItemGroup>

  <ItemGroup>
    
    
    
    <PackageReference Include="Autoupdater.NET.Official" Version="1.9.2" />
    
    
    
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.14.0" />
    <PackageReference Include="Nodify" Version="7.3.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="Microsoft.ML" Version="4.0.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.28" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="RestSharp" Version="112.1.0" />
    <PackageReference Include="SharpCompress" Version="1.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
    <PackageReference Include="Microsoft.WindowsAPICodePack-Shell" Version="1.1.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.22.0" />
    <PackageReference Include="UMAP" Version="1.0.62830" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="System.Numerics.Tensors" Version="9.0.9" />
    <PackageReference Include="OpenCvSharp4" Version="4.9.0.20240103" />
    <PackageReference Include="OpenCvSharp4.WpfExtensions" Version="4.9.0.20240103" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.9.0.20240103" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="realesrgan-ncnn-vulkan-20220424-windows\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
        <Content Include="waifu2x-caffe\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Models\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="scripts\*.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="dist\runtime-tools\**\*"
             Condition="'$(EnableTrainingBackendBootstrapResources)' == 'true' and Exists('dist\runtime-tools')">
      <Link>runtime-tools\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="dist\managed-root-seed\**\*"
             Condition="'$(EnableTrainingBackendBootstrapResources)' == 'true' and Exists('dist\managed-root-seed')">
      <Link>managed-root-seed\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="dist\offline-wheelhouse\**\*"
             Condition="'$(EnableTrainingBackendBootstrapResources)' == 'true' and Exists('dist\offline-wheelhouse')">
      <Link>offline-wheelhouse\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="dist\uv-cache\**\*"
             Condition="'$(EnableTrainingBackendBootstrapResources)' == 'true' and Exists('dist\uv-cache')">
      <Link>uv-cache\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="**\*-DESKTOP-*.cs;**\*_DESKTOP_*.cs" />
    <ApplicationDefinition Remove="**\*-DESKTOP-*.xaml;**\*_DESKTOP_*.xaml" />
    <Page Remove="**\*-DESKTOP-*.xaml;**\*_DESKTOP_*.xaml" />
    <None Remove="**\*-DESKTOP-*;**\*-DESKTOP-*.*;**\*_DESKTOP_*;**\*_DESKTOP_*.*" />
    <Content Remove="**\*-DESKTOP-*;**\*-DESKTOP-*.*;**\*_DESKTOP_*;**\*_DESKTOP_*.*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="bitbug_favicon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="1.png" />
    <Resource Include="da715a4e-51a3-4430-833b-a4e5f2a804a9.png" />
  </ItemGroup>

  <PropertyGroup>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <Target Name="FilterPackageRuntimeCopyLocalItems"
          AfterTargets="ResolvePackageAssets"
          BeforeTargets="ResolveLockFileCopyLocalFiles">
    <ItemGroup>
      <_CyanToolsPackageRuntimeCopyLocalItemsToRemove Include="@(RuntimeTargetsCopyLocalItems)"
                                                       Condition="'%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' != '' and !$([System.String]::Copy('$(_CyanToolsRuntimeIdentifierFilter)').Contains(';%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier);'))" />
      <RuntimeTargetsCopyLocalItems Remove="@(_CyanToolsPackageRuntimeCopyLocalItemsToRemove)" />
    </ItemGroup>
  </Target>

</Project>
