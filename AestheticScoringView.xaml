<UserControl x:Class="CyanTools.AestheticScoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:utils="clr-namespace:CyanTools.Utils"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <utils:BooleanToInverseBooleanConverter x:Key="MaterialModeEnabled" />
        <utils:BooleanToVisibilityConverter x:Key="MaterialModeVisibility" />
        <Style x:Key="AestheticCellText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="{Binding ImagePath}" />
        </Style>
        <Style x:Key="AestheticErrorText" TargetType="TextBlock" BasedOn="{StaticResource AestheticCellText}">
            <Setter Property="ToolTip" Value="{Binding Error}" />
        </Style>
    </UserControl.Resources>
    <Grid Style="{StaticResource CyanPageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" MaxHeight="430" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="140" />
            <RowDefinition Height="100" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel IsEnabled="{Binding IsIdle}">
                <GroupBox Header="美学评分模型" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="DeepGHS · SwinV2 · 448 × 448" Style="{StaticResource CyanSectionTitleStyle}" />
                        <TextBlock Grid.Row="1" Text="{Binding ModelStatus, Converter={StaticResource LocalizedTextConverter}}" Margin="0,4,0,8" />
                        <ui:Button Grid.Column="1" Grid.RowSpan="2" Command="{Binding DownloadCommand}" Margin="12,0,0,8"><TextBlock Text="下载 / 修复模型" /></ui:Button>
                        <ui:TextBox Grid.Row="2" Text="{Binding ModelDirectory, UpdateSourceTrigger=PropertyChanged}" ToolTip="模型目录（包含 model.onnx、meta.json 和 samples.npz）" />
                        <ui:Button Grid.Row="2" Grid.Column="1" Command="{Binding SelectModelCommand}" Margin="12,0,0,0"><TextBlock Text="选择模型目录" /></ui:Button>
                    </Grid>
                </GroupBox>
                <GroupBox Header="评分设置" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="输入路径" Style="{StaticResource CyanFormLabelStyle}" />
                        <ui:TextBox IsEnabled="{Binding RelativeSource={RelativeSource Self}, Path=(utils:MaterialClassificationNavigation.IsIndexMode), Converter={StaticResource MaterialModeEnabled}}" Grid.Column="1" Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                            <ui:Button IsEnabled="{Binding RelativeSource={RelativeSource Self}, Path=(utils:MaterialClassificationNavigation.IsIndexMode), Converter={StaticResource MaterialModeEnabled}}" Command="{Binding SelectImageCommand}" Margin="0,0,8,0"><TextBlock Text="选择图片" /></ui:Button>
                            <ui:Button IsEnabled="{Binding RelativeSource={RelativeSource Self}, Path=(utils:MaterialClassificationNavigation.IsIndexMode), Converter={StaticResource MaterialModeEnabled}}" Command="{Binding SelectFolderCommand}"><TextBlock Text="选择文件夹" /></ui:Button>
                        </StackPanel>
                        <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,10">
                            <CheckBox Content="包含子文件夹" IsEnabled="{Binding RelativeSource={RelativeSource Self}, Path=(utils:MaterialClassificationNavigation.IsIndexMode), Converter={StaticResource MaterialModeEnabled}}" IsChecked="{Binding Recursive}" Margin="0,0,16,6" />
                            <CheckBox Content="使用 GPU" IsChecked="{Binding UseGpu}" Margin="0,0,16,6" />
                            <CheckBox Content="下载使用代理设置" IsChecked="{Binding UseProxy}" Margin="0,0,0,6" />
                        </WrapPanel>
                        <TextBlock Grid.Row="2" Text="输出路径" Style="{StaticResource CyanFormLabelStyle}" />
                        <ui:TextBox IsEnabled="{Binding RelativeSource={RelativeSource Self}, Path=(utils:MaterialClassificationNavigation.IsIndexMode), Converter={StaticResource MaterialModeEnabled}}" Grid.Row="2" Grid.Column="1" Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button IsEnabled="{Binding RelativeSource={RelativeSource Self}, Path=(utils:MaterialClassificationNavigation.IsIndexMode), Converter={StaticResource MaterialModeEnabled}}" Grid.Row="2" Grid.Column="2" Command="{Binding SelectOutputCommand}" Margin="8,0,0,0"><TextBlock Text="选择输出路径" /></ui:Button>
                        <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Margin="0,8,0,0" Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                   Text="按 DeepGHS 百分位确定等级，自动复制图片与同名标签并保留原图。输出包含全部七个等级。模型与校准数据首次下载约 419 MiB。" Visibility="{Binding RelativeSource={RelativeSource Self}, Path=(utils:MaterialClassificationNavigation.IsIndexMode), Converter={StaticResource MaterialModeVisibility}, ConverterParameter=Inverse}" />
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Style="{StaticResource CyanCardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <WrapPanel>
                    <ui:Button Command="{Binding StartCommand}" Style="{StaticResource CyanPrimaryActionButtonStyle}" Margin="0,0,8,6"><TextBlock><TextBlock.Style><Style TargetType="TextBlock">
                            <Setter Property="Text" Value="开始评分" />
                            <Style.Triggers><Trigger Property="utils:MaterialClassificationNavigation.IsIndexMode" Value="True">
                                <Setter Property="Text" Value="生成索引" />
                            </Trigger></Style.Triggers>
                        </Style></TextBlock.Style></TextBlock></ui:Button>
                    <ui:Button Command="{Binding CancelCommand}" Margin="0,0,8,6"><TextBlock Text="取消" /></ui:Button>
                    <ui:Button Command="{Binding ExportCommand}" Margin="0,0,8,6"><TextBlock Text="导出评分结果" /></ui:Button>
                    <ui:Button Command="{Binding OpenOutputCommand}" Margin="0,0,8,6"><TextBlock Text="打开输出目录" /></ui:Button>
                    <ui:Button Command="{Binding OpenImageCommand}" Margin="0,0,0,6"><TextBlock Text="打开选中图片" /></ui:Button>
                </WrapPanel>
                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="5" Margin="0,6,0,8" />
                <TextBlock Text="{Binding Status, Converter={StaticResource LocalizedTextConverter}}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <ui:DataGrid Grid.Row="2" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}"
                     IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True"
                     SelectionMode="Single" RowHeight="40" Margin="0,0,0,10" ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ui:DataGrid.Columns>
                <DataGridTextColumn ElementStyle="{StaticResource AestheticCellText}" Binding="{Binding FileName}" Width="2*" MinWidth="120"><DataGridTextColumn.Header><TextBlock Text="文件名" /></DataGridTextColumn.Header></DataGridTextColumn>
                <DataGridTextColumn ElementStyle="{StaticResource AestheticCellText}" Binding="{Binding Label}" Width="105"><DataGridTextColumn.Header><TextBlock Text="等级" /></DataGridTextColumn.Header></DataGridTextColumn>
                <DataGridTextColumn ElementStyle="{StaticResource AestheticCellText}" Binding="{Binding Score, StringFormat=F2}" Width="120"><DataGridTextColumn.Header><TextBlock Text="评分（0～6）" /></DataGridTextColumn.Header></DataGridTextColumn>
                <DataGridTextColumn ElementStyle="{StaticResource AestheticCellText}" Binding="{Binding Percentile, StringFormat=P1}" Width="110"><DataGridTextColumn.Header><TextBlock Text="百分位" /></DataGridTextColumn.Header></DataGridTextColumn>
                <DataGridTextColumn ElementStyle="{StaticResource AestheticCellText}" Binding="{Binding Confidence, StringFormat=P1}" Width="130"><DataGridTextColumn.Header><TextBlock Text="最高类别概率" /></DataGridTextColumn.Header></DataGridTextColumn>
                <DataGridTextColumn ElementStyle="{StaticResource AestheticCellText}" Binding="{Binding OutputPath}" Width="2*" MinWidth="120"><DataGridTextColumn.Header><TextBlock Text="输出路径" /></DataGridTextColumn.Header></DataGridTextColumn>
                <DataGridTextColumn ElementStyle="{StaticResource AestheticErrorText}" Binding="{Binding Error}" Width="2*" MinWidth="100"><DataGridTextColumn.Header><TextBlock Text="错误信息" /></DataGridTextColumn.Header></DataGridTextColumn>
            </ui:DataGrid.Columns>
        </ui:DataGrid>
        <ui:TextBox Grid.Row="3" Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                    TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="运行日志" />
    </Grid>
</UserControl>
