<UserControl x:Class="CyanTools.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="640"
             d:DesignWidth="960"
             Background="Transparent">
    <ScrollViewer Style="{StaticResource CyanPageScrollViewerStyle}">
        <Grid Style="{StaticResource CyanPageGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource CyanHeroPanelStyle}"
                    Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="230" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Style="{StaticResource CyanPillStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Sparkle24"
                                               FontSize="14"
                                               Margin="0,0,6,0"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Modernized with WPF UI"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="1"
                                   Text="Cyan Tools"
                                   Style="{StaticResource CyanPageTitleStyle}" />
                        <TextBlock Grid.Row="2"
                                   Text="本地图片、数据集、标签与训练准备的一站式工作台"
                                   Style="{StaticResource CyanPageSubtitleStyle}"
                                   Margin="2,8,0,0" />

                        <Grid Grid.Row="3"
                              Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource CyanPillStyle}"
                                    Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ImageMultiple24"
                                                   FontSize="15"
                                                   Margin="0,0,6,0"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="图像批处理"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1"
                                    Style="{StaticResource CyanPillStyle}"
                                    Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="DatabaseSearch24"
                                                   FontSize="15"
                                                   Margin="0,0,6,0"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="数据集管理"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2"
                                    Style="{StaticResource CyanPillStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="BranchFork24"
                                                   FontSize="15"
                                                   Margin="0,0,6,0"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="管道调度"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid Grid.Column="1"
                          Margin="28,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource CyanImageWellStyle}"
                                Width="206"
                                Height="206"
                                HorizontalAlignment="Right">
                            <Grid>
                                <Image x:Name="SecretImage"
                                       Source="/1.png"
                                       Stretch="UniformToFill"
                                       Cursor="Hand"
                                       MouseDown="SecretImage_MouseDown" />
                                <Border VerticalAlignment="Bottom"
                                        Background="#AA000000"
                                        Padding="10,6">
                                    <TextBlock Text="Cyan Core"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1"
                                HorizontalAlignment="Right"
                                Style="{StaticResource CyanPillStyle}"
                                Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="WeatherSunny24"
                                               FontSize="14"
                                               Margin="0,0,6,0"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="支持白天 / 夜间"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CyanFeatureCardStyle}"
                        Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource CyanIconBadgeStyle}">
                            <ui:SymbolIcon Symbol="ImageSparkle24"
                                           FontSize="22"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Row="1"
                                   Text="图片增强"
                                   Style="{StaticResource CyanSectionTitleStyle}"
                                   Margin="0,14,0,6" />
                        <TextBlock Grid.Row="2"
                                   Text="超分、缩放、格式转换、透明通道处理"
                                   Style="{StaticResource CyanSecondaryTextBlockStyle}" />
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource CyanFeatureCardStyle}"
                        Margin="6,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource CyanIconBadgeStyle}">
                            <ui:SymbolIcon Symbol="DatabaseCheckmark24"
                                           FontSize="22"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Row="1"
                                   Text="数据集"
                                   Style="{StaticResource CyanSectionTitleStyle}"
                                   Margin="0,14,0,6" />
                        <TextBlock Grid.Row="2"
                                   Text="下载、整理、打标、Prompt 文件管理"
                                   Style="{StaticResource CyanSecondaryTextBlockStyle}" />
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource CyanFeatureCardStyle}"
                        Margin="6,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource CyanIconBadgeStyle}">
                            <ui:SymbolIcon Symbol="BranchForkHint24"
                                           FontSize="22"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Row="1"
                                   Text="自动化"
                                   Style="{StaticResource CyanSectionTitleStyle}"
                                   Margin="0,14,0,6" />
                        <TextBlock Grid.Row="2"
                                   Text="节点管道、执行顺序、日志追踪"
                                   Style="{StaticResource CyanSecondaryTextBlockStyle}" />
                    </Grid>
                </Border>

                <Border Grid.Column="3"
                        Style="{StaticResource CyanFeatureCardStyle}"
                        Margin="10,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource CyanIconBadgeStyle}">
                            <ui:SymbolIcon Symbol="Bot24"
                                           FontSize="22"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Row="1"
                                   Text="AI 辅助"
                                   Style="{StaticResource CyanSectionTitleStyle}"
                                   Margin="0,14,0,6" />
                        <TextBlock Grid.Row="2"
                                   Text="Gemini 图像生成与 LLM 工具联动"
                                   Style="{StaticResource CyanSecondaryTextBlockStyle}" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Style="{StaticResource CyanCardStyle}"
                    Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="工作流方向"
                                   Style="{StaticResource CyanSectionTitleStyle}"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="从输入目录到输出目录，各工具可被管道串联，减少重复点选。"
                                   Style="{StaticResource CyanSecondaryTextBlockStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="18,0">
                        <TextBlock Text="视觉状态"
                                   Style="{StaticResource CyanSectionTitleStyle}"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="白天模式更清爽，夜间模式压低亮度，长时间整理图片时更舒服。"
                                   Style="{StaticResource CyanSecondaryTextBlockStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Margin="18,0,0,0">
                        <TextBlock Text="本地优先"
                                   Style="{StaticResource CyanSectionTitleStyle}"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="核心处理仍在本地完成，界面升级不改变原有处理逻辑。"
                                   Style="{StaticResource CyanSecondaryTextBlockStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Style="{StaticResource CyanCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Height="4"
                            CornerRadius="2"
                            Background="{StaticResource CyanAccentRailBrush}"
                            Margin="0,0,0,18" />

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.95*" />
                            <ColumnDefinition Width="1.55*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="免责声明"
                                       Style="{StaticResource CyanSectionTitleStyle}"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="本工具仅供学习与研究使用，使用过程中产生的任何后果均由使用者自行承担，与作者无关。"
                                       Style="{StaticResource CyanSecondaryTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="鸣谢"
                                       Style="{StaticResource CyanSectionTitleStyle}"
                                       Margin="0,0,0,8" />

                            <TextBlock Margin="0,4">
                                <Hyperlink NavigateUri="https://space.bilibili.com/14695635"
                                           RequestNavigate="Hyperlink_RequestNavigate">今宵</Hyperlink>
                                <Run Text=" - 视频教程制作与分辨率归类思路" />
                            </TextBlock>
                            <TextBlock Margin="0,4">
                                <Hyperlink NavigateUri="https://huggingface.co/SmilingWolf"
                                           RequestNavigate="Hyperlink_RequestNavigate">SmilingWolf</Hyperlink>
                                <Run Text=" - 打标模型来源" />
                            </TextBlock>
                            <TextBlock Margin="0,4">
                                <Hyperlink NavigateUri="https://huggingface.co/deepghs"
                                           RequestNavigate="Hyperlink_RequestNavigate">DeepGHS</Hyperlink>
                                <Run Text=" - 图片三分法与打标模型来源" />
                            </TextBlock>
                            <TextBlock Margin="0,4">
                                <Hyperlink NavigateUri="https://github.com/lltcggie/waifu2x-caffe"
                                           RequestNavigate="Hyperlink_RequestNavigate">lltcggie / waifu2x-caffe</Hyperlink>
                                <Run Text=" - 图片放大项目" />
                            </TextBlock>
                            <TextBlock Margin="0,4">
                                <Hyperlink NavigateUri="https://github.com/xinntao/Real-ESRGAN-ncnn-vulkan"
                                           RequestNavigate="Hyperlink_RequestNavigate">xinntao / Real-ESRGAN-ncnn-vulkan</Hyperlink>
                                <Run Text=" - 图片超分项目" />
                            </TextBlock>
                            <TextBlock Margin="0,4">
                                <Hyperlink NavigateUri="https://huggingface.co/yuxi-liu-wired/CSD/tree/main/CSD"
                                           RequestNavigate="Hyperlink_RequestNavigate">yuxi-liu-wired / CSD</Hyperlink>
                                <Run Text=" - 图片聚类模型来源" />
                            </TextBlock>
                            <TextBlock Margin="0,4">
                                <Hyperlink NavigateUri="https://www.pixiv.net/users/84376185"
                                           RequestNavigate="Hyperlink_RequestNavigate">Rnglg2</Hyperlink>
                                <Run Text=" - 高斯模糊反下毒思路" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
