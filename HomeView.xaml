<UserControl x:Class="CyanTools.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="640"
             d:DesignWidth="960"
             Background="Transparent">
    <ScrollViewer Style="{StaticResource CyanPageScrollViewerStyle}">
        <Grid Style="{StaticResource CyanPageGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource CyanHeroPanelStyle}"
                    Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Cyan Tools"
                                   Style="{StaticResource CyanPageTitleStyle}" />
                        <TextBlock Text="本地图片、数据集和训练准备工作台"
                                   Style="{StaticResource CyanPageSubtitleStyle}"
                                   Margin="2,8,0,0" />

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource CyanIconBadgeStyle}"
                                    Margin="0,0,10,0">
                                <ui:SymbolIcon Symbol="ImageSparkle24"
                                               FontSize="20"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                            </Border>
                            <Border Grid.Column="1"
                                    Style="{StaticResource CyanIconBadgeStyle}"
                                    Margin="0,0,10,0">
                                <ui:SymbolIcon Symbol="DatabaseCheckmark24"
                                               FontSize="20"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                            </Border>
                            <Border Grid.Column="2"
                                    Style="{StaticResource CyanIconBadgeStyle}">
                                <ui:SymbolIcon Symbol="BranchForkHint24"
                                               FontSize="20"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Width="184"
                            Height="184"
                            Margin="28,0,0,0"
                            Style="{StaticResource CyanImageWellStyle}">
                        <Image x:Name="SecretImage"
                               Source="/1.png"
                               Stretch="UniformToFill"
                               Cursor="Hand"
                               MouseDown="SecretImage_MouseDown" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CyanCardStyle}"
                        Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:SymbolIcon Symbol="ImageMultiple24"
                                       FontSize="28"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Grid.Row="1"
                                   Text="图片处理"
                                   Style="{StaticResource CyanSectionTitleStyle}"
                                   Margin="0,14,0,6" />
                        <TextBlock Grid.Row="2"
                                   Text="缩放、超分、转换、筛选与批处理"
                                   Style="{StaticResource CyanSecondaryTextBlockStyle}" />
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource CyanCardStyle}"
                        Margin="10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:SymbolIcon Symbol="DatabaseSearch24"
                                       FontSize="28"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Grid.Row="1"
                                   Text="数据集工作流"
                                   Style="{StaticResource CyanSectionTitleStyle}"
                                   Margin="0,14,0,6" />
                        <TextBlock Grid.Row="2"
                                   Text="图片、标签、Prompt 与下载流程"
                                   Style="{StaticResource CyanSecondaryTextBlockStyle}" />
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource CyanCardStyle}"
                        Margin="10,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:SymbolIcon Symbol="BranchFork24"
                                       FontSize="28"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Grid.Row="1"
                                   Text="管道调度"
                                   Style="{StaticResource CyanSectionTitleStyle}"
                                   Margin="0,14,0,6" />
                        <TextBlock Grid.Row="2"
                                   Text="节点画布与自动化执行编排"
                                   Style="{StaticResource CyanSecondaryTextBlockStyle}" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Style="{StaticResource CyanCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Height="4"
                            CornerRadius="2"
                            Background="{StaticResource CyanAccentRailBrush}"
                            Margin="0,0,0,18" />

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="免责声明"
                                       Style="{StaticResource CyanSectionTitleStyle}"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="本工具仅供学习与研究使用，使用过程中产生的任何后果均由使用者自行承担，与作者无关。"
                                       Style="{StaticResource CyanSecondaryTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="鸣谢"
                                       Style="{StaticResource CyanSectionTitleStyle}"
                                       Margin="0,0,0,8" />

                            <TextBlock Margin="0,4">
                                <Hyperlink NavigateUri="https://space.bilibili.com/14695635"
                                           RequestNavigate="Hyperlink_RequestNavigate">
                                    今宵
                                </Hyperlink>
                                <Run Text=" - 视频教程制作与分辨率归类思路" />
                            </TextBlock>
                            <TextBlock Margin="0,4">
                                <Hyperlink NavigateUri="https://huggingface.co/SmilingWolf"
                                           RequestNavigate="Hyperlink_RequestNavigate">
                                    SmilingWolf
                                </Hyperlink>
                                <Run Text=" - 打标模型来源" />
                            </TextBlock>
                            <TextBlock Margin="0,4">
                                <Hyperlink NavigateUri="https://huggingface.co/deepghs"
                                           RequestNavigate="Hyperlink_RequestNavigate">
                                    DeepGHS
                                </Hyperlink>
                                <Run Text=" - 图片三分法与打标模型来源" />
                            </TextBlock>
                            <TextBlock Margin="0,4">
                                <Hyperlink NavigateUri="https://github.com/lltcggie/waifu2x-caffe"
                                           RequestNavigate="Hyperlink_RequestNavigate">
                                    lltcggie / waifu2x-caffe
                                </Hyperlink>
                                <Run Text=" - 图片放大项目" />
                            </TextBlock>
                            <TextBlock Margin="0,4">
                                <Hyperlink NavigateUri="https://github.com/xinntao/Real-ESRGAN-ncnn-vulkan"
                                           RequestNavigate="Hyperlink_RequestNavigate">
                                    xinntao / Real-ESRGAN-ncnn-vulkan
                                </Hyperlink>
                                <Run Text=" - 图片超分项目" />
                            </TextBlock>
                            <TextBlock Margin="0,4">
                                <Hyperlink NavigateUri="https://huggingface.co/yuxi-liu-wired/CSD/tree/main/CSD"
                                           RequestNavigate="Hyperlink_RequestNavigate">
                                    yuxi-liu-wired / CSD
                                </Hyperlink>
                                <Run Text=" - 图片聚类模型来源" />
                            </TextBlock>
                            <TextBlock Margin="0,4">
                                <Hyperlink NavigateUri="https://www.pixiv.net/users/84376185"
                                           RequestNavigate="Hyperlink_RequestNavigate">
                                    Rnglg2
                                </Hyperlink>
                                <Run Text=" - 高斯模糊反下毒思路" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
