<UserControl x:Class="CyanTools.ResolutionFilterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:CyanTools"
             xmlns:utils="clr-namespace:CyanTools.Utils"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <utils:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Style="{StaticResource CyanPageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <GroupBox Header="路径"
                  Grid.Row="0"
                  Margin="0,0,0,12"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="输入路径"
                           Style="{StaticResource CyanFormLabelStyle}" />
                <TextBox Grid.Column="1"
                         Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding HasInheritedInputPath}"
                         Margin="0,0,8,0" />
                <Button Grid.Column="2"
                        Command="{Binding BrowseInputCommand}"
                        Style="{StaticResource CyanSmallIconButtonStyle}"
                        ToolTip="选择输入路径"
                        Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                    <ui:SymbolIcon Symbol="FolderOpen24" />
                </Button>

                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Text="管道调度中此输入路径固定为上一个节点的输出路径；如果上一个节点没有输出路径，则沿用其输入路径。"
                           Style="{StaticResource CyanSecondaryTextBlockStyle}"
                           Margin="0,6,0,0"
                           Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </GroupBox>

        <GroupBox Header="筛选条件"
                  Grid.Row="1"
                  Margin="0,0,0,12"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Content="删除指定高度以下的图片"
                              IsChecked="{Binding IsHeightFilterEnabled}" />
                    <TextBlock Grid.Column="1"
                               Text="最小高度"
                               Style="{StaticResource CyanFormLabelStyle}"
                               IsEnabled="{Binding IsHeightFilterEnabled}" />
                    <TextBox Grid.Column="2"
                             Text="{Binding MinHeight}"
                             IsEnabled="{Binding IsHeightFilterEnabled}" />
                </Grid>

                <Grid Grid.Row="1"
                      Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Content="删除指定宽度以下的图片"
                              IsChecked="{Binding IsWidthFilterEnabled}" />
                    <TextBlock Grid.Column="1"
                               Text="最小宽度"
                               Style="{StaticResource CyanFormLabelStyle}"
                               IsEnabled="{Binding IsWidthFilterEnabled}" />
                    <TextBox Grid.Column="2"
                             Text="{Binding MinWidth}"
                             IsEnabled="{Binding IsWidthFilterEnabled}" />
                </Grid>

                <Grid Grid.Row="2"
                      Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Content="删除指定分辨率以下的图片"
                              IsChecked="{Binding IsResolutionFilterEnabled}" />
                    <TextBlock Grid.Column="1"
                               Text="最小分辨率"
                               Style="{StaticResource CyanFormLabelStyle}"
                               IsEnabled="{Binding IsResolutionFilterEnabled}" />
                    <TextBox Grid.Column="2"
                             Text="{Binding MinResolutionWidth}"
                             IsEnabled="{Binding IsResolutionFilterEnabled}" />
                    <TextBlock Grid.Column="3"
                               Text="x"
                               VerticalAlignment="Center"
                               Margin="8,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBox Grid.Column="4"
                             Text="{Binding MinResolutionHeight}"
                             IsEnabled="{Binding IsResolutionFilterEnabled}" />
                </Grid>
            </Grid>
        </GroupBox>

        <GroupBox Header="执行"
                  Grid.Row="2"
                  Margin="0,0,0,12"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Command="{Binding StartCommand}"
                        IsEnabled="{Binding IsStartButtonEnabled}"
                        Style="{StaticResource CyanPrimaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Filter24"
                                       Margin="0,0,6,0" />
                        <TextBlock Text="开始筛选" />
                    </StackPanel>
                </Button>
                <ProgressBar Grid.Column="1"
                             Value="{Binding ProgressValue}"
                             Height="18"
                             VerticalAlignment="Center"
                             Margin="12,0,0,0" />
            </Grid>
        </GroupBox>

        <GroupBox Header="日志"
                  Grid.Row="3"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <ListView ItemsSource="{Binding Logs}"
                      Style="{StaticResource CyanListBoxSurfaceStyle}" />
        </GroupBox>
    </Grid>
</UserControl>
