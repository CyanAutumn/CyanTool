<UserControl x:Class="CyanTools.PromptManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:CyanTools"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.DataContext>
        <viewModel:PromptManagerViewModel />
    </UserControl.DataContext>

    <Grid Style="{StaticResource CyanPageGridStyle}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="220" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <GroupBox Header="文件名"
                  Grid.Column="0"
                  Margin="0,0,12,0"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <ListView ItemsSource="{Binding PromptFiles}"
                      SelectedItem="{Binding SelectedPromptFile}"
                      Style="{StaticResource CyanListBoxSurfaceStyle}" />
        </GroupBox>

        <GridSplitter Grid.Column="1"
                      Style="{StaticResource CyanGridSplitterStyle}" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <GroupBox Header="内容"
                      Grid.Row="0"
                      Style="{StaticResource CyanGroupBoxStyle}">
                <TextBox Text="{Binding CurrentPromptContent, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Padding="10"
                         BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                         Background="{DynamicResource ControlFillColorDefaultBrush}"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </GroupBox>

            <GroupBox Header="操作"
                      Grid.Row="1"
                      Margin="0,12,0,0"
                      Style="{StaticResource CyanGroupBoxStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Command="{Binding OpenFolderCommand}"
                            Style="{StaticResource CyanCommandButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="FolderOpen24"
                                           Margin="0,0,6,0" />
                            <TextBlock Text="打开文件夹" />
                        </StackPanel>
                    </Button>

                    <Grid Grid.Column="1"
                          Margin="10,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="文件名"
                                   Style="{StaticResource CyanFormLabelStyle}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding CurrentFileName, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <StackPanel Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                Margin="0,12,0,0">
                        <Button Command="{Binding CreateOrEditCommand}"
                                Style="{StaticResource CyanPrimaryActionButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24"
                                               Margin="0,0,6,0" />
                                <TextBlock Text="新建/修改" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DeleteCommand}"
                                Style="{StaticResource CyanCommandButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Delete24"
                                               Margin="0,0,6,0" />
                                <TextBlock Text="删除" />
                            </StackPanel>
                        </Button>
                        <Button Content="随机复制"
                                Command="{Binding GetRandomPromptCommand}"
                                Style="{StaticResource CyanCommandButtonStyle}" />
                        <Button Content="自增添加"
                                Command="{Binding AutoIncrementAddCommand}"
                                Style="{StaticResource CyanCommandButtonStyle}" />
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
