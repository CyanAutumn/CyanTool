<UserControl x:Class="CyanTools.PromptManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:CyanTools"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             mc:Ignorable="d"
             d:DesignHeight="560"
             d:DesignWidth="960">
    <UserControl.DataContext>
        <viewModel:PromptManagerViewModel />
    </UserControl.DataContext>

    <Grid Style="{StaticResource CyanPageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CyanCardStyle}"
                Margin="0,0,0,14"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CyanIconBadgeStyle}"
                        Margin="0,0,14,0">
                    <ui:SymbolIcon Symbol="DocumentSearch24"
                                   FontSize="22"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="提示词管理"
                               Style="{StaticResource CyanSectionTitleStyle}" />
                    <TextBlock Text="维护本地提示词文件，快速创建、编辑、随机复制和自增添加。"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="240" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Header="文件列表"
                      Margin="0,0,12,0">
                <ListView ItemsSource="{Binding PromptFiles}"
                          SelectedItem="{Binding SelectedPromptFile}"
                          Style="{StaticResource CyanListBoxSurfaceStyle}" />
            </GroupBox>

            <GridSplitter Grid.Column="1"
                          Style="{StaticResource CyanGridSplitterStyle}" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0"
                          Header="内容">
                    <TextBox Text="{Binding CurrentPromptContent, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Padding="12"
                             BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                             Background="{DynamicResource ControlFillColorDefaultBrush}"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </GroupBox>

                <Border Grid.Row="1"
                        Style="{StaticResource CyanToolbarSurfaceStyle}"
                        Margin="0,14,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Command="{Binding OpenFolderCommand}"
                                Style="{StaticResource CyanCommandButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="FolderOpen24"
                                               Margin="0,0,6,0" />
                                <TextBlock Text="打开文件夹" />
                            </StackPanel>
                        </Button>

                        <Grid Grid.Column="1"
                              Margin="10,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="文件名"
                                       Style="{StaticResource CyanFormLabelStyle}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding CurrentFileName, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <StackPanel Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    Margin="0,12,0,0">
                            <Button Command="{Binding CreateOrEditCommand}"
                                    Style="{StaticResource CyanPrimaryActionButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Add24"
                                                   Margin="0,0,6,0" />
                                    <TextBlock Text="新建/修改" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding DeleteCommand}"
                                    Style="{StaticResource CyanCommandButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Delete24"
                                                   Margin="0,0,6,0" />
                                    <TextBlock Text="删除" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding GetRandomPromptCommand}"
                                    Style="{StaticResource CyanCommandButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowShuffle24"
                                                   Margin="0,0,6,0" />
                                    <TextBlock Text="随机复制" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding AutoIncrementAddCommand}"
                                    Style="{StaticResource CyanCommandButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="AddCircle24"
                                                   Margin="0,0,6,0" />
                                    <TextBlock Text="自增添加" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
