<UserControl x:Class="CyanTools.HandIntegrityFilterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="620"
             d:DesignWidth="1000">
    <ScrollViewer Style="{StaticResource CyanPageScrollViewerStyle}">
        <Grid Style="{StaticResource CyanPageGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource CyanCardStyle}"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CyanIconBadgeStyle}"
                            Margin="0,0,14,0">
                        <ui:SymbolIcon Symbol="ImageSparkle24"
                                       FontSize="22"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="手指完整性筛选"
                                   Style="{StaticResource CyanSectionTitleStyle}" />
                        <TextBlock Text="按模型检测手部关键点，将疑似异常图片分流到输出路径。"
                                   Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.25*" />
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0"
                          Header="路径">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="输入路径"
                                   Style="{StaticResource CyanFormLabelStyle}" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Text="{Binding InputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,8"
                                 VerticalContentAlignment="Center" />
                        <Button Grid.Row="0"
                                Grid.Column="2"
                                Style="{StaticResource CyanSmallIconButtonStyle}"
                                Command="{Binding BrowseInputCommand}"
                                ToolTip="选择输入路径">
                            <ui:SymbolIcon Symbol="FolderOpen24" />
                        </Button>

                        <CheckBox Grid.Row="1"
                                  Grid.Column="1"
                                  Grid.ColumnSpan="2"
                                  Content="执行完成后清空输入路径文件夹"
                                  IsChecked="{Binding ShouldClearInputDirectoryAfterCompletion}"
                                  Margin="0,0,0,10"
                                  ToolTip="执行成功后会删除输入路径文件夹中的内容，并自动保留输出路径。" />

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="坏图输出"
                                   Style="{StaticResource CyanFormLabelStyle}" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,8"
                                 VerticalContentAlignment="Center" />
                        <Button Grid.Row="2"
                                Grid.Column="2"
                                Style="{StaticResource CyanSmallIconButtonStyle}"
                                Command="{Binding BrowseOutputCommand}"
                                ToolTip="选择坏图输出路径">
                            <ui:SymbolIcon Symbol="FolderOpen24" />
                        </Button>

                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Text="好图输出"
                                   Style="{StaticResource CyanFormLabelStyle}" />
                        <TextBox Grid.Row="3"
                                 Grid.Column="1"
                                 Text="{Binding GoodOutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0"
                                 VerticalContentAlignment="Center" />
                        <Button Grid.Row="3"
                                Grid.Column="2"
                                Style="{StaticResource CyanSmallIconButtonStyle}"
                                Command="{Binding BrowseGoodOutputCommand}"
                                ToolTip="选择好图输出路径">
                            <ui:SymbolIcon Symbol="FolderOpen24" />
                        </Button>

                        <TextBlock Grid.Row="4"
                                   Grid.Column="1"
                                   Grid.ColumnSpan="2"
                                   Text="留空则不输出好图"
                                   Style="{StaticResource CyanTinyTextBlockStyle}"
                                   Margin="0,6,0,0" />
                    </Grid>
                </GroupBox>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0"
                              Header="模型设置"
                              Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="118" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.ColumnSpan="4"
                                       Text="首次使用会自动下载模型（需联网）"
                                       Style="{StaticResource CyanTinyTextBlockStyle}"
                                       Margin="0,0,0,10" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="检测模型"
                                       Style="{StaticResource CyanFormLabelStyle}" />
                            <ComboBox Grid.Row="1"
                                      Grid.Column="1"
                                      Grid.ColumnSpan="3"
                                      ItemsSource="{Binding DetectorModels}"
                                      SelectedItem="{Binding SelectedDetectorModel}"
                                      DisplayMemberPath="DisplayName"
                                      Margin="0,0,0,8" />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="关键点模型"
                                       Style="{StaticResource CyanFormLabelStyle}" />
                            <ComboBox Grid.Row="2"
                                      Grid.Column="1"
                                      Grid.ColumnSpan="3"
                                      ItemsSource="{Binding LandmarkModels}"
                                      SelectedItem="{Binding SelectedLandmarkModel}"
                                      DisplayMemberPath="DisplayName"
                                      Margin="0,0,0,12" />

                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Text="检测尺寸"
                                       Style="{StaticResource CyanFormLabelStyle}" />
                            <TextBox Grid.Row="3"
                                     Grid.Column="1"
                                     Text="{Binding DetectorInputSize}"
                                     Margin="0,0,12,8" />
                            <TextBlock Grid.Row="3"
                                       Grid.Column="2"
                                       Text="置信度"
                                       Style="{StaticResource CyanFormLabelStyle}" />
                            <TextBox Grid.Row="3"
                                     Grid.Column="3"
                                     Text="{Binding DetectorConfidence}"
                                     Margin="0,0,0,8" />

                            <TextBlock Grid.Row="4"
                                       Grid.Column="0"
                                       Text="IOU"
                                       Style="{StaticResource CyanFormLabelStyle}" />
                            <TextBox Grid.Row="4"
                                     Grid.Column="1"
                                     Text="{Binding DetectorIouThreshold}"
                                     Margin="0,0,12,8" />
                            <TextBlock Grid.Row="4"
                                       Grid.Column="2"
                                       Text="手类 ID"
                                       Style="{StaticResource CyanFormLabelStyle}" />
                            <TextBox Grid.Row="4"
                                     Grid.Column="3"
                                     Text="{Binding HandClassId}"
                                     Margin="0,0,0,8" />

                            <TextBlock Grid.Row="5"
                                       Grid.Column="0"
                                       Text="关键点尺寸"
                                       Style="{StaticResource CyanFormLabelStyle}" />
                            <TextBox Grid.Row="5"
                                     Grid.Column="1"
                                     Text="{Binding LandmarkInputSize}"
                                     Margin="0,0,12,0" />
                            <TextBlock Grid.Row="5"
                                       Grid.Column="2"
                                       Text="输入格式"
                                       Style="{StaticResource CyanFormLabelStyle}" />
                            <ComboBox Grid.Row="5"
                                      Grid.Column="3"
                                      ItemsSource="{Binding LandmarkInputFormats}"
                                      SelectedItem="{Binding SelectedLandmarkInputFormat}" />

                            <TextBlock Grid.Row="6"
                                       Grid.Column="0"
                                       Text="存在阈值"
                                       Style="{StaticResource CyanFormLabelStyle}"
                                       Margin="0,10,10,0" />
                            <TextBox Grid.Row="6"
                                     Grid.Column="1"
                                     Text="{Binding MinPresenceScore}"
                                     Margin="0,10,12,0" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="1"
                              Header="筛选设置">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="118" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <WrapPanel Grid.Row="0"
                                       Grid.ColumnSpan="4"
                                       Margin="0,0,0,12">
                                <CheckBox Content="包含子目录"
                                          IsChecked="{Binding IncludeSubfolders}"
                                          Margin="0,0,20,6" />
                                <CheckBox Content="同时处理同名 txt"
                                          IsChecked="{Binding CopyCompanionText}"
                                          Margin="0,0,20,6" />
                                <CheckBox Content="关键点缺失视为坏图"
                                          IsChecked="{Binding FailOnLandmarkMissing}"
                                          Margin="0,0,20,6" />
                            </WrapPanel>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="输出方式"
                                       Style="{StaticResource CyanFormLabelStyle}" />
                            <ComboBox Grid.Row="1"
                                      Grid.Column="1"
                                      ItemsSource="{Binding OutputModes}"
                                      SelectedItem="{Binding SelectedOutputMode}"
                                      Margin="0,0,12,8" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="2"
                                       Text="裁剪缩放"
                                       Style="{StaticResource CyanFormLabelStyle}" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="3"
                                     Text="{Binding CropScale}"
                                     Margin="0,0,0,8" />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="最小指长"
                                       Style="{StaticResource CyanFormLabelStyle}" />
                            <TextBox Grid.Row="2"
                                     Grid.Column="1"
                                     Text="{Binding MinFingerLengthRatio}"
                                     Margin="0,0,12,0" />
                            <TextBlock Grid.Row="2"
                                       Grid.Column="2"
                                       Text="指尖伸展"
                                       Style="{StaticResource CyanFormLabelStyle}" />
                            <TextBox Grid.Row="2"
                                     Grid.Column="3"
                                     Text="{Binding MinTipToMcpRatio}" />
                        </Grid>
                    </GroupBox>
                </Grid>
            </Grid>

            <Grid Grid.Row="2"
                  Margin="0,14,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource CyanToolbarSurfaceStyle}"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource CyanPrimaryActionButtonStyle}"
                                Command="{Binding StartCommand}"
                                IsEnabled="{Binding IsIdle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="PlayCircle24"
                                               Margin="0,0,6,0" />
                                <TextBlock Text="开始筛选" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                Style="{StaticResource CyanCommandButtonStyle}"
                                Command="{Binding ClearLogCommand}"
                                IsEnabled="{Binding IsIdle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Broom24"
                                               Margin="0,0,6,0" />
                                <TextBlock Text="清空日志" />
                            </StackPanel>
                        </Button>

                        <ProgressBar Grid.Column="2"
                                     Value="{Binding ProgressValue}"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="8"
                                     Margin="10,0,0,0"
                                     VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <GroupBox Grid.Row="1"
                          Header="日志和结果">
                    <ListBox ItemsSource="{Binding LogLines}"
                             Style="{StaticResource CyanListBoxSurfaceStyle}"
                             MinHeight="180"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           TextWrapping="NoWrap"
                                           FontFamily="Consolas"
                                           FontSize="12" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
