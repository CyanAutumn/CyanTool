<UserControl x:Class="CyanTools.XyzToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="360"
             d:DesignWidth="760"
             Background="Transparent">
    <Grid Style="{StaticResource CyanPageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CyanCardStyle}"
                Margin="0,0,0,12"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CyanIconBadgeStyle}"
                        Margin="0,0,14,0">
                    <ui:SymbolIcon Symbol="NumberSymbol24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="XYZ 序号提示词"
                               Style="{StaticResource CyanSectionTitleStyle}" />
                    <TextBlock Text="按开始、结束和间隔生成可复制的序号提示词。"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <GroupBox Grid.Row="1"
                  Header="生成设置"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="开始"
                           Style="{StaticResource CyanFormLabelStyle}" />
                <ui:TextBox Grid.Column="1"
                         Text="{Binding XyzStartText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,16,0" />

                <TextBlock Grid.Column="2"
                           Text="结束"
                           Style="{StaticResource CyanFormLabelStyle}" />
                <ui:TextBox Grid.Column="3"
                         Text="{Binding XyzEndText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,16,0" />

                <TextBlock Grid.Column="4"
                           Text="间隔"
                           Style="{StaticResource CyanFormLabelStyle}" />
                <ui:TextBox Grid.Column="5"
                         Text="{Binding XyzIntervalText, UpdateSourceTrigger=PropertyChanged}" />

                <ui:Button Grid.Column="7"
                        Command="{Binding CopyXyzPromptCommand}"
                        Style="{StaticResource CyanPrimaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Copy24"
                                       Margin="0,0,6,0" />
                        <TextBlock Text="复制" />
                    </StackPanel>
                </ui:Button>

                <ui:TextBox Grid.Row="1"
                         Grid.Column="0"
                         Grid.ColumnSpan="8"
                         Text="{Binding XyzPromptText, Mode=OneWay}"
                         Style="{StaticResource CyanLogTextBoxStyle}"
                         Margin="0,14,0,0"
                         MinHeight="180" />
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
