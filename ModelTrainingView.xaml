<UserControl x:Class="CyanTools.ModelTrainingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             xmlns:model="clr-namespace:CyanTools.Model"
             xmlns:utils="clr-namespace:CyanTools.Utils"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">
    <UserControl.DataContext>
        <viewModel:ModelTrainingViewModel />
    </UserControl.DataContext>
    <UserControl.Resources>
        <utils:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <ScrollViewer Margin="10" VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical" Margin="0,0,0,10">
            <GroupBox Header="脚本与配置">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="lora-scripts 目录:" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding ScriptsRootPath, UpdateSourceTrigger=PropertyChanged}" Margin="5,0" />
                    <Button Grid.Column="2" Content="浏览" Command="{Binding BrowseScriptsRootCommand}" Margin="5,0" Padding="10,2"/>

                    <TextBlock Grid.Row="1" Text="TOML 输出路径:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OutputTomlPath, UpdateSourceTrigger=PropertyChanged}" Margin="5,3"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="..." Command="{Binding BrowseTomlCommand}" Margin="5,3" Padding="10,2"/>

                    <TextBlock Grid.Row="2" Text="训练脚本路径:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ScriptPath, UpdateSourceTrigger=PropertyChanged}" Margin="5,3"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="..." Command="{Binding BrowseScriptCommand}" Margin="5,3" Padding="10,2"/>

                    <TextBlock Grid.Row="3" Text="附加参数:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding AdditionalArguments, UpdateSourceTrigger=PropertyChanged}" Margin="5,3"/>
                </Grid>
            </GroupBox>

            <DockPanel Margin="0,10,0,0">
                <CheckBox Content="开始训练后关闭本软件"
                          IsChecked="{Binding CloseAppAfterStart}"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="重置默认参数" Command="{Binding ResetDefaultsCommand}" Margin="5,0" Padding="15,5"/>
                    <Button Content="仅生成 TOML" Command="{Binding GenerateTomlCommand}" Margin="5,0" Padding="15,5"/>
                    <Button Content="生成并开始训练" Command="{Binding RunTrainingCommand}" Margin="5,0" Padding="15,5"/>
                </StackPanel>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Header="{Binding DisplayName}" IsExpanded="True" Margin="0,0,0,10">
                            <ItemsControl ItemsSource="{Binding Parameters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Vertical">
                                                    <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="10,0,0,0">
                                                    <ContentControl Content="{Binding}">
                                                        <ContentControl.Style>
                                                                <Style TargetType="ContentControl">
                                                                <Setter Property="ContentTemplate">
                                                                    <Setter.Value>
                                                                        <DataTemplate>
                                                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5" />
                                                                        </DataTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ValueKind}" Value="{x:Static model:ParameterValueKind.Boolean}">
                                                                        <Setter Property="ContentTemplate">
                                                                            <Setter.Value>
                                                                                <DataTemplate>
                                                                                    <CheckBox IsChecked="{Binding BoolValue}" Margin="0,4,0,0"/>
                                                                                </DataTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding HasOptions}" Value="True">
                                                                        <Setter Property="ContentTemplate">
                                                                            <Setter.Value>
                                                                                <DataTemplate>
                                                                                    <ComboBox ItemsSource="{Binding Options}"
                                                                                              SelectedItem="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                              Margin="0,0,0,5"/>
                                                                                </DataTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ContentControl.Style>
                                                    </ContentControl>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        <GroupBox Header="执行日志" Margin="0,10,0,0">
            <Grid Margin="5" Height="200">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ProgressBar Grid.Row="0" Height="6" IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding LogLines}" Margin="0,5,0,0"/>
            </Grid>
        </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
