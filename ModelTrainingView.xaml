<UserControl x:Class="CyanTools.ModelTrainingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             xmlns:model="clr-namespace:CyanTools.Model"
             xmlns:utils="clr-namespace:CyanTools.Utils"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1100">
    <UserControl.DataContext>
        <viewModel:ModelTrainingViewModel />
    </UserControl.DataContext>
    <UserControl.Resources>
        <utils:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="TrainingParameterEditorStyle" TargetType="{x:Type ContentControl}">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <ui:TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ValueKind}" Value="{x:Static model:ParameterValueKind.Boolean}">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding BoolValue}"
                                          VerticalAlignment="Center" />
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasOptions}" Value="True">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding Options}"
                                          SelectedItem="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource LocalizedTextConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource CyanPageScrollViewerStyle}">
        <Grid Style="{StaticResource CyanPageGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource CyanCardStyle}"
                    Margin="0,0,0,14"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CyanIconBadgeStyle}"
                            Margin="0,0,14,0">
                        <ui:SymbolIcon Symbol="Toolbox24"
                                       FontSize="22"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="模型训练"
                                   Style="{StaticResource CyanSectionTitleStyle}" />
                        <TextBlock Text="管理训练脚本、TOML 输出和参数分组，生成配置后可直接启动训练。"
                                   Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <GroupBox Grid.Row="1"
                      Header="脚本与配置"
                      Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="lora-scripts 目录"
                               Style="{StaticResource CyanFormLabelStyle}" />
                    <ui:TextBox Grid.Row="0"
                             Grid.Column="1"
                             Text="{Binding ScriptsRootPath, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,8,8" />
                    <ui:Button Grid.Row="0"
                            Grid.Column="2"
                            Style="{StaticResource CyanSmallIconButtonStyle}"
                            Command="{Binding BrowseScriptsRootCommand}"
                            ToolTip="浏览 lora-scripts 目录"
                            Margin="0,0,0,8">
                        <ui:SymbolIcon Symbol="FolderOpen24" />
                    </ui:Button>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="TOML 输出路径"
                               Style="{StaticResource CyanFormLabelStyle}" />
                    <ui:TextBox Grid.Row="1"
                             Grid.Column="1"
                             Text="{Binding OutputTomlPath, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,8,8" />
                    <ui:Button Grid.Row="1"
                            Grid.Column="2"
                            Style="{StaticResource CyanSmallIconButtonStyle}"
                            Command="{Binding BrowseTomlCommand}"
                            ToolTip="选择 TOML 输出路径"
                            Margin="0,0,0,8">
                        <ui:SymbolIcon Symbol="FolderOpen24" />
                    </ui:Button>

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="训练脚本路径"
                               Style="{StaticResource CyanFormLabelStyle}" />
                    <ui:TextBox Grid.Row="2"
                             Grid.Column="1"
                             Text="{Binding ScriptPath, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,8,8" />
                    <ui:Button Grid.Row="2"
                            Grid.Column="2"
                            Style="{StaticResource CyanSmallIconButtonStyle}"
                            Command="{Binding BrowseScriptCommand}"
                            ToolTip="选择训练脚本"
                            Margin="0,0,0,8">
                        <ui:SymbolIcon Symbol="FolderOpen24" />
                    </ui:Button>

                    <TextBlock Grid.Row="3"
                               Grid.Column="0"
                               Text="附加参数"
                               Style="{StaticResource CyanFormLabelStyle}" />
                    <ui:TextBox Grid.Row="3"
                             Grid.Column="1"
                             Grid.ColumnSpan="2"
                             Text="{Binding AdditionalArguments, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </GroupBox>

            <Border Grid.Row="2"
                    Style="{StaticResource CyanToolbarSurfaceStyle}"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              Content="开始训练后关闭本软件"
                              IsChecked="{Binding CloseAppAfterStart}"
                              VerticalAlignment="Center" />

                    <ui:Button Grid.Column="1"
                            Style="{StaticResource CyanCommandButtonStyle}"
                            Command="{Binding ResetDefaultsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowReset24"
                                           Margin="0,0,6,0" />
                            <TextBlock Text="重置默认参数" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Grid.Column="2"
                            Style="{StaticResource CyanCommandButtonStyle}"
                            Command="{Binding GenerateTomlCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Save24"
                                           Margin="0,0,6,0" />
                            <TextBlock Text="仅生成 TOML" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Grid.Column="3"
                            Style="{StaticResource CyanPrimaryActionButtonStyle}"
                            Command="{Binding RunTrainingCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="PlayCircle24"
                                           Margin="0,0,6,0" />
                            <TextBlock Text="生成并开始训练" />
                        </StackPanel>
                    </ui:Button>
                </Grid>
            </Border>

            <ItemsControl Grid.Row="3"
                          ItemsSource="{Binding Sections}"
                          Margin="0,0,0,4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Header="{Binding DisplayName, Converter={StaticResource LocalizedTextConverter}}"
                                  IsExpanded="True"
                                  Style="{StaticResource CyanExpanderStyle}">
                            <Border Style="{StaticResource CyanCardStyle}"
                                    Padding="14"
                                    Margin="0,8,0,0">
                                <ItemsControl ItemsSource="{Binding Parameters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CyanParameterRowStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="240" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0"
                                                                Margin="0,0,18,0">
                                                        <TextBlock Text="{Binding DisplayLabel, Converter={StaticResource LocalizedTextConverter}}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Description, Converter={StaticResource LocalizedTextConverter}}"
                                                                   Style="{StaticResource CyanTinyTextBlockStyle}"
                                                                   Margin="0,4,0,0" />
                                                    </StackPanel>

                                                    <ContentControl Grid.Column="1"
                                                                    Content="{Binding}"
                                                                    Style="{StaticResource TrainingParameterEditorStyle}"
                                                                    VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <GroupBox Grid.Row="4"
                      Header="执行日志">
                <Grid MinHeight="220">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ProgressBar Grid.Row="0"
                                 Height="8"
                                 IsIndeterminate="{Binding IsBusy}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Margin="0,0,0,10" />
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding LogLines}"
                             Style="{StaticResource CyanListBoxSurfaceStyle}" />
                </Grid>
            </GroupBox>
        </Grid>
    </ScrollViewer>
</UserControl>
