<UserControl x:Class="CyanTools.InferenceProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1100">
    <Grid Style="{StaticResource CyanPageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0"
                  Header="跑图工程"
                  Margin="0,0,0,12"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="运行环境路径绑定"
                               Style="{StaticResource CyanFormLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding Projects}"
                              SelectedItem="{Binding SelectedProject}"
                              DisplayMemberPath="DisplayName"
                              MinHeight="34"
                              MinWidth="440"
                              Margin="0,4,12,0"/>
                </StackPanel>

                <WrapPanel Grid.Column="1"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,0">
                    <Button Command="{Binding ReloadProjectsCommand}"
                            Style="{StaticResource CyanCommandButtonStyle}"
                            Content="刷新绑定"/>
                    <Button Command="{Binding StartCommand}"
                            Style="{StaticResource CyanPrimaryActionButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Play24" Margin="0,0,6,0"/>
                            <TextBlock Text="启动"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding StopCommand}"
                            Style="{StaticResource CyanCommandButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Stop24" Margin="0,0,6,0"/>
                            <TextBlock Text="停止"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="根目录" Style="{StaticResource CyanFormLabelStyle}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding SelectedRootPath, Mode=OneWay}"
                             IsReadOnly="True"
                             MinHeight="32"
                             Margin="12,0,0,0"/>
                </Grid>

                <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding SelectedRuntimeText}"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusText}"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1"
                  Header="模型目录"
                  Margin="0,0,0,12"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="快捷打开当前工程的常用资源目录；模型子目录不存在时会自动创建。"
                           Style="{StaticResource CyanSecondaryTextBlockStyle}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <WrapPanel Grid.Column="1" Margin="14,0,0,0">
                    <Button Command="{Binding OpenFolderCommand}"
                            CommandParameter="Root"
                            Style="{StaticResource CyanCommandButtonStyle}"
                            Content="打开根目录"/>
                    <Button Command="{Binding OpenFolderCommand}"
                            CommandParameter="Checkpoint"
                            Style="{StaticResource CyanCommandButtonStyle}"
                            Content="Checkpoint / Model"/>
                    <Button Command="{Binding OpenFolderCommand}"
                            CommandParameter="Lora"
                            Style="{StaticResource CyanCommandButtonStyle}"
                            Content="LoRA"/>
                    <Button Command="{Binding OpenFolderCommand}"
                            CommandParameter="Vae"
                            Style="{StaticResource CyanCommandButtonStyle}"
                            Content="VAE"/>
                </WrapPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2"
                  Header="输出日志"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right"
                            Command="{Binding ClearLogCommand}"
                            Style="{StaticResource CyanCommandButtonStyle}"
                            Content="清空日志"/>
                    <TextBlock Text="实时合并显示标准输出与错误输出。"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               VerticalAlignment="Center"/>
                </DockPanel>
                <TextBox Grid.Row="1"
                         Text="{Binding LogText, Mode=OneWay}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Cascadia Mono, Consolas"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         TextChanged="LogTextBox_TextChanged"
                         MinHeight="240"/>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
