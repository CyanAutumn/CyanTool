<UserControl x:Class="CyanTools.SameSourceImageGroupingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             xmlns:utils="clr-namespace:CyanTools.Utils"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="920">
    <UserControl.Resources>
        <utils:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Style="{StaticResource CyanPageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CyanCardStyle}"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CyanIconBadgeStyle}"
                        Margin="0,0,14,0">
                    <ui:SymbolIcon Symbol="ImageMultiple24"
                                   FontSize="22"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="同源图片归类"
                               Style="{StaticResource CyanSectionTitleStyle}" />
                    <TextBlock Text="识别原图、缩略图、副本、被包含图和差分图，并导出清晰的分组结果。"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="0.75*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Header="路径">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="输入路径"
                               Style="{StaticResource CyanFormLabelStyle}" />
                    <TextBox Grid.Column="1"
                             Text="{Binding InputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding HasInheritedInputPath}"
                             Margin="0,0,8,0" />
                    <Button Grid.Column="2"
                            Command="{Binding SelectInputCommand}"
                            Style="{StaticResource CyanSmallIconButtonStyle}"
                            ToolTip="选择输入路径"
                            Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                        <ui:SymbolIcon Symbol="FolderOpen24" />
                    </Button>

                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Grid.ColumnSpan="2"
                               Text="管道调度中此输入路径固定为上一个节点的输出路径；如果上一个节点没有输出路径，则沿用其输入路径。"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               Margin="0,6,0,0"
                               Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <CheckBox Grid.Row="2"
                              Grid.Column="1"
                              Grid.ColumnSpan="2"
                              Content="执行完成后清空输入路径文件夹"
                              IsChecked="{Binding ShouldClearInputDirectoryAfterCompletion, Mode=TwoWay}"
                              Margin="0,8,0,0"
                              ToolTip="执行成功后会删除输入路径文件夹中的内容，并自动保留输出路径。" />

                    <TextBlock Grid.Row="3"
                               Text="输出路径"
                               Style="{StaticResource CyanFormLabelStyle}"
                               Margin="0,12,10,0"
                               Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                    <TextBox Grid.Row="3"
                             Grid.Column="1"
                             Text="{Binding OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,12,8,0"
                             Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                    <Button Grid.Row="3"
                            Grid.Column="2"
                            Command="{Binding SelectOutputCommand}"
                            Style="{StaticResource CyanSmallIconButtonStyle}"
                            Margin="0,12,0,0"
                            ToolTip="选择输出路径"
                            Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                        <ui:SymbolIcon Symbol="FolderOpen24" />
                    </Button>

                    <TextBlock Grid.Row="4"
                               Grid.Column="1"
                               Grid.ColumnSpan="2"
                               Text="程序会在输出路径自动生成：原图 / 缩略图 / 副本 / 被包含 / 差分 / 其他。输出路径可留空，默认使用输入路径旁边的“同源”。"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               Margin="0,8,0,0" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2"
                      Header="计算设备">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="设备"
                               Style="{StaticResource CyanFormLabelStyle}" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding ComputeBackendOptions}"
                              SelectedItem="{Binding ComputeBackend, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Text="auto 优先尝试 GPU，失败时回退到 CPU；cuda 必须可用；cpu 强制 CPU。"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               Margin="0,12,0,0" />
                </Grid>
            </GroupBox>
        </Grid>

        <Border Grid.Row="2"
                Style="{StaticResource CyanToolbarSurfaceStyle}"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Command="{Binding StartCommand}"
                        Style="{StaticResource CyanPrimaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ImageMultiple24"
                                       Margin="0,0,6,0" />
                        <TextBlock Text="开始归类" />
                    </StackPanel>
                </Button>
                <ProgressBar Grid.Column="1"
                             Value="{Binding Progress}"
                             Maximum="100"
                             Height="8"
                             Margin="12,0,0,0"
                             VerticalAlignment="Center" />
            </Grid>
        </Border>

        <GroupBox Grid.Row="3"
                  Header="日志和结果">
            <TextBox Text="{Binding Log}"
                     MinHeight="160"
                     Style="{StaticResource CyanLogTextBoxStyle}" />
        </GroupBox>
    </Grid>
</UserControl>
