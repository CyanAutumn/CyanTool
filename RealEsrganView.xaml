<UserControl x:Class="CyanTools.RealEsrganView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             xmlns:utils="clr-namespace:CyanTools.Utils"
             mc:Ignorable="d"
             d:DesignHeight="560"
             d:DesignWidth="920">
    <UserControl.Resources>
        <utils:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Style="{StaticResource CyanPageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CyanCardStyle}"
                Margin="0,0,0,14"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CyanIconBadgeStyle}"
                        Margin="0,0,14,0">
                    <ui:SymbolIcon Symbol="ImageSparkle24"
                                   FontSize="22"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Real-ESRGAN / waifu2x"
                               Style="{StaticResource CyanSectionTitleStyle}" />
                    <TextBlock Text="统一管理超分工具、模型参数、输出选项和运行日志。"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <GroupBox Header="路径"
                  Grid.Row="1"
                  Margin="0,0,0,12"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="输入路径"
                           Style="{StaticResource CyanFormLabelStyle}"/>
                <ui:TextBox Grid.Column="1"
                         Text="{Binding InputDirectory, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding HasInheritedInputPath}"
                         Margin="0,0,8,0"/>
                <ui:Button Grid.Column="2"
                        Content="..."
                        Command="{Binding BrowseInputCommand}"
                        Width="40"
                        ToolTip="选择输入路径"
                        Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Text="工作流中此输入路径固定为上一个节点的输出路径；如果上一个节点没有输出路径，则沿用其输入路径。"
                           Style="{StaticResource CyanSecondaryTextBlockStyle}"
                           Margin="0,6,0,0"
                           Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="输出路径"
                               Style="{StaticResource CyanFormLabelStyle}"
                               Margin="0,12,10,0"
                               Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                    <ui:TextBox Grid.Column="1"
                             Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,12,8,0"
                             Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                    <ui:Button Grid.Column="2"
                            Content="..."
                            Command="{Binding BrowseOutputCommand}"
                            Width="40"
                            Margin="0,12,0,0"
                            ToolTip="选择输出路径"
                            Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                </Grid>

                <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Text="工作流模式下输出路径自动生成：父级目录/NN-节点名"
                           Style="{StaticResource CyanSecondaryTextBlockStyle}"
                           Margin="0,8,0,0"
                           Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <CheckBox Grid.Row="4"
                          Grid.Column="1"
                          Grid.ColumnSpan="2"
                          Content="执行完成后清空输入路径文件夹"
                          IsChecked="{Binding ShouldClearInputDirectoryAfterCompletion}"
                          Margin="0,8,0,0"
                          ToolTip="执行成功后会删除输入路径文件夹中的内容，并自动保留输出路径。"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="引擎"
                  Grid.Row="2"
                  Margin="0,0,0,12"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="选择工具"
                           Style="{StaticResource CyanFormLabelStyle}"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableTools}"
                          SelectedItem="{Binding SelectedTool}"/>
                <TextBlock Grid.Column="2"
                           Text="Real-ESRGAN 与 waifu2x 共用同一执行入口，当前选择会决定下方参数面板。"
                           Style="{StaticResource CyanSecondaryTextBlockStyle}"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"/>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="3"
              Margin="0,0,0,12">
            <GroupBox Header="Real-ESRGAN 参数"
                      Style="{StaticResource CyanGroupBoxStyle}"
                      Visibility="{Binding IsRealEsrganSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="选择模型"
                               Style="{StaticResource CyanFormLabelStyle}"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding RealEsrganModels}"
                              SelectedItem="{Binding SelectedRealEsrganModel}"/>

                    <Grid Grid.Row="1"
                          Grid.ColumnSpan="2"
                          Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="放大倍数"
                                   Style="{StaticResource CyanFormLabelStyle}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Scales}"
                                  SelectedItem="{Binding SelectedScale}"/>

                        <TextBlock Grid.Column="2"
                                   Text="选择 GPU"
                                   Style="{StaticResource CyanFormLabelStyle}"
                                   Margin="18,0,10,0"/>
                        <ComboBox Grid.Column="3"
                                  ItemsSource="{Binding Gpus}"
                                  SelectedItem="{Binding SelectedGpu}"/>

                        <TextBlock Grid.Column="4"
                                   Text="瓦片大小"
                                   Style="{StaticResource CyanFormLabelStyle}"
                                   Margin="18,0,10,0"/>
                        <Grid Grid.Column="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Text="{Binding TileSize, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="1"
                                       Text="0 为不分块"
                                       Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </Grid>
                    </Grid>
                </Grid>
            </GroupBox>

            <GroupBox Header="waifu2x 参数"
                      Style="{StaticResource CyanGroupBoxStyle}"
                      Visibility="{Binding IsWaifu2xSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="放大倍数"
                               Style="{StaticResource CyanFormLabelStyle}"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Scales}"
                              SelectedItem="{Binding SelectedScale}"/>
                    <TextBlock Grid.Column="2"
                               Text="降噪等级"
                               Style="{StaticResource CyanFormLabelStyle}"
                               Margin="18,0,10,0"/>
                    <ComboBox Grid.Column="3"
                              ItemsSource="{Binding Waifu2xNoiseLevels}"
                              SelectedItem="{Binding SelectedWaifu2xNoiseLevel}"/>
                    <CheckBox Grid.Column="4"
                              Grid.ColumnSpan="2"
                              Content="使用照片模型"
                              IsChecked="{Binding Waifu2xUsePhotoModel}"
                              VerticalAlignment="Center"
                              Margin="18,0,0,0"/>

                    <TextBlock Grid.Row="1"
                               Text="裁剪大小"
                               Style="{StaticResource CyanFormLabelStyle}"
                               Margin="0,12,10,0"/>
                    <ui:TextBox Grid.Row="1"
                             Grid.Column="1"
                             Text="{Binding Waifu2xCropSize, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,12,0,0"/>
                </Grid>
            </GroupBox>
        </Grid>

        <GroupBox Header="执行"
                  Grid.Row="4"
                  Margin="0,0,0,12"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:Button Command="{Binding StartCommand}"
                        IsEnabled="{Binding IsIdle}"
                        Style="{StaticResource CyanPrimaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ImageSparkle24"
                                       Margin="0,0,6,0"/>
                        <TextBlock Text="开始超分"/>
                    </StackPanel>
                </ui:Button>

                <CheckBox Grid.Column="2"
                          Content="完成后打开目录"
                          IsChecked="{Binding ShouldOpenOutputDirectory}"
                          VerticalAlignment="Center"
                          Margin="10,0,0,0"/>
                <ui:Button Grid.Column="3"
                        Command="{Binding RestoreDefaultsCommand}"
                        Style="{StaticResource CyanCommandButtonStyle}"
                        Margin="14,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowReset24"
                                       Margin="0,0,6,0"/>
                        <TextBlock Text="恢复默认"/>
                    </StackPanel>
                </ui:Button>
                <ui:Button Grid.Column="4"
                        Command="{Binding ClearLogCommand}"
                        IsEnabled="{Binding IsIdle}"
                        Style="{StaticResource CyanCommandButtonStyle}"
                        Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Broom24"
                                       Margin="0,0,6,0"/>
                        <TextBlock Text="清空日志"/>
                    </StackPanel>
                </ui:Button>
            </Grid>
        </GroupBox>

        <GroupBox Header="日志"
                  Grid.Row="5"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <ListBox ItemsSource="{Binding LogLines}"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     HorizontalContentAlignment="Stretch"
                     Style="{StaticResource CyanListBoxSurfaceStyle}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>
    </Grid>
</UserControl>
