<UserControl x:Class="CyanTools.OptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="680"
             d:DesignWidth="920">
    <Grid>
        <TabControl>
            <TabItem Header="运行时">
                <ScrollViewer Style="{StaticResource CyanPageScrollViewerStyle}">
        <Grid Style="{StaticResource CyanPageGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="320"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0"
                      Header="系统检查"
                      Margin="0,0,0,12"
                      Style="{StaticResource CyanGroupBoxStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="训练后端与跑图后端安装状态；点击任意状态可定位到对应部署位置。"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               TextWrapping="Wrap"/>
                    <UniformGrid Grid.Row="1" Columns="2" Margin="0,10,0,0">
                        <ui:Button Tag="sd-scripts" Click="BackendStatusButton_Click" Style="{StaticResource CyanCommandButtonStyle}" HorizontalContentAlignment="Stretch">
                            <DockPanel MinWidth="260"><TextBlock DockPanel.Dock="Right" Text="{Binding SdScriptsInstallState, Converter={StaticResource LocalizedTextConverter}}"/><TextBlock Text="sd-scripts（Windows）"/></DockPanel>
                        </ui:Button>
                        <ui:Button Tag="wsl-sd-scripts" Click="BackendStatusButton_Click" Style="{StaticResource CyanCommandButtonStyle}" HorizontalContentAlignment="Stretch">
                            <DockPanel MinWidth="260"><TextBlock DockPanel.Dock="Right" Text="{Binding WslSdScriptsInstallState, Converter={StaticResource LocalizedTextConverter}}"/><TextBlock Text="sd-scripts（WSL）"/></DockPanel>
                        </ui:Button>
                        <ui:Button Tag="anima-fast-lora" Click="BackendStatusButton_Click" Style="{StaticResource CyanCommandButtonStyle}" HorizontalContentAlignment="Stretch">
                            <DockPanel MinWidth="260"><TextBlock DockPanel.Dock="Right" Text="{Binding AnimaFastLoraInstallState, Converter={StaticResource LocalizedTextConverter}}"/><TextBlock Text="Anima Fast LoRA（Windows）"/></DockPanel>
                        </ui:Button>
                        <ui:Button Tag="diffusion-pipe" Click="BackendStatusButton_Click" Style="{StaticResource CyanCommandButtonStyle}" HorizontalContentAlignment="Stretch">
                            <DockPanel MinWidth="260"><TextBlock DockPanel.Dock="Right" Text="{Binding DiffusionPipeInstallState, Converter={StaticResource LocalizedTextConverter}}"/><TextBlock Text="diffusion-pipe（WSL）"/></DockPanel>
                        </ui:Button>
                        <ui:Button Tag="comfyui-windows" Click="BackendStatusButton_Click" Style="{StaticResource CyanCommandButtonStyle}" HorizontalContentAlignment="Stretch">
                            <DockPanel MinWidth="260"><TextBlock DockPanel.Dock="Right" Text="{Binding ComfyUiWindowsInstallState, Converter={StaticResource LocalizedTextConverter}}"/><TextBlock Text="ComfyUI（Windows）"/></DockPanel>
                        </ui:Button>
                        <ui:Button Tag="comfyui-wsl" Click="BackendStatusButton_Click" Style="{StaticResource CyanCommandButtonStyle}" HorizontalContentAlignment="Stretch">
                            <DockPanel MinWidth="260"><TextBlock DockPanel.Dock="Right" Text="{Binding ComfyUiWslInstallState, Converter={StaticResource LocalizedTextConverter}}"/><TextBlock Text="ComfyUI（WSL）"/></DockPanel>
                        </ui:Button>
                        <ui:Button Tag="forge-neo-windows" Click="BackendStatusButton_Click" Style="{StaticResource CyanCommandButtonStyle}" HorizontalContentAlignment="Stretch">
                            <DockPanel MinWidth="260"><TextBlock DockPanel.Dock="Right" Text="{Binding ForgeNeoWindowsInstallState, Converter={StaticResource LocalizedTextConverter}}"/><TextBlock Text="Webui Forge Neo（Windows）"/></DockPanel>
                        </ui:Button>
                        <ui:Button Tag="forge-neo-wsl" Click="BackendStatusButton_Click" Style="{StaticResource CyanCommandButtonStyle}" HorizontalContentAlignment="Stretch">
                            <DockPanel MinWidth="260"><TextBlock DockPanel.Dock="Right" Text="{Binding ForgeNeoWslInstallState, Converter={StaticResource LocalizedTextConverter}}"/><TextBlock Text="Webui Forge Neo（WSL）"/></DockPanel>
                        </ui:Button>
                    </UniformGrid>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="1"
                      Header="CUDA / cuDNN"
                      Margin="0,0,0,12"
                      Style="{StaticResource CyanGroupBoxStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ui:Button Command="{Binding CheckCudaCommand}"
                            Style="{StaticResource CyanPrimaryActionButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24"
                                           Margin="0,0,6,0"/>
                            <TextBlock Text="检查/安装 CUDA"/>
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Grid.Column="1"
                            Command="{Binding InstallCudaToolkitCommand}"
                            Style="{StaticResource CyanCommandButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowDownload24"
                                           Margin="0,0,6,0"/>
                            <TextBlock Text="安装 CUDA Toolkit"/>
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Grid.Column="2"
                            Command="{Binding OpenCudaCudnnPagesCommand}"
                            Style="{StaticResource CyanCommandButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Open24"
                                           Margin="0,0,6,0"/>
                            <TextBlock Text="CUDA/cuDNN 页面"/>
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Grid.Column="3"
                            Command="{Binding OpenCudnnDownloadPageCommand}"
                            Style="{StaticResource CyanCommandButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowDownload24"
                                           Margin="0,0,6,0"/>
                            <TextBlock Text="下载 cuDNN"/>
                        </StackPanel>
                    </ui:Button>

                    <TextBlock Grid.Row="1"
                               Grid.ColumnSpan="5"
                               Text="GPU 推理依赖 NVIDIA 驱动、CUDA 12.x、cuDNN 9，以及带 CUDA Provider 的 ONNX Runtime。cuDNN 可拖入 zip 自动复制到程序目录或 CUDA 12 bin。"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               Margin="0,12,0,0"/>

                    <Border Grid.Row="2"
                            Grid.ColumnSpan="5"
                            Margin="0,14,0,0"
                            Padding="16"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            AllowDrop="True"
                            DragEnter="CudnnPackage_DragEnter"
                            DragOver="CudnnPackage_DragEnter"
                            Drop="CudnnPackage_Drop">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="ArrowDownload24"
                                           FontSize="24"
                                           Margin="0,0,12,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="拖入 cuDNN zip 安装包"
                                           Style="{StaticResource CyanSectionTitleStyle}"
                                           FontSize="15"/>
                                <TextBlock Text="{Binding CudnnPackageStatus, Converter={StaticResource LocalizedTextConverter}}"
                                           Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <ui:Button Grid.Column="2"
                                    Command="{Binding SelectCudnnPackageCommand}"
                                    Style="{StaticResource CyanCommandButtonStyle}"
                                    Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Open24"
                                                   Margin="0,0,6,0"/>
                                    <TextBlock Text="选择 zip"/>
                                </StackPanel>
                            </ui:Button>
                        </Grid>
                    </Border>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="2"
                      Header="NVIDIA 驱动应用"
                      Margin="0,0,0,12"
                      Style="{StaticResource CyanGroupBoxStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding NvidiaAppStatus, Converter={StaticResource LocalizedTextConverter}}"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               VerticalAlignment="Center"/>
                    <ui:Button Grid.Column="1"
                            Command="{Binding RefreshNvidiaAppStatusCommand}"
                            Style="{StaticResource CyanCommandButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24"
                                           Margin="0,0,6,0"/>
                            <TextBlock Text="重新检测"/>
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Grid.Column="2"
                            Command="{Binding OpenNvidiaAppPageCommand}"
                            Style="{StaticResource CyanCommandButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Open24"
                                           Margin="0,0,6,0"/>
                            <TextBlock Text="NVIDIA App"/>
                        </StackPanel>
                    </ui:Button>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="3"
                      Header="训练后端部署"
                      Margin="0,0,0,12"
                      Style="{StaticResource CyanGroupBoxStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="完整的训练后端安装中心：管理 Windows 与 WSL2 训练后端、独立 Python/conda 环境、镜像源、代理、校验、更新和重装。"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               TextWrapping="Wrap"/>

                    <Grid Grid.Row="1"
                          Margin="0,12,0,0">
                        <TextBlock Text="{Binding TrainingDeploymentStatus, Converter={StaticResource LocalizedTextConverter}}"
                                   Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </Grid>

                    <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                        <ui:Button Command="{Binding DeployAllTrainingBackendsCommand}"
                                Style="{StaticResource CyanPrimaryActionButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowDownload24" Margin="0,0,6,0"/>
                                <TextBlock Text="一键部署全部后端"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Command="{Binding CancelTrainingDeploymentCommand}"
                                Style="{StaticResource CyanCommandButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DismissCircle24" Margin="0,0,6,0"/>
                                <TextBlock Text="中止当前任务"/>
                            </StackPanel>
                        </ui:Button>
                    </WrapPanel>
                </Grid>
            </GroupBox>

            <GroupBox x:Name="RuntimePathBindingSection"
                      Grid.Row="4"
                      Header="运行环境路径绑定"
                      Margin="0,0,0,12"
                      Style="{StaticResource CyanGroupBoxStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.8*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.ColumnSpan="4"
                               Text="统一管理四个训练后端以及 ComfyUI、Webui Forge Neo 的 Windows / WSL2 路径。内置兼容路径只读且不代表已经安装；自定义绑定可新增、编辑和删除。"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               TextWrapping="Wrap"/>

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="已绑定运行环境" Style="{StaticResource CyanFormLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding TrainingBackendBindings}"
                                  SelectedItem="{Binding SelectedTrainingBackendBinding}"
                                  ToolTip="{Binding SelectedTrainingBackendBinding, Converter={StaticResource TrainingBackendBindingTextConverter}, ConverterParameter=LocationSummary}"
                                  MinHeight="32"
                                  MinWidth="390">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource TrainingBackendBindingTextConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <WrapPanel Grid.Row="1" Grid.Column="3" Margin="10,10,0,0">
                        <ui:Button Command="{Binding NewTrainingBackendBindingCommand}"
                                Style="{StaticResource CyanCommandButtonStyle}"
                                Content="新建绑定"/>
                        <ui:Button Command="{Binding SaveTrainingBackendBindingCommand}"
                                Style="{StaticResource CyanPrimaryActionButtonStyle}"
                                Content="保存绑定"/>
                        <ui:Button Command="{Binding DeleteTrainingBackendBindingCommand}"
                                Style="{StaticResource CyanCommandButtonStyle}"
                                Content="删除绑定"/>
                    </WrapPanel>

                    <StackPanel Grid.Row="2" Margin="0,10,10,0" IsEnabled="{Binding CanEditTrainingBackendBinding}">
                        <TextBlock Text="绑定名称" Style="{StaticResource CyanFormLabelStyle}"/>
                        <ui:TextBox Text="{Binding BindingName, UpdateSourceTrigger=PropertyChanged}" MinHeight="32"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,10,10,0" IsEnabled="{Binding CanEditTrainingBackendBinding}">
                        <TextBlock Text="运行环境类型" Style="{StaticResource CyanFormLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding BindingBackendOptions}"
                                  SelectedItem="{Binding SelectedBindingBackend}"
                                  MinHeight="32">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label, Converter={StaticResource LocalizedTextConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,10,10,0" IsEnabled="{Binding CanEditTrainingBackendBinding}">
                        <TextBlock Text="WSL 发行版（仅 WSL）" Style="{StaticResource CyanFormLabelStyle}"/>
                        <ui:TextBox Text="{Binding BindingWslDistribution, UpdateSourceTrigger=PropertyChanged}" MinHeight="32"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="3" Margin="0,10,0,0" IsEnabled="{Binding CanEditTrainingBackendBinding}">
                        <TextBlock Text="Conda 环境（仅 WSL）" Style="{StaticResource CyanFormLabelStyle}"/>
                        <ui:TextBox Text="{Binding BindingCondaEnvironment, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" Width="170"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Text="{Binding BindingRootDirectoryLabel, Converter={StaticResource LocalizedTextConverter}}" Style="{StaticResource CyanFormLabelStyle}" Margin="0,10,0,0"/>
                    <ui:TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                             Text="{Binding BindingTrainerPath, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanEditTrainingBackendBinding}"
                             MinHeight="32" Margin="0,10,10,0"/>
                    <WrapPanel Grid.Row="3" Grid.Column="3" Margin="0,10,0,0">
                        <ui:Button Command="{Binding SelectBindingTrainerPathCommand}"
                                Style="{StaticResource CyanCommandButtonStyle}"
                                Content="选择目录"/>
                        <ui:Button Command="{Binding OpenBindingTrainerPathCommand}"
                                Style="{StaticResource CyanCommandButtonStyle}"
                                Content="打开"/>
                    </WrapPanel>

                    <TextBlock Grid.Row="4" Text="{Binding BindingConfigurationDirectoryLabel, Converter={StaticResource LocalizedTextConverter}}" Style="{StaticResource CyanFormLabelStyle}" Margin="0,10,0,0"/>
                    <ui:TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                             Text="{Binding BindingConfigurationDirectory, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanEditTrainingBackendBinding}"
                             MinHeight="32" Margin="0,10,10,0"/>
                    <WrapPanel Grid.Row="4" Grid.Column="3" Margin="0,10,0,0">
                        <ui:Button Command="{Binding SelectBindingConfigurationDirectoryCommand}"
                                Style="{StaticResource CyanCommandButtonStyle}"
                                Content="选择目录"/>
                        <ui:Button Command="{Binding OpenBindingConfigurationDirectoryCommand}"
                                Style="{StaticResource CyanCommandButtonStyle}"
                                Content="打开"/>
                    </WrapPanel>

                    <TextBlock Grid.Row="5" Grid.ColumnSpan="4"
                               Text="{Binding BindingCapabilityText, Converter={StaticResource LocalizedTextConverter}}"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>
                    <DockPanel Grid.Row="6" Grid.ColumnSpan="4" Margin="0,10,0,0">
                        <ui:Button DockPanel.Dock="Right"
                                Command="{Binding CheckPathBindingCommand}"
                                Style="{StaticResource CyanCommandButtonStyle}"
                                Content="检测绑定路径"/>
                        <TextBlock Text="{Binding PathBindingStatus, Converter={StaticResource LocalizedTextConverter}}"
                                   Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                    </DockPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="5"
                      Header="WSL 基础环境"
                      Margin="0,0,0,12"
                      Style="{StaticResource CyanGroupBoxStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding WslStatus, Converter={StaticResource LocalizedTextConverter}}"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               TextWrapping="Wrap"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="安装镜像源" Style="{StaticResource CyanFormLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding TrainingBackendMirrorOptions}"
                                  SelectedItem="{Binding SelectedWslMirror}"
                                  Width="180" MinHeight="32">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Label, Converter={StaticResource LocalizedTextConverter}}"/></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                        <ui:Button Command="{Binding CheckTrainingBackendCommand}"
                                CommandParameter="wsl"
                                Style="{StaticResource CyanCommandButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" Margin="0,0,6,0"/>
                                <TextBlock Text="检测 WSL 环境"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Command="{Binding InstallWslCommand}"
                                Style="{StaticResource CyanCommandButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowDownload24"
                                               Margin="0,0,6,0"/>
                                <TextBlock Text="安装 WSL"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Command="{Binding InstallUbuntuCommand}"
                                Style="{StaticResource CyanCommandButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowDownload24"
                                               Margin="0,0,6,0"/>
                                <TextBlock Text="安装 Ubuntu 子系统"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Command="{Binding ValidateTrainingBackendCommand}"
                                CommandParameter="wsl"
                                Style="{StaticResource CyanCommandButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" Margin="0,0,6,0"/>
                                <TextBlock Text="校验"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Command="{Binding DeleteUbuntuCommand}"
                                Style="{StaticResource CyanCommandButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Delete24"
                                               Margin="0,0,6,0"/>
                                <TextBlock Text="删除 Ubuntu"/>
                            </StackPanel>
                        </ui:Button>
                    </WrapPanel>
                </Grid>
            </GroupBox>

            <GroupBox x:Name="SdScriptsDeploymentSection"
                      Grid.Row="6"
                      Header="Windows sd-scripts 部署"
                      Margin="0,0,0,12"
                      Focusable="True"
                      Style="{StaticResource CyanGroupBoxStyle}">
                <Border Style="{StaticResource CyanCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="sd-scripts Windows" Style="{StaticResource CyanSectionTitleStyle}" FontSize="15"/>
                            <TextBlock Text="支持 LoRA、LyCORIS、DoRA、LoHa、LoKr 与 Anima；优先复用 Python 3.10/3.11/3.12，无兼容版本时由 uv 准备 3.10。" Style="{StaticResource CyanSecondaryTextBlockStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding SdScriptsStatus, Converter={StaticResource LocalizedTextConverter}}" Style="{StaticResource CyanSecondaryTextBlockStyle}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <WrapPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <ui:Button Command="{Binding CheckTrainingBackendCommand}" CommandParameter="sd-scripts" Style="{StaticResource CyanCommandButtonStyle}" Content="检测"/>
                            <ui:Button Command="{Binding InstallTrainingBackendCommand}" CommandParameter="sd-scripts" Style="{StaticResource CyanPrimaryActionButtonStyle}" Content="安装"/>
                            <ui:Button Command="{Binding ValidateTrainingBackendCommand}" CommandParameter="sd-scripts" Style="{StaticResource CyanCommandButtonStyle}" Content="校验"/>
                            <ui:Button Command="{Binding UpdateTrainingBackendCommand}" CommandParameter="sd-scripts" Style="{StaticResource CyanCommandButtonStyle}" Content="更新"/>
                            <ui:Button Command="{Binding ReinstallTrainingBackendCommand}" CommandParameter="sd-scripts" Style="{StaticResource CyanCommandButtonStyle}" Content="重装"/>
                        </WrapPanel>
                    </Grid>
                </Border>
            </GroupBox>

            <GroupBox x:Name="AnimaFastLoraDeploymentSection"
                      Grid.Row="7"
                      Header="Windows Anima Fast LoRA 部署"
                      Margin="0,0,0,12"
                      Focusable="True"
                      Style="{StaticResource CyanGroupBoxStyle}">
                <Border Style="{StaticResource CyanCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Anima Fast LoRA Windows" Style="{StaticResource CyanSectionTitleStyle}" FontSize="15"/>
                            <TextBlock Text="克隆 GALIAIS/LoraHub，仅部署 external/anima_lora 训练核心，并使用 uv 创建 Python 3.13 独立环境。" Style="{StaticResource CyanSecondaryTextBlockStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding AnimaFastLoraStatus, Converter={StaticResource LocalizedTextConverter}}" Style="{StaticResource CyanSecondaryTextBlockStyle}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <WrapPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <ui:Button Command="{Binding CheckTrainingBackendCommand}" CommandParameter="anima-fast-lora" Style="{StaticResource CyanCommandButtonStyle}" Content="检测"/>
                            <ui:Button Command="{Binding InstallTrainingBackendCommand}" CommandParameter="anima-fast-lora" Style="{StaticResource CyanPrimaryActionButtonStyle}" Content="安装"/>
                            <ui:Button Command="{Binding ValidateTrainingBackendCommand}" CommandParameter="anima-fast-lora" Style="{StaticResource CyanCommandButtonStyle}" Content="校验"/>
                            <ui:Button Command="{Binding UpdateTrainingBackendCommand}" CommandParameter="anima-fast-lora" Style="{StaticResource CyanCommandButtonStyle}" Content="更新"/>
                            <ui:Button Command="{Binding ReinstallTrainingBackendCommand}" CommandParameter="anima-fast-lora" Style="{StaticResource CyanCommandButtonStyle}" Content="重装"/>
                        </WrapPanel>
                    </Grid>
                </Border>
            </GroupBox>

            <GroupBox x:Name="WslSdScriptsDeploymentSection" Grid.Row="8" Header="WSL sd-scripts 部署" Margin="0,0,0,12" Focusable="True" Style="{StaticResource CyanGroupBoxStyle}">
                <Border Style="{StaticResource CyanCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="wsl-sd-scripts" Style="{StaticResource CyanSectionTitleStyle}" FontSize="15"/>
                            <TextBlock Text="在 Ubuntu 中部署 sd-scripts、Python 3.10、torch cu128、LyCORIS 和 accelerate，并执行 1 step / 1 epoch smoke。" Style="{StaticResource CyanSecondaryTextBlockStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding WslSdScriptsStatus, Converter={StaticResource LocalizedTextConverter}}" Style="{StaticResource CyanSecondaryTextBlockStyle}" Margin="0,4,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="安装镜像源" Style="{StaticResource CyanFormLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding TrainingBackendMirrorOptions}" SelectedItem="{Binding SelectedWslSdScriptsMirror}" Width="150" MinHeight="30" Margin="0,0,10,0"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label, Converter={StaticResource LocalizedTextConverter}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                <TextBlock Text="本地代理端口" Style="{StaticResource CyanFormLabelStyle}"/>
                                <ui:TextBox Text="{Binding WslSdScriptsProxyPort, UpdateSourceTrigger=PropertyChanged}" Width="90" MinHeight="30"/>
                            </StackPanel>
                        </StackPanel>
                        <WrapPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <ui:Button Command="{Binding CheckTrainingBackendCommand}" CommandParameter="wsl-sd-scripts" Style="{StaticResource CyanCommandButtonStyle}" Content="检测"/>
                            <ui:Button Command="{Binding InstallTrainingBackendCommand}" CommandParameter="wsl-sd-scripts" Style="{StaticResource CyanPrimaryActionButtonStyle}" Content="安装"/>
                            <ui:Button Command="{Binding ValidateTrainingBackendCommand}" CommandParameter="wsl-sd-scripts" Style="{StaticResource CyanCommandButtonStyle}" Content="校验"/>
                            <ui:Button Command="{Binding UpdateTrainingBackendCommand}" CommandParameter="wsl-sd-scripts" Style="{StaticResource CyanCommandButtonStyle}" Content="更新"/>
                            <ui:Button Command="{Binding ReinstallTrainingBackendCommand}" CommandParameter="wsl-sd-scripts" Style="{StaticResource CyanCommandButtonStyle}" Content="重装"/>
                        </WrapPanel>
                    </Grid>
                </Border>
            </GroupBox>

            <GroupBox x:Name="DiffusionPipeDeploymentSection" Grid.Row="9" Header="WSL diffusion-pipe 部署" Margin="0,0,0,12" Focusable="True" Style="{StaticResource CyanGroupBoxStyle}">
                <Border Style="{StaticResource CyanCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="diffusion-pipe" Style="{StaticResource CyanSectionTitleStyle}" FontSize="15"/>
                            <TextBlock Text="部署 tdrussell/diffusion-pipe、cu128 conda 环境、torch、flash-attn、Anima 补丁与 1 step smoke 训练。" Style="{StaticResource CyanSecondaryTextBlockStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding DiffusionPipeStatus, Converter={StaticResource LocalizedTextConverter}}" Style="{StaticResource CyanSecondaryTextBlockStyle}" Margin="0,4,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="安装镜像源" Style="{StaticResource CyanFormLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding TrainingBackendMirrorOptions}" SelectedItem="{Binding SelectedDiffusionPipeMirror}" Width="150" MinHeight="30" Margin="0,0,10,0"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label, Converter={StaticResource LocalizedTextConverter}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                <TextBlock Text="本地代理端口" Style="{StaticResource CyanFormLabelStyle}"/>
                                <ui:TextBox Text="{Binding DiffusionPipeProxyPort, UpdateSourceTrigger=PropertyChanged}" Width="90" MinHeight="30"/>
                            </StackPanel>
                        </StackPanel>
                        <WrapPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <ui:Button Command="{Binding CheckTrainingBackendCommand}" CommandParameter="diffusion-pipe" Style="{StaticResource CyanCommandButtonStyle}" Content="检测"/>
                            <ui:Button Command="{Binding InstallTrainingBackendCommand}" CommandParameter="diffusion-pipe" Style="{StaticResource CyanPrimaryActionButtonStyle}" Content="安装"/>
                            <ui:Button Command="{Binding ValidateTrainingBackendCommand}" CommandParameter="diffusion-pipe" Style="{StaticResource CyanCommandButtonStyle}" Content="校验"/>
                            <ui:Button Command="{Binding UpdateTrainingBackendCommand}" CommandParameter="diffusion-pipe" Style="{StaticResource CyanCommandButtonStyle}" Content="更新"/>
                            <ui:Button Command="{Binding ReinstallTrainingBackendCommand}" CommandParameter="diffusion-pipe" Style="{StaticResource CyanCommandButtonStyle}" Content="重装"/>
                        </WrapPanel>
                    </Grid>
                </Border>
            </GroupBox>

            <GroupBox x:Name="ComfyUiWindowsDeploymentSection" Grid.Row="10" Header="ComfyUI（Windows）部署" Margin="0,0,0,12" Focusable="True" Style="{StaticResource CyanGroupBoxStyle}">
                <Border Style="{StaticResource CyanCardStyle}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ComfyUI（Windows）" Style="{StaticResource CyanSectionTitleStyle}" FontSize="15"/><TextBlock Text="使用路径管理中的优先 ComfyUI Windows 绑定检测程序根目录和 main.py。" Style="{StaticResource CyanSecondaryTextBlockStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="{Binding ComfyUiWindowsStatus, Converter={StaticResource LocalizedTextConverter}}" Style="{StaticResource CyanSecondaryTextBlockStyle}" Margin="0,4,0,0"/></StackPanel><WrapPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><ui:Button Command="{Binding CheckInferenceBackendCommand}" CommandParameter="comfyui-windows" Style="{StaticResource CyanCommandButtonStyle}" Content="检测"/><ui:Button Command="{Binding OpenInferenceBackendDirectoryCommand}" CommandParameter="comfyui-windows" Style="{StaticResource CyanCommandButtonStyle}" Content="打开目录"/></WrapPanel></Grid>
                </Border>
            </GroupBox>

            <GroupBox x:Name="ComfyUiWslDeploymentSection" Grid.Row="11" Header="ComfyUI（WSL）部署" Margin="0,0,0,12" Focusable="True" Style="{StaticResource CyanGroupBoxStyle}">
                <Border Style="{StaticResource CyanCardStyle}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ComfyUI（WSL）" Style="{StaticResource CyanSectionTitleStyle}" FontSize="15"/><TextBlock Text="使用路径管理中的优先 ComfyUI WSL 绑定检测 Ubuntu 路径、main.py 和 Conda 环境配置。" Style="{StaticResource CyanSecondaryTextBlockStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="{Binding ComfyUiWslStatus, Converter={StaticResource LocalizedTextConverter}}" Style="{StaticResource CyanSecondaryTextBlockStyle}" Margin="0,4,0,0"/></StackPanel><WrapPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><ui:Button Command="{Binding CheckInferenceBackendCommand}" CommandParameter="comfyui-wsl" Style="{StaticResource CyanCommandButtonStyle}" Content="检测"/><ui:Button Command="{Binding OpenInferenceBackendDirectoryCommand}" CommandParameter="comfyui-wsl" Style="{StaticResource CyanCommandButtonStyle}" Content="打开目录"/></WrapPanel></Grid>
                </Border>
            </GroupBox>

            <GroupBox x:Name="ForgeNeoWindowsDeploymentSection" Grid.Row="12" Header="Webui Forge Neo（Windows）部署" Margin="0,0,0,12" Focusable="True" Style="{StaticResource CyanGroupBoxStyle}">
                <Border Style="{StaticResource CyanCardStyle}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Webui Forge Neo（Windows）" Style="{StaticResource CyanSectionTitleStyle}" FontSize="15"/><TextBlock Text="使用路径管理中的优先 Forge Neo Windows 绑定检测程序根目录和 launch.py。" Style="{StaticResource CyanSecondaryTextBlockStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="{Binding ForgeNeoWindowsStatus, Converter={StaticResource LocalizedTextConverter}}" Style="{StaticResource CyanSecondaryTextBlockStyle}" Margin="0,4,0,0"/></StackPanel><WrapPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><ui:Button Command="{Binding CheckInferenceBackendCommand}" CommandParameter="forge-neo-windows" Style="{StaticResource CyanCommandButtonStyle}" Content="检测"/><ui:Button Command="{Binding OpenInferenceBackendDirectoryCommand}" CommandParameter="forge-neo-windows" Style="{StaticResource CyanCommandButtonStyle}" Content="打开目录"/></WrapPanel></Grid>
                </Border>
            </GroupBox>

            <GroupBox x:Name="ForgeNeoWslDeploymentSection" Grid.Row="13" Header="Webui Forge Neo（WSL）部署" Margin="0,0,0,12" Focusable="True" Style="{StaticResource CyanGroupBoxStyle}">
                <Border Style="{StaticResource CyanCardStyle}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Webui Forge Neo（WSL）" Style="{StaticResource CyanSectionTitleStyle}" FontSize="15"/><TextBlock Text="使用路径管理中的优先 Forge Neo WSL 绑定检测 Ubuntu 路径、launch.py 和 Conda 环境配置。" Style="{StaticResource CyanSecondaryTextBlockStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="{Binding ForgeNeoWslStatus, Converter={StaticResource LocalizedTextConverter}}" Style="{StaticResource CyanSecondaryTextBlockStyle}" Margin="0,4,0,0"/></StackPanel><WrapPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><ui:Button Command="{Binding CheckInferenceBackendCommand}" CommandParameter="forge-neo-wsl" Style="{StaticResource CyanCommandButtonStyle}" Content="检测"/><ui:Button Command="{Binding OpenInferenceBackendDirectoryCommand}" CommandParameter="forge-neo-wsl" Style="{StaticResource CyanCommandButtonStyle}" Content="打开目录"/></WrapPanel></Grid>
                </Border>
            </GroupBox>

            <GroupBox Grid.Row="14"
                      Header="日志"
                      Style="{StaticResource CyanGroupBoxStyle}">
                <ui:TextBox Text="{Binding LogText, Mode=OneWay}"
                         Style="{StaticResource CyanLogTextBoxStyle}"
                         TextChanged="DeploymentLogTextBox_TextChanged"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"/>
            </GroupBox>
        </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="代理">
                <ScrollViewer Style="{StaticResource CyanPageScrollViewerStyle}">
                    <Grid Style="{StaticResource CyanPageGridStyle}"
                          DataContext="{Binding ProxySettings}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <GroupBox Header="订阅链接"
                                  Style="{StaticResource CyanGroupBoxStyle}"
                                  Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Clash 订阅"
                                           Style="{StaticResource CyanFormLabelStyle}" />
                                <ui:TextBox Grid.Column="1"
                                            Text="{Binding SubscriptionUrl, UpdateSourceTrigger=PropertyChanged}"
                                            Margin="0,0,8,0" />
                                <ui:Button Grid.Column="2"
                                           Command="{Binding RefreshCommand}"
                                           Style="{StaticResource CyanPrimaryActionButtonStyle}"
                                           Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,6,0" />
                                        <TextBlock Text="更新节点" />
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button Grid.Column="3"
                                           Command="{Binding ClearSubscriptionCommand}"
                                           Style="{StaticResource CyanCommandButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Delete24" Margin="0,0,6,0" />
                                        <TextBlock Text="清空" />
                                    </StackPanel>
                                </ui:Button>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="1"
                                  Header="本地端口"
                                  Style="{StaticResource CyanGroupBoxStyle}"
                                  Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="HTTP / Mixed 端口"
                                           Style="{StaticResource CyanFormLabelStyle}" />
                                <ui:TextBox Grid.Column="1"
                                            Text="{Binding LocalHttpPort, UpdateSourceTrigger=PropertyChanged}"
                                            Margin="0,0,12,0" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding StatusText}"
                                           Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="2"
                                  Header="节点"
                                  Style="{StaticResource CyanGroupBoxStyle}">
                            <ui:ListView ItemsSource="{Binding Nodes}"
                                      SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                                      MinHeight="260"
                                      BorderThickness="0">
                                <ui:ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="名称" DisplayMemberBinding="{Binding DisplayName}" Width="260" />
                                        <GridViewColumn Header="协议" DisplayMemberBinding="{Binding Type}" Width="100" />
                                        <GridViewColumn Header="地址" DisplayMemberBinding="{Binding EndpointText}" Width="220" />
                                        <GridViewColumn Header="可用" DisplayMemberBinding="{Binding AvailabilityText}" Width="130" />
                                    </GridView>
                                </ui:ListView.View>
                            </ui:ListView>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
