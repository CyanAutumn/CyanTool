<UserControl x:Class="CyanTools.OptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="680"
             d:DesignWidth="920">
    <ScrollViewer Style="{StaticResource CyanPageScrollViewerStyle}">
        <Grid Style="{StaticResource CyanPageGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="320"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource CyanCardStyle}"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CyanIconBadgeStyle}"
                            Margin="0,0,14,0">
                        <ui:SymbolIcon Symbol="Settings24"
                                       FontSize="22"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="选项"
                                   Style="{StaticResource CyanSectionTitleStyle}" />
                        <TextBlock Text="管理本机运行环境与共享工具设置。"
                                   Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <GroupBox Grid.Row="1"
                      Header="CUDA / cuDNN"
                      Margin="0,0,0,12"
                      Style="{StaticResource CyanGroupBoxStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Command="{Binding CheckCudaCommand}"
                            Style="{StaticResource CyanPrimaryActionButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24"
                                           Margin="0,0,6,0"/>
                            <TextBlock Text="检查/安装 CUDA"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1"
                            Command="{Binding InstallCudaToolkitCommand}"
                            Style="{StaticResource CyanCommandButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowDownload24"
                                           Margin="0,0,6,0"/>
                            <TextBlock Text="安装 CUDA Toolkit"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2"
                            Command="{Binding OpenCudaCudnnPagesCommand}"
                            Style="{StaticResource CyanCommandButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Open24"
                                           Margin="0,0,6,0"/>
                            <TextBlock Text="CUDA/cuDNN 页面"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Grid.Row="1"
                               Grid.ColumnSpan="4"
                               Text="GPU 推理依赖 NVIDIA 驱动、CUDA 12.x、cuDNN 9，以及带 CUDA Provider 的 ONNX Runtime。cuDNN 可拖入 zip 自动复制到程序目录或 CUDA 12 bin。"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               Margin="0,12,0,0"/>

                    <Border Grid.Row="2"
                            Grid.ColumnSpan="4"
                            Margin="0,14,0,0"
                            Padding="16"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            AllowDrop="True"
                            DragEnter="CudnnPackage_DragEnter"
                            DragOver="CudnnPackage_DragEnter"
                            Drop="CudnnPackage_Drop">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="ArrowDownload24"
                                           FontSize="24"
                                           Margin="0,0,12,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="拖入 cuDNN zip 安装包"
                                           Style="{StaticResource CyanSectionTitleStyle}"
                                           FontSize="15"/>
                                <TextBlock Text="{Binding CudnnPackageStatus}"
                                           Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Command="{Binding SelectCudnnPackageCommand}"
                                    Style="{StaticResource CyanCommandButtonStyle}"
                                    Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Open24"
                                                   Margin="0,0,6,0"/>
                                    <TextBlock Text="选择 zip"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="2"
                      Header="NVIDIA 驱动应用"
                      Margin="0,0,0,12"
                      Style="{StaticResource CyanGroupBoxStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding NvidiaAppStatus}"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Command="{Binding RefreshNvidiaAppStatusCommand}"
                            Style="{StaticResource CyanCommandButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24"
                                           Margin="0,0,6,0"/>
                            <TextBlock Text="重新检测"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2"
                            Command="{Binding OpenNvidiaAppPageCommand}"
                            Style="{StaticResource CyanCommandButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Open24"
                                           Margin="0,0,6,0"/>
                            <TextBlock Text="NVIDIA App"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="3"
                      Header="diffusion-pipe / WSL2"
                      Margin="0,0,0,12"
                      Style="{StaticResource CyanGroupBoxStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="在 Ubuntu WSL2 中部署 tdrussell/diffusion-pipe：安装 WSL/Ubuntu、准备基础依赖、克隆仓库、创建 cu128 conda 环境、安装 torch/flash-attn、应用 Anima 补丁并执行 1 step smoke 训练。"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               TextWrapping="Wrap"/>

                    <Grid Grid.Row="1"
                          Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="镜像源"
                                   Style="{StaticResource CyanFormLabelStyle}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding DiffusionPipeMirrorOptions}"
                                  SelectedItem="{Binding SelectedDiffusionPipeMirror}"
                                  DisplayMemberPath="Label"
                                  MinHeight="32"
                                  Margin="0,0,14,0"/>

                        <TextBlock Grid.Column="2"
                                   Text="WSL 本地代理端口"
                                   Style="{StaticResource CyanFormLabelStyle}"/>
                        <TextBox Grid.Column="3"
                                 Text="{Binding DiffusionPipeProxyPort, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="32"
                                 Margin="0,0,14,0"/>

                        <TextBlock Grid.Column="4"
                                   Text="{Binding DiffusionPipeStatus}"
                                   Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </Grid>

                    <WrapPanel Grid.Row="2"
                               Margin="0,12,0,0">
                        <Button Command="{Binding CheckDiffusionPipeCommand}"
                                Style="{StaticResource CyanCommandButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24"
                                               Margin="0,0,6,0"/>
                                <TextBlock Text="检测 WSL 环境"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding InstallWslCommand}"
                                Style="{StaticResource CyanCommandButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowDownload24"
                                               Margin="0,0,6,0"/>
                                <TextBlock Text="安装 WSL"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding InstallUbuntuCommand}"
                                Style="{StaticResource CyanCommandButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowDownload24"
                                               Margin="0,0,6,0"/>
                                <TextBlock Text="安装 Ubuntu 子系统"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding InstallDiffusionPipeCommand}"
                                Style="{StaticResource CyanPrimaryActionButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowDownload24"
                                               Margin="0,0,6,0"/>
                                <TextBlock Text="安装 diffusion-pipe"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ValidateDiffusionPipeCommand}"
                                Style="{StaticResource CyanCommandButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24"
                                               Margin="0,0,6,0"/>
                                <TextBlock Text="校验"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding UpdateDiffusionPipeCommand}"
                                Style="{StaticResource CyanCommandButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowSync24"
                                               Margin="0,0,6,0"/>
                                <TextBlock Text="更新"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ReinstallDiffusionPipeCommand}"
                                Style="{StaticResource CyanCommandButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowSync24"
                                               Margin="0,0,6,0"/>
                                <TextBlock Text="重装"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DeleteUbuntuCommand}"
                                Style="{StaticResource CyanCommandButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Delete24"
                                               Margin="0,0,6,0"/>
                                <TextBlock Text="删除 Ubuntu"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="4"
                      Header="日志"
                      Style="{StaticResource CyanGroupBoxStyle}">
                <ListBox ItemsSource="{Binding LogLines}"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         HorizontalContentAlignment="Stretch"
                         Style="{StaticResource CyanListBoxSurfaceStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </Grid>
    </ScrollViewer>
</UserControl>
