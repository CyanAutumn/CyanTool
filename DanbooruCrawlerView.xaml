<UserControl x:Class="CyanTools.DanbooruCrawlerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utils="clr-namespace:CyanTools.Utils"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:CyanTools"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             mc:Ignorable="d"
             d:DesignHeight="620"
             d:DesignWidth="980"
             Background="Transparent">
    <Grid Style="{StaticResource CyanPageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CyanHeroPanelStyle}"
                Margin="0,0,0,14"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CyanIconBadgeStyle}"
                        Margin="0,0,16,0">
                    <ui:SymbolIcon Symbol="DatabaseSearch24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="数据集管理器"
                               Style="{StaticResource CyanPageTitleStyle}"
                               FontSize="30" />
                    <TextBlock Text="集中配置来源、令牌、标签和输出目录，下载任务进度显示在输出与执行区域下方。"
                               Style="{StaticResource CyanPageSubtitleStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Border Grid.Column="2"
                        Style="{StaticResource CyanPillStyle}"
                        VerticalAlignment="Center"
                        Margin="18,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CloudArrowDown24"
                                       FontSize="15"
                                       Margin="0,0,6,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Danbooru / Pixiv / Kemono"
                                   FontWeight="SemiBold"
                                   FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer Style="{StaticResource CyanPageScrollViewerStyle}">
              <StackPanel>
                <GroupBox Header="素材库管理" Style="{StaticResource CyanGroupBoxStyle}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="管理目录" />
                    <DockPanel Margin="0,6,0,10">
                      <ui:Button DockPanel.Dock="Right" Content="选择目录" Command="{Binding BrowseManagementDirectoryCommand}" />
                      <ui:TextBox Text="{Binding ManagementDirectory, UpdateSourceTrigger=LostFocus}" />
                    </DockPanel>
                    <TextBlock Text="素材文件夹名（支持 {name}、{artist}、{id}、{time}；输出到素材目录下的原图）" TextWrapping="Wrap" />
                    <ui:TextBox Text="{Binding MaterialFolderTemplate, UpdateSourceTrigger=LostFocus}" Margin="0,6,0,10" />
                    <WrapPanel>
                      <ui:Button Content="刷新素材库" Command="{Binding RefreshLibraryCommand}" Margin="0,0,8,0" />
                      <ui:Button Content="保存选中素材参数" Command="{Binding SaveMaterialCommand}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding LibraryStatus}" TextWrapping="Wrap" Margin="0,8,0,0" />
                  </StackPanel>
                </GroupBox>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0"
                              Header="下载目标"
                              Style="{StaticResource CyanGroupBoxStyle}"
                              Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="下载方式"
                                       Style="{StaticResource CyanFormLabelStyle}" />
                            <WrapPanel Grid.Column="1">
                                <RadioButton Content="画师 ID"
                                             GroupName="DownloadMode"
                                             IsChecked="{Binding IsArtistMode}"
                                             Margin="0,0,16,6" />
                                <RadioButton Content="标签"
                                             GroupName="DownloadMode"
                                             IsChecked="{Binding IsTagMode}"
                                             Margin="0,0,16,6" />
                                <RadioButton Content="帖子 ID"
                                             GroupName="DownloadMode"
                                             IsChecked="{Binding IsPostIdMode}"
                                             Margin="0,0,16,6" />
                            </WrapPanel>

                            <TextBlock Grid.Row="1"
                                       Text="来源"
                                       Style="{StaticResource CyanFormLabelStyle}"
                                       Margin="0,10,10,0" />
                            <WrapPanel Grid.Row="1"
                                       Grid.Column="1"
                                       Margin="0,10,0,0">
                                <CheckBox Content="Danbooru"
                                          IsChecked="{Binding EnableDanbooru}"
                                          Margin="0,0,16,6" />
                                <CheckBox Content="Pixiv"
                                          IsChecked="{Binding EnablePixiv}"
                                          IsEnabled="{Binding CanSelectAllSources}"
                                          Margin="0,0,16,6" />
                                <CheckBox Content="Kemono"
                                          IsChecked="{Binding EnableKemono}"
                                          IsEnabled="{Binding CanSelectAllSources}"
                                          Margin="0,0,16,6" />
                            </WrapPanel>

                            <TextBlock Grid.Row="2"
                                       Text="ID / 标签"
                                       Style="{StaticResource CyanFormLabelStyle}"
                                       Margin="0,10,10,0" />
                            <ui:TextBox Grid.Row="2"
                                     Grid.Column="1"
                                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,10,0,0" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="1"
                              Header="Danbooru"
                              Style="{StaticResource CyanGroupBoxStyle}"
                              Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="令牌"
                                       Style="{StaticResource CyanFormLabelStyle}" />
                            <ui:TextBox Grid.Column="1"
                                     Text="{Binding DanbooruToken, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanEditDanbooruSettings}" />

                            <TextBlock Grid.Row="1"
                                       Text="标签"
                                       Style="{StaticResource CyanFormLabelStyle}"
                                       Margin="0,10,10,0" />
                            <WrapPanel Grid.Row="1"
                                       Grid.Column="1"
                                       IsEnabled="{Binding CanEditDanbooruSettings}"
                                       Margin="0,10,0,0">
                                <CheckBox Content="Artist" IsChecked="{Binding IncludeArtist}" Margin="0,0,12,6" />
                                <CheckBox Content="Copyright" IsChecked="{Binding IncludeCopyright}" Margin="0,0,12,6" />
                                <CheckBox Content="Character" IsChecked="{Binding IncludeCharacter}" Margin="0,0,12,6" />
                                <CheckBox Content="General" IsChecked="{Binding IncludeGeneral}" Margin="0,0,12,6" />
                                <CheckBox Content="Meta" IsChecked="{Binding IncludeMeta}" Margin="0,0,12,6" />
                            </WrapPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="2"
                              Header="Pixiv"
                              Style="{StaticResource CyanGroupBoxStyle}"
                              Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="令牌列表"
                                       Style="{StaticResource CyanFormLabelStyle}" />
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ListBox ItemsSource="{Binding PixivTokens}"
                                         SelectedItem="{Binding SelectedPixivToken, Mode=TwoWay}"
                                         MinHeight="54"
                                         MaxHeight="110"
                                         BorderThickness="0">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="IsEnabled" Value="True" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInUse}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel MinWidth="260">
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding StatusText}"
                                                           Style="{StaticResource CyanTinyTextBlockStyle}" />
                                                <TextBlock Text="{Binding DisplayName}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Top"
                                            Margin="8,0,0,0">
                                    <ui:Button Command="{Binding AddPixivTokenCommand}"
                                               Style="{StaticResource CyanCommandButtonStyle}"
                                               ToolTip="添加 Pixiv 令牌">
                                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Add24" Margin="0,0,5,0"/><TextBlock Text="添加"/></StackPanel>
                                    </ui:Button>
                                    <ui:Button Command="{Binding DeletePixivTokenCommand}"
                                               Style="{StaticResource CyanCommandButtonStyle}"
                                               ToolTip="删除选中的 Pixiv 令牌">
                                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Delete24" Margin="0,0,5,0"/><TextBlock Text="删除"/></StackPanel>
                                    </ui:Button>
                                    <ui:Button Command="{Binding VerifyPixivTokenCommand}"
                                               Style="{StaticResource CyanCommandButtonStyle}"
                                               ToolTip="在独立浏览器数据目录中打开 Pixiv 验证页面">
                                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="CheckmarkCircle24" Margin="0,0,5,0"/><TextBlock Text="验证"/></StackPanel>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>

                            <TextBlock Grid.Row="1"
                                       Text="节点"
                                       Style="{StaticResource CyanFormLabelStyle}"
                                       Margin="0,10,10,0" />
                            <ComboBox Grid.Row="1"
                                      Grid.Column="1"
                                      ItemsSource="{Binding ProxyNodes}"
                                      SelectedItem="{Binding SelectedProxyNode, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      Margin="0,10,0,0" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="3"
                              Header="输出与执行"
                              Style="{StaticResource CyanGroupBoxStyle}"
                              Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="输出格式" Style="{StaticResource CyanFormLabelStyle}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding OutputFormats}" SelectedItem="{Binding OutputFormat}" />
                            <CheckBox Grid.Row="1" Grid.Column="1" Content="不下载本地已有图片（检查同名不同后缀）" IsChecked="{Binding SkipExisting}" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="2"
                                       Text="请求间隔"
                                       Style="{StaticResource CyanFormLabelStyle}"
                                       Margin="0,12,10,0" />
                            <Grid Grid.Row="2"
                                  Grid.Column="1"
                                  Grid.ColumnSpan="2"
                                  Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Text="{Binding DownloadIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="1"
                                           Text="秒；适用于图片、附件、分页和补充内容等全部远端请求"
                                           Style="{StaticResource CyanTinyTextBlockStyle}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </Grid>

                            <WrapPanel Grid.Row="3"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="2"
                                       Margin="0,14,0,0">
                                <ui:Button Command="{Binding StartStopCommand}"
                                        Style="{StaticResource CyanPrimaryActionButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="PlayCircle24"
                                                       Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding StartButtonText, Converter={StaticResource LocalizedTextConverter}}" />
                                    </StackPanel>
                                </ui:Button>

                            </WrapPanel>

                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="4"
                              Header="素材库"
                              Style="{StaticResource CyanGroupBoxStyle}">
                        <ListBox ItemsSource="{Binding DownloadTasks}" SelectedItem="{Binding SelectedMaterial, Mode=TwoWay}" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CyanCardStyle}"
                                            Padding="12"
                                            ToolTip="{Binding MaterialDirectory}"
                                            Margin="0,0,0,10">
                                        <Border.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="打开素材目录" Click="OpenMaterialDirectory_Click" />
                                                <MenuItem Header="格式转换" Click="ConvertMaterial_Click" />
                                        <Separator />
                                        <MenuItem Header="同源图片归类" Tag="SameSource" Click="ClassifyMaterial_Click" />
                                        <MenuItem Header="图片分辨率归类" Tag="ResolutionBuckets" Click="ClassifyMaterial_Click" />
                                        <MenuItem Header="分辨率筛选" Tag="ResolutionFilter" Click="ClassifyMaterial_Click" />
                                        <MenuItem Header="图片聚类" Tag="Clustering" Click="ClassifyMaterial_Click" />
                                        <MenuItem Header="美学评分" Tag="Aesthetic" Click="ClassifyMaterial_Click" />
                                        <MenuItem Header="远景图检测" Tag="FarScene" Click="ClassifyMaterial_Click" />
                                        <MenuItem Header="还原原图" Click="RestoreMaterial_Click" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding ArtistName}"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <ComboBox ItemsSource="{Binding FolderChoices}" SelectedItem="{Binding SelectedFolder, Mode=TwoWay}" Margin="0,6,0,4" ToolTip="选择素材子文件夹" />
                                                <TextBlock Text="{Binding PixivId}"
                                                           Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                                           Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding StatusText, Converter={StaticResource LocalizedTextConverter}}"
                                                           Style="{StaticResource CyanTinyTextBlockStyle}"
                                                           Margin="0,8,0,0" />
                                                <TextBlock Text="{Binding SelectedProxyName}"
                                                           Style="{StaticResource CyanTinyTextBlockStyle}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="14,0,14,0">
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Style.Triggers><DataTrigger Binding="{Binding EnableDanbooru}" Value="False"><Setter Property="Opacity" Value="0.35" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="Danbooru" VerticalAlignment="Center" />
                                                    <ProgressBar Grid.Column="1" Height="12" Maximum="100" Value="{Binding DanbooruPercent, Mode=OneWay}" VerticalAlignment="Center" Margin="8,0" IsEnabled="{Binding EnableDanbooru}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding DanbooruProgressText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Style.Triggers><DataTrigger Binding="{Binding EnablePixiv}" Value="False"><Setter Property="Opacity" Value="0.35" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="Pixiv" VerticalAlignment="Center" />
                                                    <ProgressBar Grid.Column="1" Height="12" Maximum="100" Value="{Binding PixivPercent, Mode=OneWay}" VerticalAlignment="Center" Margin="8,0" IsEnabled="{Binding EnablePixiv}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding PixivProgressText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Grid>
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Style.Triggers><DataTrigger Binding="{Binding EnableKemono}" Value="False"><Setter Property="Opacity" Value="0.35" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="Kemono" VerticalAlignment="Center" />
                                                    <ProgressBar Grid.Column="1" Height="12" Maximum="100" Value="{Binding KemonoPercent, Mode=OneWay}" VerticalAlignment="Center" Margin="8,0" IsEnabled="{Binding EnableKemono}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding KemonoProgressText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </StackPanel>
                                            <ui:Button Grid.Column="2"
                                                       Command="{Binding StopCommand}"
                                                       VerticalAlignment="Top">
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource CyanCommandButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Stop24" Margin="0,0,5,0"/><TextBlock Text="停止"/></StackPanel>
                                            </ui:Button>
                                            <ui:Button Grid.Column="2"
                                                       Command="{Binding CheckCommand}"
                                                       VerticalAlignment="Top">
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource CyanCommandButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,5,0"/><TextBlock Text="检查"/></StackPanel>
                                            </ui:Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </GroupBox>
                </Grid>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
