<UserControl x:Class="CyanTools.DanbooruCrawlerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utils="clr-namespace:CyanTools.Utils"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:CyanTools"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             mc:Ignorable="d"
             d:DesignHeight="620"
             d:DesignWidth="980"
             Background="Transparent">
    <Grid Style="{StaticResource CyanPageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CyanHeroPanelStyle}"
                Margin="0,0,0,14"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CyanIconBadgeStyle}"
                        Margin="0,0,16,0">
                    <ui:SymbolIcon Symbol="DatabaseSearch24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="数据集下载器"
                               Style="{StaticResource CyanPageTitleStyle}"
                               FontSize="30" />
                    <TextBlock Text="集中配置来源、令牌、标签和输出目录，下载统计与日志显示在输出与执行区域下方。"
                               Style="{StaticResource CyanPageSubtitleStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Border Grid.Column="2"
                        Style="{StaticResource CyanPillStyle}"
                        VerticalAlignment="Center"
                        Margin="18,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CloudArrowDown24"
                                       FontSize="15"
                                       Margin="0,0,6,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Danbooru / Pixiv / Kemono"
                                   FontWeight="SemiBold"
                                   FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer Style="{StaticResource CyanPageScrollViewerStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0"
                              Header="下载目标"
                              Style="{StaticResource CyanGroupBoxStyle}"
                              Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="下载方式"
                                       Style="{StaticResource CyanFormLabelStyle}" />
                            <WrapPanel Grid.Column="1">
                                <RadioButton Content="画师 ID"
                                             GroupName="DownloadMode"
                                             IsChecked="{Binding IsArtistMode}"
                                             Margin="0,0,16,6" />
                                <RadioButton Content="标签"
                                             GroupName="DownloadMode"
                                             IsChecked="{Binding IsTagMode}"
                                             Margin="0,0,16,6" />
                                <RadioButton Content="帖子 ID"
                                             GroupName="DownloadMode"
                                             IsChecked="{Binding IsPostIdMode}"
                                             Margin="0,0,16,6" />
                            </WrapPanel>

                            <TextBlock Grid.Row="1"
                                       Text="来源"
                                       Style="{StaticResource CyanFormLabelStyle}"
                                       Margin="0,10,10,0" />
                            <WrapPanel Grid.Row="1"
                                       Grid.Column="1"
                                       Margin="0,10,0,0">
                                <CheckBox Content="Danbooru"
                                          IsChecked="{Binding EnableDanbooru}"
                                          Margin="0,0,16,6" />
                                <CheckBox Content="Pixiv"
                                          IsChecked="{Binding EnablePixiv}"
                                          IsEnabled="{Binding CanSelectAllSources}"
                                          Margin="0,0,16,6" />
                                <CheckBox Content="Kemono"
                                          IsChecked="{Binding EnableKemono}"
                                          IsEnabled="{Binding CanSelectAllSources}"
                                          Margin="0,0,16,6" />
                            </WrapPanel>

                            <TextBlock Grid.Row="2"
                                       Text="ID / 标签"
                                       Style="{StaticResource CyanFormLabelStyle}"
                                       Margin="0,10,10,0" />
                            <TextBox Grid.Row="2"
                                     Grid.Column="1"
                                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,10,0,0" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="1"
                              Header="Danbooru"
                              Style="{StaticResource CyanGroupBoxStyle}"
                              Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="令牌"
                                       Style="{StaticResource CyanFormLabelStyle}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding DanbooruToken, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanEditDanbooruSettings}" />

                            <TextBlock Grid.Row="1"
                                       Text="标签"
                                       Style="{StaticResource CyanFormLabelStyle}"
                                       Margin="0,10,10,0" />
                            <WrapPanel Grid.Row="1"
                                       Grid.Column="1"
                                       IsEnabled="{Binding CanEditDanbooruSettings}"
                                       Margin="0,10,0,0">
                                <CheckBox Content="Artist" IsChecked="{Binding IncludeArtist}" Margin="0,0,12,6" />
                                <CheckBox Content="Copyright" IsChecked="{Binding IncludeCopyright}" Margin="0,0,12,6" />
                                <CheckBox Content="Character" IsChecked="{Binding IncludeCharacter}" Margin="0,0,12,6" />
                                <CheckBox Content="General" IsChecked="{Binding IncludeGeneral}" Margin="0,0,12,6" />
                                <CheckBox Content="Meta" IsChecked="{Binding IncludeMeta}" Margin="0,0,12,6" />
                            </WrapPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="2"
                              Header="Pixiv"
                              Style="{StaticResource CyanGroupBoxStyle}"
                              Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="令牌"
                                       Style="{StaticResource CyanFormLabelStyle}" />
                            <PasswordBox Grid.Column="1"
                                         utils:PasswordBoxHelper.BindPassword="True"
                                         utils:PasswordBoxHelper.BoundPassword="{Binding PixivRefreshToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="2"
                                    Command="{Binding GetPixivRefreshTokenCommand}"
                                    Style="{StaticResource CyanCommandButtonStyle}"
                                    Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Key24"
                                                   Margin="0,0,6,0" />
                                    <TextBlock Text="登录获取" />
                                </StackPanel>
                            </Button>

                            <TextBlock Grid.Row="1"
                                       Text="下载间隔"
                                       Style="{StaticResource CyanFormLabelStyle}"
                                       Margin="0,10,10,0" />
                            <Grid Grid.Row="1"
                                  Grid.Column="1"
                                  Grid.ColumnSpan="2"
                                  Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding PixivDownloadIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="1"
                                           Text="秒"
                                           Style="{StaticResource CyanTinyTextBlockStyle}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </Grid>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="3"
                              Header="输出与执行"
                              Style="{StaticResource CyanGroupBoxStyle}"
                              Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="输出目录"
                                       Style="{StaticResource CyanFormLabelStyle}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,8,0" />
                            <Button Grid.Column="2"
                                    Command="{Binding BrowseOutputFolderCommand}"
                                    Style="{StaticResource CyanCommandButtonStyle}"
                                    Margin="0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FolderOpen24"
                                                   Margin="0,0,6,0" />
                                    <TextBlock Text="选择目录" />
                                </StackPanel>
                            </Button>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="2"
                                       Text="可用占位符: {time} {id} {name}"
                                       Style="{StaticResource CyanTinyTextBlockStyle}"
                                       Margin="0,8,0,0" />

                            <WrapPanel Grid.Row="2"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="2"
                                       Margin="0,14,0,0">
                                <Button Command="{Binding StartStopCommand}"
                                        Style="{StaticResource CyanPrimaryActionButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="PlayCircle24"
                                                       Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding StartButtonText}" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ClearLogCommand}"
                                        Style="{StaticResource CyanCommandButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Broom24"
                                                       Margin="0,0,6,0" />
                                        <TextBlock Text="清空日志" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding OpenDanbooruManualCollectorCommand}"
                                        Style="{StaticResource CyanCommandButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="DocumentSearch24"
                                                       Margin="0,0,6,0" />
                                        <TextBlock Text="Danbooru 正则手动获取" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <Grid Grid.Row="3"
                                  Grid.Column="1"
                                  Grid.ColumnSpan="2"
                                  Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding DanbooruDownloadSummary}"
                                           Style="{StaticResource CyanTinyTextBlockStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding PixivDownloadSummary}"
                                           Style="{StaticResource CyanTinyTextBlockStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,10,0" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding KemonoDownloadSummary}"
                                           Style="{StaticResource CyanTinyTextBlockStyle}"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <TextBlock Grid.Row="4"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding OutputDirectoryImageTotalSummary}"
                                       Style="{StaticResource CyanTinyTextBlockStyle}"
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,0" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="4"
                              Header="下载日志"
                              Style="{StaticResource CyanGroupBoxStyle}">
                        <TextBox Text="{Binding LogText, Mode=OneWay}"
                                 Style="{StaticResource CyanLogTextBoxStyle}"
                                 MinHeight="260"
                                 HorizontalScrollBarVisibility="Auto" />
                    </GroupBox>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
