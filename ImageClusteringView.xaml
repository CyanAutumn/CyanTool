<UserControl x:Class="CyanTools.ImageClusteringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="文件夹选择" Grid.Row="0" Margin="5">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="输入文件夹:" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding InputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Margin="5,0" VerticalAlignment="Center"/>
                    <Button Content="浏览..." Command="{Binding SelectInputCommand}" Grid.Column="2" Padding="10,2"/>
                </Grid>
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="输出文件夹:" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Margin="5,0" VerticalAlignment="Center"/>
                    <Button Content="浏览..." Command="{Binding SelectOutputCommand}" Grid.Column="2" Padding="10,2"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="参数设置" Grid.Row="1" Margin="5">
            <StackPanel>
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="计算设备:" Grid.Column="0" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding ComputeDevices}"
                              SelectedItem="{Binding SelectedComputeDevice}"
                              Grid.Column="1" Margin="5,0" VerticalAlignment="Center"/>
                    <Button Content="检查/安装CUDA" Command="{Binding CheckCudaCommand}" Grid.Column="2" Padding="10,2"/>
                </Grid>

                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="特征类型:" Grid.Column="0" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding FeatureTypes}" SelectedItem="{Binding SelectedFeatureType}" Grid.Column="1" Margin="5,0" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,5,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsColorDownweightSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="颜色保留:" Grid.Column="0" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1"
                            Minimum="0" Maximum="1"
                            TickFrequency="0.05"
                            IsSnapToTickEnabled="False"
                            Value="{Binding ColorDownweightStyleRetention, Mode=TwoWay}"
                            Margin="5,0"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding ColorDownweightStyleRetentionPercentText}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="聚类算法:" Grid.Column="0" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding Algorithms}" SelectedItem="{Binding SelectedAlgorithm}" Grid.Column="1" Margin="5,0" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="聚类空间:" Grid.Column="0" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding ClusteringSpaces}" SelectedItem="{Binding SelectedClusteringSpace}" Grid.Column="1" Margin="5,0" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="导出过滤:" Grid.Column="0" VerticalAlignment="Center"/>
                    <CheckBox Content="IQR 离群过滤（导出到 uncertain）"
                              IsChecked="{Binding FilterOutliersForExport, Mode=TwoWay}"
                              Grid.Column="1"
                              Margin="5,0"
                              VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="风格增强:" Grid.Column="0" VerticalAlignment="Center"/>
                    <CheckBox Content="二阶段聚类（先灰度 Style 粗分，再彩色 Style 细分）"
                              IsChecked="{Binding EnableTwoStageStyleClustering, Mode=TwoWay}"
                              Grid.Column="1"
                              Margin="5,0"
                              VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="严格不确定:" Grid.Column="0" VerticalAlignment="Center"/>
                    <CheckBox Content="启用最小相似度阈值，不够像就进 uncertain"
                              IsChecked="{Binding UseMinSimilarityForUncertain, Mode=TwoWay}"
                              Grid.Column="1"
                              Margin="5,0"
                              VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,5,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UseMinSimilarityForUncertain}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="最小相似度:" Grid.Column="0" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1"
                            Minimum="0.55" Maximum="0.98"
                            TickFrequency="0.01"
                            IsSnapToTickEnabled="False"
                            Value="{Binding MinCentroidSimilarity, Mode=TwoWay}"
                            Margin="5,0"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding MinCentroidSimilarityPercentText}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="聚类数量 (K):" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding NumClusters, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="5,0" VerticalAlignment="Center" Grid.Column="1">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UseBestKBySilhouette}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsKMeansSelected}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <CheckBox Content="最优"
                              IsChecked="{Binding UseBestKBySilhouette, Mode=TwoWay}"
                              Margin="10,0,0,0"
                              VerticalAlignment="Center"
                              Grid.Column="2">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKMeansSelected}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                </Grid>

                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="最小簇大小 (HDBSCAN):" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding MinClusterSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="5,0" VerticalAlignment="Center" Grid.Column="1">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHdbscanSelected}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>

                <TextBlock Text="UMAP 参数（UMAP空间生效）"
                           Margin="0,8,0,0"
                           Foreground="Gray"/>

                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="n_neighbors（大=分组更粗，小=分组更细）:" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding UmapNNeighbors, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="70" Margin="5,0" VerticalAlignment="Center" Grid.Column="1"/>
                </Grid>

                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="min_dist（小=更抱团，大=更松散）:" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding UmapMinDist, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             Width="70" Margin="5,0" VerticalAlignment="Center" Grid.Column="1"/>
                </Grid>

                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="spread（大=组间更开，小=组间更近）:" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding UmapSpread, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             Width="70" Margin="5,0" VerticalAlignment="Center" Grid.Column="1"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="2" Margin="5">
            <Button Content="初始化参数" Command="{Binding ResetParametersCommand}" Margin="0,0,0,5" Padding="5">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="IsEnabled" Value="True"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsClustering}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="移动子文件夹文件到最上层" Command="{Binding MoveFilesToTopLevelCommand}" Margin="0,0,0,5" Padding="5">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="IsEnabled" Value="True"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsClustering}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="开始聚类" Command="{Binding StartCommand}" Padding="5"/>
        </StackPanel>

        <GroupBox Header="日志和结果" Grid.Row="3" Margin="5">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox Text="{Binding Log}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="100"/>
            </ScrollViewer>
        </GroupBox>

        <ProgressBar Value="{Binding Progress}" Maximum="100" Grid.Row="4" Margin="5" Height="20"/>
    </Grid>
</UserControl>
