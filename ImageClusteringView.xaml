<UserControl x:Class="CyanTools.ImageClusteringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             xmlns:utils="clr-namespace:CyanTools.Utils"
             mc:Ignorable="d"
             d:DesignHeight="620"
             d:DesignWidth="920">
    <UserControl.Resources>
        <utils:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource CyanPageScrollViewerStyle}">
        <Grid Style="{StaticResource CyanPageGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="300"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource CyanCardStyle}"
                    Margin="0,0,0,14"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CyanIconBadgeStyle}"
                            Margin="0,0,14,0">
                        <ui:SymbolIcon Symbol="DataScatter24"
                                       FontSize="22"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="图像聚类"
                                   Style="{StaticResource CyanSectionTitleStyle}" />
                        <TextBlock Text="按特征空间、聚类算法和 UMAP 参数整理图片分组。"
                                   Style="{StaticResource CyanSecondaryTextBlockStyle}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <GroupBox Header="路径"
                      Grid.Row="1"
                      Margin="0,0,0,12"
                      Style="{StaticResource CyanGroupBoxStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="输入路径"
                               Style="{StaticResource CyanFormLabelStyle}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding InputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding HasInheritedInputPath}"
                             Margin="0,0,8,0"/>
                    <Button Grid.Column="2"
                            Content="..."
                            Width="40"
                            Command="{Binding SelectInputCommand}"
                            ToolTip="选择输入路径"
                            Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Grid.ColumnSpan="2"
                               Text="工作流中此输入路径固定为上一个节点的输出路径；如果上一个节点没有输出路径，则沿用其输入路径。"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               Margin="0,6,0,0"
                               Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <CheckBox Grid.Row="2"
                              Grid.Column="1"
                              Grid.ColumnSpan="2"
                              Content="执行完成后清空输入路径文件夹"
                              IsChecked="{Binding ShouldClearInputDirectoryAfterCompletion, Mode=TwoWay}"
                              Margin="0,8,0,0"
                              ToolTip="执行成功后会删除输入路径文件夹中的内容，并自动保留输出路径。"/>

                    <TextBlock Grid.Row="3"
                               Text="输出路径"
                               Style="{StaticResource CyanFormLabelStyle}"
                               Margin="0,12,10,0"
                               Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                    <TextBox Grid.Row="3"
                             Grid.Column="1"
                             Text="{Binding OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,12,8,0"
                             Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                    <Button Grid.Row="3"
                            Grid.Column="2"
                            Content="..."
                            Width="40"
                            Margin="0,12,0,0"
                            Command="{Binding SelectOutputCommand}"
                            ToolTip="选择输出路径"
                            Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>

                    <TextBlock Grid.Row="4"
                               Grid.Column="1"
                               Grid.ColumnSpan="2"
                               Text="工作流模式下输出路径自动生成：父级目录/NN-节点名"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               Margin="0,8,0,0"
                               Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="聚类参数"
                      Grid.Row="2"
                      Margin="0,0,0,12"
                      Style="{StaticResource CyanGroupBoxStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="计算设备"
                               Style="{StaticResource CyanFormLabelStyle}"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding ComputeDevices}"
                              SelectedItem="{Binding SelectedComputeDevice}"
                              Margin="0,0,12,0"/>
                    <TextBlock Grid.Row="1"
                               Text="特征类型"
                               Style="{StaticResource CyanFormLabelStyle}"
                               Margin="0,12,10,0"/>
                    <ComboBox Grid.Row="1"
                              Grid.Column="1"
                              ItemsSource="{Binding FeatureTypes}"
                              SelectedItem="{Binding SelectedFeatureType}"
                              Margin="0,12,12,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource LocalizedTextConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Row="1"
                               Grid.Column="2"
                               Text="聚类算法"
                               Style="{StaticResource CyanFormLabelStyle}"
                               Margin="0,12,10,0"/>
                    <ComboBox Grid.Row="1"
                              Grid.Column="3"
                              ItemsSource="{Binding Algorithms}"
                              SelectedItem="{Binding SelectedAlgorithm}"
                              Margin="0,12,0,0"/>

                    <TextBlock Grid.Row="2"
                               Text="聚类空间"
                               Style="{StaticResource CyanFormLabelStyle}"
                               Margin="0,12,10,0"/>
                    <ComboBox Grid.Row="2"
                              Grid.Column="1"
                              ItemsSource="{Binding ClusteringSpaces}"
                              SelectedItem="{Binding SelectedClusteringSpace}"
                              Margin="0,12,12,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource LocalizedTextConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox Grid.Row="2"
                              Grid.Column="2"
                              Grid.ColumnSpan="2"
                              Content="IQR 离群过滤（导出到 uncertain）"
                              IsChecked="{Binding FilterOutliersForExport, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Margin="0,12,0,0"/>

                    <CheckBox Grid.Row="3"
                              Grid.Column="1"
                              Grid.ColumnSpan="4"
                              Content="二阶段聚类（先灰度 Style 粗分，再彩色 Style 细分）"
                              IsChecked="{Binding EnableTwoStageStyleClustering, Mode=TwoWay}"
                              Margin="0,12,0,0"/>

                    <CheckBox Grid.Row="4"
                              Grid.Column="1"
                              Grid.ColumnSpan="4"
                              Content="启用最小相似度阈值，不够像就进 uncertain"
                              IsChecked="{Binding UseMinSimilarityForUncertain, Mode=TwoWay}"
                              Margin="0,12,0,0"/>

                    <Grid Grid.Row="5"
                          Grid.Column="1"
                          Grid.ColumnSpan="4"
                          Margin="0,12,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UseMinSimilarityForUncertain}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="最小相似度"
                                   Style="{StaticResource CyanFormLabelStyle}"
                                   MinWidth="88"/>
                        <Slider Grid.Column="1"
                                Minimum="0.55"
                                Maximum="0.98"
                                TickFrequency="0.01"
                                IsSnapToTickEnabled="False"
                                Value="{Binding MinCentroidSimilarity, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding MinCentroidSimilarityPercentText}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="6"
                          Grid.ColumnSpan="5"
                          Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="聚类数量 (K)"
                                   Style="{StaticResource CyanFormLabelStyle}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding NumClusters, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UseBestKBySilhouette}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsKMeansSelected}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <CheckBox Grid.Column="2"
                                  Content="最优"
                                  IsChecked="{Binding UseBestKBySilhouette, Mode=TwoWay}"
                                  Margin="14,0,18,0"
                                  VerticalAlignment="Center">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKMeansSelected}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>

                        <TextBlock Grid.Column="3"
                                   Text="最小簇大小"
                                   Style="{StaticResource CyanFormLabelStyle}"
                                   Margin="0,0,10,0"/>
                        <TextBox Grid.Column="4"
                                 Text="{Binding MinClusterSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHdbscanSelected}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <Grid Grid.Row="1"
                              Grid.ColumnSpan="7"
                              Margin="0,12,0,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsColorDownweightSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="颜色保留"
                                       Style="{StaticResource CyanFormLabelStyle}"/>
                            <Slider Grid.Column="1"
                                    Minimum="0"
                                    Maximum="1"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="False"
                                    Value="{Binding ColorDownweightStyleRetention, Mode=TwoWay}"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding ColorDownweightStyleRetentionPercentText}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Grid>
            </GroupBox>

            <GroupBox Header="UMAP 参数"
                      Grid.Row="3"
                      Margin="0,0,0,12"
                      Style="{StaticResource CyanGroupBoxStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="n_neighbors"
                               Style="{StaticResource CyanFormLabelStyle}"
                               ToolTip="大=分组更粗，小=分组更细"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding UmapNNeighbors, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="1"
                               Text="min_dist"
                               Style="{StaticResource CyanFormLabelStyle}"
                               Margin="0,12,10,0"
                               ToolTip="小=更抱团，大=更松散"/>
                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             Margin="0,12,0,0"
                             Text="{Binding UmapMinDist, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>

                    <TextBlock Grid.Row="2"
                               Text="spread"
                               Style="{StaticResource CyanFormLabelStyle}"
                               Margin="0,12,10,0"
                               ToolTip="大=组间更开，小=组间更近"/>
                    <TextBox Grid.Row="2"
                             Grid.Column="1"
                             Margin="0,12,0,0"
                             Text="{Binding UmapSpread, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Grid.Column="2"
                               Grid.RowSpan="3"
                               Text="仅在 UMAP 空间下生效。"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"/>
                </Grid>
            </GroupBox>

            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <GroupBox Header="执行"
                          Grid.Row="0"
                          Margin="0,0,0,12"
                          Style="{StaticResource CyanGroupBoxStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Command="{Binding ResetParametersCommand}"
                                Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CyanCommandButtonStyle}">
                                    <Setter Property="IsEnabled" Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsClustering}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowReset24"
                                               Margin="0,0,6,0"/>
                                <TextBlock Text="初始化参数"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1"
                                Command="{Binding MoveFilesToTopLevelCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CyanCommandButtonStyle}">
                                    <Setter Property="IsEnabled" Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsClustering}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="FolderArrowUp24"
                                               Margin="0,0,6,0"/>
                                <TextBlock Text="移动子文件夹文件到最上层"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3"
                                Command="{Binding StartCommand}"
                                Style="{StaticResource CyanPrimaryActionButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="PlayCircle24"
                                               Margin="0,0,6,0"/>
                                <TextBlock Text="开始聚类"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </GroupBox>

                <GroupBox Header="日志和结果"
                          Grid.Row="1"
                          Margin="0,0,0,12"
                          Style="{StaticResource CyanGroupBoxStyle}">
                    <TextBox Text="{Binding Log}"
                             Style="{StaticResource CyanLogTextBoxStyle}"
                             MinHeight="140"/>
                </GroupBox>

                <ProgressBar Grid.Row="2"
                             Value="{Binding Progress}"
                             Maximum="100"
                             Height="18"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
