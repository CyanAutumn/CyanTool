<UserControl x:Class="CyanTools.TrainingSetBalancerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:utils="clr-namespace:CyanTools.Utils"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel.TrainingSet"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <utils:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="输入路径:" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBox Text="{Binding SelectedFolderPath, UpdateSourceTrigger=LostFocus}"
                             IsReadOnly="{Binding HasInheritedInputPath}"
                             Width="400" Margin="5"/>
                    <Button Content="..." Command="{Binding BrowseFolderCommand}" Margin="5"
                            Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                    <Button Content="一键配平" Command="{Binding BalanceCommand}" Margin="5"/>
                    <Button Content="应用" Command="{Binding ApplyRenamingCommand}" Margin="5"/>
                </StackPanel>
                <TextBlock Text="管道调度中此输入路径固定为上一个节点的输出路径；如果上一个节点没有输出路径，则沿用其输入路径。"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="5,0,5,5"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
            <DataGrid ItemsSource="{Binding FolderItems}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="5">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="子文件夹名" Binding="{Binding FolderName}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="图片数量" Binding="{Binding ImageCount}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="重复次数 (Repet)" Binding="{Binding Repetitions, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="训练步数占比 (%)" Binding="{Binding StepPercentage, StringFormat={}{0:F2}}" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
