<UserControl x:Class="CyanTools.GaussianBlurView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             xmlns:utils="clr-namespace:CyanTools.Utils"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <utils:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <StackPanel Margin="10">
            <TextBlock Text="高斯模糊" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

            <TextBlock Text="输入路径:" Margin="0,10,0,5"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding HasInheritedInputPath}"
                         Grid.Column="0" Margin="0,0,5,0" />
                <Button Content="..."
                        Command="{Binding SelectInputCommand}"
                        Grid.Column="1"
                        Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
            </Grid>
            <TextBlock Text="管道调度中此输入路径固定为上一个节点的输出路径；如果上一个节点没有输出路径，则沿用其输入路径。"
                       Foreground="Gray" Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <CheckBox Content="执行完成后清空输入路径文件夹"
                      IsChecked="{Binding ShouldClearInputDirectoryAfterCompletion}"
                      Margin="0,6,0,0"
                      ToolTip="执行成功后会删除输入路径文件夹中的内容，并自动保留输出目录。"/>

            <StackPanel>
                <TextBlock Text="输出路径:" Margin="0,10,0,5"
                           Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0" Margin="0,0,5,0"
                             Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                    <Button Content="..." Command="{Binding SelectOutputCommand}" Grid.Column="1"
                            Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                </Grid>
                <TextBlock Text="工作流模式下输出路径自动生成：父级目录/NN-节点名"
                           Foreground="Gray" Margin="0,4,0,0"
                           Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>

            <TextBlock Text="模糊半径:" Margin="0,10,0,5"/>
            <Slider Minimum="1" Maximum="100" Value="{Binding BlurRadius}" TickFrequency="1" IsSnapToTickEnabled="True"/>
            <TextBlock Text="{Binding BlurRadius}" HorizontalAlignment="Center"/>

            <Button Content="开始处理" Command="{Binding ProcessCommand}" Margin="0,20,0,0" Padding="10,5"/>

            <TextBlock Text="{Binding StatusText}" Margin="0,10,0,0" Foreground="Gray"/>
        </StackPanel>
    </Grid>
</UserControl>
