<UserControl x:Class="CyanTools.GaussianBlurView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             xmlns:utils="clr-namespace:CyanTools.Utils"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <utils:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Style="{StaticResource CyanPageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Header="路径"
                  Grid.Row="0"
                  Margin="0,0,0,12"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="输入路径"
                           Style="{StaticResource CyanFormLabelStyle}"/>
                <TextBox Grid.Column="1"
                         Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding HasInheritedInputPath}"
                         Margin="0,0,8,0"/>
                <Button Grid.Column="2"
                        Command="{Binding SelectInputCommand}"
                        Width="40"
                        ToolTip="选择输入路径"
                        Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                    <ui:SymbolIcon Symbol="FolderOpen24"/>
                </Button>

                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Text="管道调度中此输入路径固定为上一个节点的输出路径；如果上一个节点没有输出路径，则沿用其输入路径。"
                           Style="{StaticResource CyanSecondaryTextBlockStyle}"
                           Margin="0,6,0,0"
                           Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <CheckBox Grid.Row="2"
                          Grid.Column="1"
                          Grid.ColumnSpan="2"
                          Content="执行完成后清空输入路径文件夹"
                          IsChecked="{Binding ShouldClearInputDirectoryAfterCompletion}"
                          Margin="0,8,0,0"
                          ToolTip="执行成功后会删除输入路径文件夹中的内容，并自动保留输出路径。"/>

                <TextBlock Grid.Row="3"
                           Text="输出路径"
                           Style="{StaticResource CyanFormLabelStyle}"
                           Margin="0,12,10,0"
                           Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                <TextBox Grid.Row="3"
                         Grid.Column="1"
                         Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,12,8,0"
                         Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                <Button Grid.Row="3"
                        Grid.Column="2"
                        Command="{Binding SelectOutputCommand}"
                        Width="40"
                        Margin="0,12,0,0"
                        ToolTip="选择输出路径"
                        Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                    <ui:SymbolIcon Symbol="FolderOpen24"/>
                </Button>

                <TextBlock Grid.Row="4"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Text="工作流模式下输出路径自动生成：父级目录/NN-节点名"
                           Style="{StaticResource CyanSecondaryTextBlockStyle}"
                           Margin="0,8,0,0"
                           Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="模糊参数"
                  Grid.Row="1"
                  Margin="0,0,0,12"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="模糊半径"
                           Style="{StaticResource CyanFormLabelStyle}"/>
                <Slider Grid.Column="1"
                        Minimum="1"
                        Maximum="100"
                        Value="{Binding BlurRadius}"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        VerticalAlignment="Center"/>
                <Border Grid.Column="2"
                        Style="{StaticResource CyanIconBadgeStyle}"
                        Width="64"
                        HorizontalAlignment="Right">
                    <TextBlock Text="{Binding BlurRadius}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </GroupBox>

        <GroupBox Header="执行"
                  Grid.Row="2"
                  Margin="0,0,0,12"
                  Style="{StaticResource CyanGroupBoxStyle}">
            <Button Command="{Binding ProcessCommand}"
                    Style="{StaticResource CyanPrimaryActionButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="PlayCircle24"
                                   Margin="0,0,6,0"/>
                    <TextBlock Text="开始处理"/>
                </StackPanel>
            </Button>
        </GroupBox>

        <Border Grid.Row="3"
                Style="{StaticResource CyanCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CyanIconBadgeStyle}"
                        Margin="0,0,14,0">
                    <ui:SymbolIcon Symbol="ImageEdit24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                </Border>
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusText}"
                           Style="{StaticResource CyanSecondaryTextBlockStyle}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
