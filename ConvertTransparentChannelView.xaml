<UserControl x:Class="CyanTools.ConvertTransparentChannelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             xmlns:utils="clr-namespace:CyanTools.Utils"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <utils:BooleanToInverseBooleanConverter x:Key="BooleanToInverseBooleanConverter" />
        <utils:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <GroupBox Header="路径选择" Grid.Row="0" Margin="0,5">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="输入路径:" VerticalAlignment="Center" Margin="5"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding InputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding HasInheritedInputPath}"
                             Margin="5" />
                    <Button Grid.Column="2"
                            Content="..."
                            Command="{Binding SelectInputCommand}"
                            Margin="5"
                            Padding="10,2"
                            Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                </Grid>
                <TextBlock Text="管道调度中此输入路径固定为上一个节点的输出路径；如果上一个节点没有输出路径，则沿用其输入路径。"
                           Foreground="Gray" Margin="5,2,5,0"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <CheckBox Content="执行完成后清空输入路径文件夹"
                          IsChecked="{Binding ShouldClearInputDirectoryAfterCompletion, Mode=TwoWay}"
                          Margin="5,6,5,0"
                          ToolTip="执行成功后会删除输入路径文件夹中的内容，并自动保留输出目录。"/>
                <StackPanel>
                    <TextBlock Text="输出路径:" Margin="5"
                               Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="5"
                                 Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                        <Button Grid.Column="1" Content="..." Command="{Binding SelectOutputCommand}" Margin="5" Padding="10,2"
                                Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                    </Grid>
                    <TextBlock Text="工作流模式下输出路径自动生成：父级目录/NN-节点名"
                               Foreground="Gray" Margin="5,2,5,5"
                               Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <TextBlock Grid.Row="1"
                   Text="将透明像素填充为白色，支持 PNG/WEBP/BMP/JPEG。"
                   Foreground="Gray"
                   Margin="5,0,0,5"
                   TextWrapping="Wrap"/>

        <Button Grid.Row="2"
                Content="开始转换"
                Command="{Binding StartConversionCommand}"
                IsEnabled="{Binding IsProcessing, Converter={StaticResource BooleanToInverseBooleanConverter}}"
                Margin="0,10,0,5"
                Padding="10,5"
                HorizontalAlignment="Center"/>

        <GroupBox Header="转换进度" Grid.Row="3" Margin="0,5">
            <ProgressBar Value="{Binding ProgressValue}" Minimum="0" Maximum="100" Height="20" Margin="5"/>
        </GroupBox>

        <GroupBox Header="日志" Grid.Row="4" Margin="0,5">
            <ListBox ItemsSource="{Binding Logs}" Margin="5"/>
        </GroupBox>
    </Grid>
</UserControl>
