<UserControl x:Class="CyanTools.ImageScalingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             xmlns:utils="clr-namespace:CyanTools.Utils"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <utils:BooleanToInverseBooleanConverter x:Key="BooleanToInverseBooleanConverter"/>
    </UserControl.Resources>
    <UserControl.DataContext>
        <viewModel:ImageScalingViewModel/>
    </UserControl.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Header="路径选择" Grid.Row="0" Margin="0,5">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="输入路径:" VerticalAlignment="Center" Margin="5"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding InputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="5"/>
                    <Button Grid.Column="2"
                            Content="选择..."
                            Command="{Binding SelectInputCommand}"
                            Margin="5"
                            Padding="10,2"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="输出路径:" VerticalAlignment="Center" Margin="5"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="5"/>
                    <Button Grid.Column="2"
                            Content="选择..."
                            Command="{Binding SelectOutputCommand}"
                            Margin="5"
                            Padding="10,2"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="缩放选项" Grid.Row="1" Margin="0,5">
            <StackPanel Margin="5">
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              Content="上采样至目标分辨率(乘积)"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsUpsampleEnabled, Mode=TwoWay}"/>
                    <TextBlock Grid.Column="1" Text="宽:" VerticalAlignment="Center" Margin="20,0,4,0"/>
                    <TextBox Grid.Column="2"
                             Text="{Binding UpsampleTargetWidth, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding IsUpsampleEnabled}"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="高:" VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <TextBox Grid.Column="4"
                             Text="{Binding UpsampleTargetHeight, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding IsUpsampleEnabled}"
                             VerticalContentAlignment="Center"/>
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              Content="下采样至目标分辨率(乘积)"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsDownsampleEnabled, Mode=TwoWay}"/>
                    <TextBlock Grid.Column="1" Text="宽:" VerticalAlignment="Center" Margin="20,0,4,0"/>
                    <TextBox Grid.Column="2"
                             Text="{Binding DownsampleTargetWidth, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding IsDownsampleEnabled}"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="高:" VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <TextBox Grid.Column="4"
                             Text="{Binding DownsampleTargetHeight, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding IsDownsampleEnabled}"
                             VerticalContentAlignment="Center"/>
                </Grid>

                <TextBlock Text="宽和高会自动修正为最接近的 64 倍数。勾选两个选项时执行顺序: 先上采样，再下采样。"
                           Margin="0,6,0,0"
                           Foreground="Gray"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>

        <Button Grid.Row="2"
                Content="开始处理"
                Command="{Binding StartProcessingCommand}"
                Margin="0,10,0,5"
                Padding="10,5"
                HorizontalAlignment="Center"
                IsEnabled="{Binding IsProcessing, Converter={StaticResource BooleanToInverseBooleanConverter}}"/>

        <GroupBox Header="处理进度" Grid.Row="3" Margin="0,5">
            <ProgressBar Value="{Binding ProgressValue}" Minimum="0" Maximum="100" Height="20" Margin="5"/>
        </GroupBox>

        <GroupBox Header="处理日志" Grid.Row="4" Margin="0,5">
            <DockPanel>
                <Button Content="清空日志"
                        Command="{Binding ClearLogCommand}"
                        IsEnabled="{Binding IsProcessing, Converter={StaticResource BooleanToInverseBooleanConverter}}"
                        DockPanel.Dock="Top"
                        HorizontalAlignment="Right"
                        Margin="0,0,0,5"
                        Padding="10,2"/>
                <ListBox ItemsSource="{Binding Logs}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </GroupBox>
    </Grid>
</UserControl>
