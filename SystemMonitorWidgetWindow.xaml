<Window x:Class="CyanTools.SystemMonitorWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="系统监控"
        Width="340"
        Height="64"
        MinWidth="340"
        MinHeight="64"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        SnapsToDevicePixels="True">
    <Border Margin="2"
            Padding="5,1"
            CornerRadius="2"
            Background="{DynamicResource CyanSurfaceElevatedBrush}"
            BorderBrush="#FFF15A3A"
            BorderThickness="1"
            Effect="{StaticResource CyanSoftShadowEffect}">
        <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown"
              Cursor="SizeAll">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="172"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="18"/>
                </Grid.RowDefinitions>

                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="25"/>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="CPU" FontSize="8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding CpuText}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Border Grid.Column="2" Height="12" Background="{DynamicResource ControlStrokeColorDefaultBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="LOSS" FontSize="8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="{Binding TrainingLossText}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>

                <Grid Grid.Row="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="25"/>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="GPU" FontSize="8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding GpuLoadText}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Border Grid.Column="2" Height="12" Background="{DynamicResource ControlStrokeColorDefaultBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="EP" FontSize="8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="{Binding TrainingEpochText}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>

                <Grid Grid.Row="2" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="时间" FontSize="8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding TrainingDurationText}"
                               FontFamily="Consolas"
                               FontSize="8"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="用时/总时间，格式为 天d时:分:秒"/>
                </Grid>
            </Grid>

            <Border Grid.Column="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="2,0"/>

            <Border Grid.Column="2"
                    Margin="5,0,0,0"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="1">
                <Canvas Width="142" Height="52" ClipToBounds="True">
                    <Line X1="0" Y1="10" X2="142" Y2="10" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="0.5"/>
                    <Line X1="0" Y1="22" X2="142" Y2="22" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="0.5"/>
                    <Line X1="0" Y1="34" X2="142" Y2="34" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="0.5"/>
                    <Line X1="0" Y1="46" X2="142" Y2="46" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="0.5"/>
                    <Polyline Points="{Binding LossCurvePoints}"
                              Stroke="#FFF15A3A"
                              StrokeThickness="1.5"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                    <TextBlock Width="142"
                               Text="{Binding LossCurveStateText, Converter={StaticResource LocalizedTextConverter}}"
                               Canvas.Top="21"
                               FontSize="8"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextAlignment="Center"/>
                    <Button Canvas.Right="2"
                            Canvas.Top="2"
                            Width="14"
                            Height="14"
                            Padding="0"
                            Content="×"
                            FontSize="10"
                            ToolTip="关闭系统监控小窗"
                            Cursor="Arrow"
                            Click="CloseButton_Click"/>
                </Canvas>
            </Border>
        </Grid>
    </Border>
</Window>
