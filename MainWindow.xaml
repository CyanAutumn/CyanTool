<ui:FluentWindow x:Class="CyanTools.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title="Cyan Tools"
                 Width="1100"
                 Height="720"
                 MinWidth="900"
                 MinHeight="620"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="False"
                 WindowBackdropType="None"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Height="56"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            MouseLeftButtonDown="TitleDragArea_MouseLeftButtonDown">
                    <ui:SymbolIcon Symbol="Toolbox24"
                                   FontSize="20"
                                   Margin="0,0,10,0" />
                    <TextBlock Text="Cyan Tools"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="ThemeStatusText"
                               Text="白天"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:ToggleSwitch x:Name="ThemeToggleSwitch"
                                     ToolTip="切换白天/夜间模式"
                                     Checked="ThemeToggleSwitch_Checked"
                                     Unchecked="ThemeToggleSwitch_Unchecked" />
                    <Button Content="－"
                            Width="42"
                            Height="32"
                            Margin="12,0,0,0"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent"
                            ToolTip="最小化"
                            Click="AppTitleBar_MinimizeClicked" />
                    <Button Content="□"
                            Width="42"
                            Height="32"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent"
                            ToolTip="最大化/还原"
                            Click="AppTitleBar_MaximizeClicked" />
                    <Button Content="×"
                            Width="42"
                            Height="32"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent"
                            ToolTip="关闭"
                            Click="AppTitleBar_CloseClicked" />
                </StackPanel>
            </Grid>
        </Border>

        <ui:NavigationView x:Name="RootNavigationView"
                           Grid.Row="1"
                           PaneTitle="Cyan Tools"
                           PaneDisplayMode="Left"
                           IsPaneOpen="True"
                           OpenPaneLength="258"
                           CompactPaneLength="56"
                           FrameMargin="16,8,16,16"
                           HeaderVisibility="Visible"
                           SelectionChanged="RootNavigationView_SelectionChanged" />
    </Grid>
</ui:FluentWindow>
