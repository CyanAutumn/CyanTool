<ui:FluentWindow x:Class="CyanTools.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title="Cyan Tools"
                 Width="1100"
                 Height="720"
                 MinWidth="900"
                 MinHeight="620"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="False"
                 WindowBackdropType="None"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Height="64"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            MouseLeftButtonDown="TitleDragArea_MouseLeftButtonDown">
                    <Border Style="{StaticResource CyanIconBadgeStyle}"
                            Margin="0,0,12,0">
                        <ui:SymbolIcon Symbol="Toolbox24"
                                       FontSize="20"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Cyan Tools"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="AI 图像与数据集工作台"
                                   Style="{StaticResource CyanTinyTextBlockStyle}" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="Transparent"
                        MouseLeftButtonDown="TitleDragArea_MouseLeftButtonDown" />

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="20,0,12,0">
                    <ui:SymbolIcon x:Name="ThemeIcon"
                                   Symbol="WeatherSunny24"
                                   FontSize="18"
                                   Margin="0,0,8,0"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="ThemeStatusText"
                               Text="白天"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:ToggleSwitch x:Name="ThemeToggleSwitch"
                                     ToolTip="切换白天/夜间模式"
                                     Checked="ThemeToggleSwitch_Checked"
                                     Unchecked="ThemeToggleSwitch_Unchecked" />
                </StackPanel>

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource CyanTitleBarButtonStyle}"
                            ToolTip="最小化"
                            Click="AppTitleBar_MinimizeClicked">
                        <ui:SymbolIcon Symbol="LineHorizontal124"
                                       FontSize="18" />
                    </Button>
                    <Button Style="{StaticResource CyanTitleBarButtonStyle}"
                            ToolTip="最大化/还原"
                            Click="AppTitleBar_MaximizeClicked">
                        <ui:SymbolIcon Symbol="FullScreenMaximize24"
                                       FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource CyanTitleBarButtonStyle}"
                            ToolTip="关闭"
                            Click="AppTitleBar_CloseClicked">
                        <ui:SymbolIcon Symbol="Dismiss24"
                                       FontSize="18" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ui:NavigationView x:Name="RootNavigationView"
                           Grid.Row="1"
                           PaneTitle="Cyan Tools"
                           PaneDisplayMode="Left"
                           IsPaneOpen="True"
                           OpenPaneLength="258"
                           CompactPaneLength="56"
                           FrameMargin="18,10,18,18"
                           HeaderVisibility="Visible"
                           SelectionChanged="RootNavigationView_SelectionChanged" />
    </Grid>
</ui:FluentWindow>
