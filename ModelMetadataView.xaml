<UserControl x:Class="CyanTools.ModelMetadataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             mc:Ignorable="d"
             d:DesignHeight="620"
             d:DesignWidth="980">
    <UserControl.DataContext>
        <viewModel:ModelMetadataViewModel />
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  AllowDrop="True"
                  DragEnter="UserControl_DragEnter"
                  Drop="UserControl_Drop">
        <Grid Style="{StaticResource CyanPageGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0"
                      Header="模型文件"
                      Style="{StaticResource CyanGroupBoxStyle}"
                      Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="输入模型"
                               Style="{StaticResource CyanFormLabelStyle}" />
                    <TextBox Grid.Column="1"
                             Text="{Binding InputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,8,0"
                             ToolTip="支持拖入 .safetensors 文件" />
                    <Button Grid.Column="2"
                            Command="{Binding BrowseInputCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanToInverseBooleanConverter}}"
                            Style="{StaticResource CyanSmallIconButtonStyle}"
                            ToolTip="选择模型">
                        <ui:SymbolIcon Symbol="FolderOpen24" />
                    </Button>
                    <Button Grid.Column="3"
                            Command="{Binding LoadCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanToInverseBooleanConverter}}"
                            Style="{StaticResource CyanCommandButtonStyle}"
                            Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowClockwise24"
                                           Margin="0,0,6,0" />
                            <TextBlock Text="读取" />
                        </StackPanel>
                    </Button>

                    <TextBlock Grid.Row="1"
                               Text="输出模型"
                               Style="{StaticResource CyanFormLabelStyle}"
                               Margin="0,12,10,0" />
                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             Text="{Binding OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,12,8,0"
                             ToolTip="默认写入同目录的 _metadata 副本；可改为原文件以覆盖" />
                    <Button Grid.Row="1"
                            Grid.Column="2"
                            Command="{Binding BrowseOutputCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanToInverseBooleanConverter}}"
                            Style="{StaticResource CyanSmallIconButtonStyle}"
                            Margin="0,12,0,0"
                            ToolTip="选择输出文件">
                        <ui:SymbolIcon Symbol="Save24" />
                    </Button>
                </Grid>
            </GroupBox>

            <Border Grid.Row="1"
                    Style="{StaticResource CyanToolbarSurfaceStyle}"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileInfoText}"
                                   Style="{StaticResource CyanSecondaryTextBlockStyle}" />
                        <TextBlock Text="{Binding StatusText}"
                                   Style="{StaticResource CyanTinyTextBlockStyle}"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Command="{Binding PurgeMetadataCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanToInverseBooleanConverter}}"
                            Style="{StaticResource CyanCommandButtonStyle}"
                            Margin="12,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Delete24"
                                           Margin="0,0,6,0" />
                            <TextBlock Text="清除并另存为" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2"
                            Command="{Binding SaveMetadataCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanToInverseBooleanConverter}}"
                            Style="{StaticResource CyanPrimaryActionButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Save24"
                                           Margin="0,0,6,0" />
                            <TextBlock Text="保存元数据" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.85*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.35*" />
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0"
                          Header="常用字段摘要"
                          Style="{StaticResource CyanGroupBoxStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SummaryItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Key}"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding Value}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </GroupBox>

                <GridSplitter Grid.Column="1"
                              Style="{StaticResource CyanGridSplitterStyle}" />

                <GroupBox Grid.Column="2"
                          Header="源数据 JSON"
                          Style="{StaticResource CyanGroupBoxStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox Grid.Row="0"
                                 Text="{Binding MetadataJson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Padding="12"
                                 BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                 Background="{DynamicResource ControlFillColorDefaultBrush}"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <TextBlock Grid.Row="1"
                                   Text="Safetensors 元数据只能包含字符串键值对。保存时仅重建文件头，模型张量数据会原样流式复制。"
                                   Style="{StaticResource CyanTinyTextBlockStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0" />
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
