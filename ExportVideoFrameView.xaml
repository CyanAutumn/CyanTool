<UserControl x:Class="CyanTools.ExportVideoFrameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             mc:Ignorable="d"
             d:DesignHeight="620"
             d:DesignWidth="960"
             Unloaded="UserControl_Unloaded">
    <Grid Style="{StaticResource CyanPageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CyanCardStyle}"
                Margin="0,0,0,14"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CyanIconBadgeStyle}"
                        Margin="0,0,14,0">
                    <ui:SymbolIcon Symbol="ImageArrowForward24"
                                   FontSize="22"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="视频抽帧"
                               Style="{StaticResource CyanSectionTitleStyle}" />
                    <TextBlock Text="预览视频帧并导出当前帧、全部帧或 GIF。"
                               Style="{StaticResource CyanSecondaryTextBlockStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <GroupBox Grid.Row="1"
                  Header="视频与输出"
                  Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="视频路径:"
                           Style="{StaticResource CyanFormLabelStyle}" />
                <TextBox Grid.Column="1"
                         IsReadOnly="True"
                         Text="{Binding VideoPath}"
                         Margin="0,0,8,0" />
                <Button Grid.Column="2"
                        Command="{Binding SelectVideoCommand}"
                        Style="{StaticResource CyanCommandButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ImageMultiple24"
                                       Margin="0,0,6,0" />
                        <TextBlock Text="选择视频" />
                    </StackPanel>
                </Button>

                <TextBlock Grid.Row="1"
                           Text="输出路径"
                           Style="{StaticResource CyanFormLabelStyle}"
                           Margin="0,12,10,0" />
                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         IsReadOnly="True"
                         Text="{Binding OutputFolder}"
                         Margin="0,12,8,0" />
                <Button Grid.Row="1"
                        Grid.Column="2"
                        Command="{Binding SelectOutputCommand}"
                        Style="{StaticResource CyanCommandButtonStyle}"
                        Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="FolderOpen24"
                                       Margin="0,0,6,0" />
                        <TextBlock Text="选择目录" />
                    </StackPanel>
                </Button>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2"
                  Header="帧预览"
                  Margin="0,0,0,14">
            <Border Style="{StaticResource CyanImageWellStyle}">
                <Image Stretch="Uniform"
                       Source="{Binding CurrentFrame}" />
            </Border>
        </GroupBox>

        <GroupBox Grid.Row="3"
                  Header="时间轴"
                  Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="帧间隔"
                           Style="{StaticResource CyanFormLabelStyle}" />
                <TextBox Grid.Column="1"
                         TextAlignment="Center"
                         Text="{Binding FrameIntervalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PreviewTextInput="FrameIntervalTextBox_PreviewTextInput" />
                <Button Grid.Column="2"
                        Content="上一帧"
                        Command="{Binding PreviousFrameCommand}"
                        Style="{StaticResource CyanCommandButtonStyle}"
                        Margin="14,0,8,0" />
                <Button Grid.Column="3"
                        Content="下一帧"
                        Command="{Binding NextFrameCommand}"
                        Style="{StaticResource CyanCommandButtonStyle}" />

                <Slider Grid.Row="1"
                        Grid.ColumnSpan="5"
                        Margin="0,14,0,0"
                        Minimum="0"
                        Maximum="{Binding MaxFrameIndex}"
                        Value="{Binding CurrentFrameIndex, Mode=TwoWay}"
                        IsEnabled="{Binding IsVideoLoaded}" />
            </Grid>
        </GroupBox>

        <Border Grid.Row="4"
                Style="{StaticResource CyanToolbarSurfaceStyle}">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding ExportCurrentFrameCommand}"
                        Style="{StaticResource CyanPrimaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ImageArrowForward24"
                                       Margin="0,0,6,0" />
                        <TextBlock Text="输出当前帧" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExportAllFramesCommand}"
                        Style="{StaticResource CyanCommandButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ImageMultiple24"
                                       Margin="0,0,6,0" />
                        <TextBlock Text="输出所有帧" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExportGifCommand}"
                        Style="{StaticResource CyanCommandButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Save24"
                                       Margin="0,0,6,0" />
                        <TextBlock Text="导出为 GIF" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
