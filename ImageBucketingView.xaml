<UserControl x:Class="CyanTools.ImageBucketingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewModel="clr-namespace:CyanTools.ViewModel"
             xmlns:utils="clr-namespace:CyanTools.Utils"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800">
    <UserControl.Resources>
        <utils:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <TextBlock Grid.Row="0" Text="图片分辨率归类工具" FontSize="24" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>


            <GroupBox Grid.Row="1" Header="路径设置" Margin="0,0,0,15">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Row="0" Grid.Column="0" Text="输入路径:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Height="25" Margin="0,0,10,0"
                             Text="{Binding InputFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding HasInheritedInputPath}"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="..." Width="80" Height="25"
                            Command="{Binding BrowseInputFolderCommand}"
                            Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                               Text="管道调度中此输入路径固定为上一个节点的输出路径；如果上一个节点没有输出路径，则沿用其输入路径。"
                               Foreground="Gray" Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasInheritedInputPath, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                              Content="执行完成后清空输入路径文件夹"
                              IsChecked="{Binding ShouldClearInputDirectoryAfterCompletion}"
                              Margin="0,6,0,0"
                              ToolTip="执行成功后会删除输入路径文件夹中的内容，并自动保留输出目录。"/>


                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="输出路径:" VerticalAlignment="Center" Margin="0,0,10,0"
                                       Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                            <TextBox Grid.Column="1" Height="25" Margin="0,0,10,0"
                                     Text="{Binding OutputFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                            <Button Grid.Column="2" Content="..." Width="80" Height="25"
                                    Command="{Binding BrowseOutputFolderCommand}"
                                    Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                        </Grid>
                        <TextBlock Text="工作流模式下输出路径自动生成：父级目录/NN-节点名"
                                   Foreground="Gray" Margin="0,4,0,0"
                                   Visibility="{Binding IsWorkflowMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>
            </GroupBox>


            <GroupBox Grid.Row="2" Header="参数设置" Margin="0,0,0,15">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Row="0" Grid.Column="0" Text="分辨率步长:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DivisibleText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Height="25" VerticalContentAlignment="Center"/>


                    <TextBlock Grid.Row="0" Grid.Column="2" Text="最大宽高比误差:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding MaxArErrorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Height="25" VerticalContentAlignment="Center"/>


                    <TextBlock Grid.Row="1" Grid.Column="0" Text="最大尺寸限制:" VerticalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DimLimitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Height="25" Margin="0,10,0,0" VerticalContentAlignment="Center"/>


                    <CheckBox Grid.Row="1" Grid.Column="2" Content="启用调试输出" VerticalAlignment="Center" Margin="0,10,0,0"
                              IsChecked="{Binding IsDebugEnabled}"/>


                    <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Margin="0,15,0,0" TextWrapping="Wrap" Foreground="Gray">
                        <Run Text="说明: 该工具会根据图片的宽高比将图片分类到不同的分辨率文件夹中。"/>
                        <LineBreak/>
                        <Run Text="• 分辨率步长: 生成分辨率序列的步长，通常为64"/>
                        <LineBreak/>
                        <Run Text="• 最大宽高比误差: 允许的最大宽高比偏差，超过此值的图片会被跳过"/>
                        <LineBreak/>
                        <Run Text="• 最大尺寸限制: 生成的分辨率不会超过此值"/>
                    </TextBlock>
                </Grid>
            </GroupBox>


            <Grid Grid.Row="3" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ProgressBar Grid.Column="0" Height="30" Margin="0,0,10,0"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             Minimum="0"
                             Maximum="100"
                             IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"/>
                <Button Grid.Column="1" Content="开始分类" Width="100" Height="30"
                        FontWeight="Bold"
                        Command="{Binding StartClassificationCommand}"/>
            </Grid>


            <GroupBox Grid.Row="4" Header="操作日志">
                <TextBox Margin="5" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" 
                         IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                         Text="{Binding LogText, Mode=OneWay}"/>
            </GroupBox>
        </Grid>
    </ScrollViewer>
</UserControl>
